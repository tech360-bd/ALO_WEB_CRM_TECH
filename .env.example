NODE_ENV=production
APP_ENV=production
APP_DEBUG=false

HOSTNAME=0.0.0.0
# Docker Compose database credentials (must match DATABASE_URL)
MYSQL_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_ROOT_PASSWORD
MYSQL_DATABASE=aloeduca_alo_education
MYSQL_USER=aloeduca_ALO_final_web_crm
MYSQL_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
# Production port is 3044 per spec (Caddy reverse_proxy 127.0.0.1:3044).
# Docker compose maps app:3044:3044; dev may override to 3000 locally but prod MUST be 3044.
PORT=3044

APP_URL=https://aloeducation.com
NEXT_PUBLIC_APP_URL=https://aloeducation.com
NEXTAUTH_URL=https://aloeducation.com
PUBLIC_WEBSITE_URL=https://aloeducation.com

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=aloeduca_alo_education
DB_USERNAME=aloeduca_ALO_final_web_crm
DB_PASSWORD=REPLACE_WITH_REAL_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

DATABASE_URL="mysql://aloeduca_ALO_final_web_crm:REPLACE_WITH_URL_ENCODED_PASSWORD@localhost:3306/aloeduca_alo_education"

NEXTAUTH_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
AUTH_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
ENCRYPTION_KEY=REPLACE_WITH_REQUIRED_32_BYTE_HEX_KEY

SEED_SUPER_ADMIN_EMAIL=admin@aloeducation.com
SEED_SUPER_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_ONE_TIME_ADMIN_PASSWORD
ENABLE_DEVELOPMENT_SAMPLE_DATA=false
DEVELOPMENT_SAMPLE_PASSWORD=
NEXT_PUBLIC_DEVELOPMENT_DEMO_PASSWORD=

TZ=Asia/Dhaka

MAIL_FROM_ADDRESS=noreply@aloeducation.com
MAIL_FROM_NAME="ALO Education"

MAIL_HOST=mail.aloeducation.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USERNAME=noreply@aloeducation.com
MAIL_PASSWORD=REPLACE_WITH_EMAIL_PASSWORD

IMAP_HOST=mail.aloeducation.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USERNAME=noreply@aloeducation.com
IMAP_PASSWORD=REPLACE_WITH_EMAIL_PASSWORD

POP3_HOST=mail.aloeducation.com
POP3_PORT=995
POP3_SECURE=true
POP3_USERNAME=noreply@aloeducation.com
POP3_PASSWORD=REPLACE_WITH_EMAIL_PASSWORD

# AI Layer Credentials & Configuration
GROQ_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=
AI_DEFAULT_MODEL=glm-4-flash
AI_FAST_MODEL=glm-4-flash
AI_SMART_MODEL=glm-4-plus
AI_AGENT_MODEL=glm-4-flash

# Firebase Admin authentication (server-only; never commit real values)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nREPLACE_WITH_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n"

# Storage & Integrations — private storage, never public/uploads
STORAGE_POOL_C=/home/aloeduca/alo-education/storage/uploads
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_API_KEY=
WHATSAPP_API_KEY=


# --- GitHub → VPS deployment (used in .github/workflows) ---
# These are GitHub Actions Secrets, NOT committed values. Names must match workflow:
# DEPLOY_HOST, DEPLOY_USER, DEPLOY_SSH_KEY, DEPLOY_PORT
# See docs/VPS-GITHUB-DEPLOYMENT.md for setup.

# --- WhatsApp Business Platform (Meta Cloud API) ---
# Required for official WhatsApp sends/receives. NEVER commit real tokens.
# See docs/WHATSAPP-META-SETUP.md and docs/EMPLOYEE-WHATSAPP-ASSIGNMENT.md
WHATSAPP_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_PHONE=
# Optional: Graph API version override
WHATSAPP_GRAPH_VERSION=v18.0

# --- 3CX / Telephony / SMS / Email provider tokens (optional) ---
THREECX_API_URL=
THREECX_API_TOKEN=
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=

# --- Social OAuth — official OAuth only (Admin Official Accounts + Employee My Accounts) ---
# Facebook + Instagram (Meta Business)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# LinkedIn Pages
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# YouTube / Google (same Google OAuth — used for YouTube channel + Search Console + Business Profile)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# TikTok for Business
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# X (Twitter) OAuth 2.0
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BEARER_TOKEN=
# Telegram Bot (BotFather token, not OAuth)
TELEGRAM_BOT_TOKEN=
# Pinterest
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Google Business Profile (uses GOOGLE_CLIENT_ID/SECRET + Business Profile API)
GOOGLE_BUSINESS_ACCOUNT_ID=

# --- Google SEO & Analytics (GA4 + Search Console) ---
# GA4 — consent-aware analytics (see docs/GOOGLE_SEO_SETUP.md)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# Search Console — OAuth uses GOOGLE_CLIENT_ID/SECRET + verified domain in Search Console
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://aloeducation.com
GOOGLE_SEARCH_CONSOLE_CREDENTIALS_JSON=
# Consent + indexing
NEXT_PUBLIC_GA4_ENABLED=false
NEXT_PUBLIC_CONSENT_MODE=true

# --- Health / deployment verification ---
HEALTH_PORT=3044
PM2_NAME=alo-education
DEPLOY_DIR=/root/alo-live

# --- ALO Official WhatsApp Number Pool (spec §2) ---
ALO_MAIN_WHATSAPP_NUMBER=01805020100
ALO_COMPLAINT_WHATSAPP_NUMBER=01805020100
ALO_FOLLOWUP_WHATSAPP_NUMBER=01805020100
ALO_COO_WHATSAPP_NUMBER=01805020101
ALO_24_7_SUPPORT_NUMBER=01805020101
ALO_EMPLOYEE_WHATSAPP_START=01805020102
ALO_EMPLOYEE_WHATSAPP_END=01805020119
# --- Web Search → Scrape → Extract → AI → CRM (Molx + Firecrawl + Enrichment) ---
# Molx self-hosted MIT (primary, free) — Docker hostname: http://molx:3001 | non-Docker: http://localhost:3001 or actual VPS IP
MOLX_URL=
MOLX_API_KEY=
# Firecrawl cloud fallback (when MOLX_URL empty or 5xx)
FIRECRAWL_URL=https://api.firecrawl.dev
FIRECRAWL_API_KEY=
# Waterfall providers (Bricks/TinyFish) — optional
TINYFISH_API_KEY=
# Lead sourcing (Apify) — optional; if empty, pipeline falls back to webSearch
APIFY_TOKEN=
APIFY_ACTOR=compass/crawler-google-places
# Enrichment (Bright Data Open Enrich / Apollo / SalesQL) — optional
BRIGHTDATA_API_KEY=
APOLLO_API_KEY=
SALESQL_API_KEY=
# Cron/scheduler secret for /api/automation/schedule (add to VPS .env, never commit, verified server-side, never expose to frontend)
ALO_CRON_SECRET=
ALO_APP_URL=https://aloeducation.com
REDIS_URL=redis://127.0.0.1:6379
# File signing secret for private document URLs — must be >=32 chars random (SEC-02) — never commit real value
FILE_SIGN_SECRET=REPLACE_WITH_LONG_RANDOM_32_PLUS_CHARS

OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_SITE_URL=https://crm.aloeducation.com
OPENROUTER_APP_NAME="ALO Education WhatsApp AI"
