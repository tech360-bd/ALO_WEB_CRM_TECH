NODE_ENV=production
APP_ENV=production
APP_DEBUG=false

# Hostinger supplies PORT and, if required, HOSTNAME. Do not impose values here.
# Confirm provider Node.js 22.x only and npm >=10; runtime values are NOT VERIFIED.
APP_URL=https://aloeducation.com
NEXT_PUBLIC_APP_URL=https://aloeducation.com
NEXTAUTH_URL=https://aloeducation.com
PUBLIC_WEBSITE_URL=https://aloeducation.com

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=REPLACE_WITH_REAL_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

DATABASE_URL="mysql://REPLACE_USER:REPLACE_URL_ENCODED_PASSWORD@REPLACE_DB_HOST:3306/REPLACE_DATABASE"

NEXTAUTH_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
AUTH_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
ENCRYPTION_KEY=REPLACE_WITH_REQUIRED_32_BYTE_HEX_KEY

SEED_SUPER_ADMIN_EMAIL=admin@aloeducation.com
SEED_SUPER_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_ONE_TIME_ADMIN_PASSWORD
ENABLE_DEVELOPMENT_SAMPLE_DATA=false
DEVELOPMENT_SAMPLE_PASSWORD=

TZ=Asia/Dhaka

# MAIL_* / IMAP_* / POP3_* below are NOT read by application code (see
# docs/environment-classification.json). The live email transport is the SMTP_*
# block near the bottom of this file (src/lib/email-service.ts).
MAIL_FROM_ADDRESS=noreply@aloeducation.com
MAIL_FROM_NAME="ALO Education"

MAIL_HOST=mail.aloeducation.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USERNAME=noreply@aloeducation.com
MAIL_PASSWORD=REPLACE_WITH_EMAIL_PASSWORD

IMAP_HOST=mail.aloeducation.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USERNAME=noreply@aloeducation.com
IMAP_PASSWORD=REPLACE_WITH_EMAIL_PASSWORD

POP3_HOST=mail.aloeducation.com
POP3_PORT=995
POP3_SECURE=true
POP3_USERNAME=noreply@aloeducation.com
POP3_PASSWORD=REPLACE_WITH_EMAIL_PASSWORD

# AI Layer Credentials & Configuration
GROQ_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=
AI_DEFAULT_MODEL=glm-4-flash
AI_FAST_MODEL=glm-4-flash
AI_SMART_MODEL=glm-4-plus
AI_AGENT_MODEL=glm-4-flash

# Free-tier AI providers — optional, catalogued in src/lib/ai-providers/catalog.ts
#
# Set ONLY the ones you actually have a key for. An empty value means "not
# connected" and the provider is simply skipped; nothing falls back to a paid API.
# These are read dynamically by src/lib/ai-providers/resolve.ts, which is why they
# appear here rather than being detected as code references.
#
# PAID_AI_API_ALLOWED=false — every provider below has a free tier. Providers with
# no free tier are deliberately absent; see EXCLUDED_PROVIDERS in the catalog.
GEMINI_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=
HUGGINGFACE_API_KEY=
SAMBANOVA_API_KEY=
TOGETHER_API_KEY=
DEEPINFRA_API_KEY=
SILICONFLOW_API_KEY=
SCALEWAY_API_KEY=
MODELSCOPE_API_KEY=
MORPH_API_KEY=
FEATHERLESS_API_KEY=
FRIENDLIAI_API_KEY=
ARCEE_API_KEY=
UPSTAGE_API_KEY=
QWEN_API_KEY=
POLLINATIONS_API_KEY=
# Per-provider model override, required where the catalog has no default model.
# Pattern: ALO_AI_<SLUG_IN_UPPER_SNAKE>_MODEL, e.g. ALO_AI_MISTRAL_MODEL=mistral-small-latest
# ALO_AI_MISTRAL_MODEL=
# ALO_AI_NVIDIA_MODEL=
# ALO_AI_COHERE_MODEL=

# Set true only after review — permits the catalogued unofficial third-party
# proxies (g4f-*, llm7). Blocked by default: they can breach the upstream
# provider's terms and may log prompts.
ALO_AI_ALLOW_UNOFFICIAL_PROVIDERS=false

# Storage & Integrations — private storage, never public/uploads
# (GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are declared once in the Social OAuth
# block below — do not duplicate them here.)
STORAGE_POOL_C=
META_API_KEY=
WHATSAPP_API_KEY=

# Malware scanning for inbound student documents (src/lib/documents/malware-scan.ts)
# Optional in development: with no clamd configured the built-in signature layer
# still runs and reports an explicit "unavailable" verdict.
# REQUIRED in production, which fails closed: an unreachable scanner rejects the
# upload rather than storing an unscanned document. Point these at a clamd
# running INSTREAM (default port 3310).
CLAMAV_HOST=
CLAMAV_PORT=3310


# --- WhatsApp Business Platform (Meta Cloud API) ---
# Required for official WhatsApp sends/receives. NEVER commit real tokens.
# See docs/WHATSAPP-META-SETUP.md and docs/EMPLOYEE-WHATSAPP-ASSIGNMENT.md
WHATSAPP_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_PHONE=
# Optional: Graph API version override
WHATSAPP_GRAPH_VERSION=v23.0

# --- 3CX / Telephony / SMS / Email provider tokens (optional) ---
THREECX_API_URL=
THREECX_API_TOKEN=
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=

# --- Social OAuth — official OAuth only (Admin Official Accounts + Employee My Accounts) ---
# Facebook + Instagram (Meta Business)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# LinkedIn Pages
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# YouTube / Google (same Google OAuth — used for YouTube channel + Search Console + Business Profile)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# TikTok for Business
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# X (Twitter) OAuth 2.0
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BEARER_TOKEN=
# Telegram Bot (BotFather token, not OAuth)
TELEGRAM_BOT_TOKEN=
# Pinterest
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Google Business Profile (uses GOOGLE_CLIENT_ID/SECRET + Business Profile API)
GOOGLE_BUSINESS_ACCOUNT_ID=

# --- Google SEO & Analytics (GA4 + Search Console) ---
# GA4 — consent-aware analytics (see docs/GOOGLE_SEO_SETUP.md)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# Search Console — OAuth uses GOOGLE_CLIENT_ID/SECRET + verified domain in Search Console
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://aloeducation.com
GOOGLE_SEARCH_CONSOLE_CREDENTIALS_JSON=
# Consent + indexing
NEXT_PUBLIC_GA4_ENABLED=false
NEXT_PUBLIC_CONSENT_MODE=true

# --- ALO Official WhatsApp Number Pool (spec §2) ---
ALO_MAIN_WHATSAPP_NUMBER=01805020100
ALO_COMPLAINT_WHATSAPP_NUMBER=01805020100
ALO_FOLLOWUP_WHATSAPP_NUMBER=01805020100
ALO_COO_WHATSAPP_NUMBER=01805020101
ALO_24_7_SUPPORT_NUMBER=01805020101
ALO_EMPLOYEE_WHATSAPP_START=01805020102
ALO_EMPLOYEE_WHATSAPP_END=01805020119
# --- Web Search → Scrape → Extract → AI → CRM (Molx + Firecrawl + Enrichment) ---
# Molx endpoint must be supplied by an approved reachable service.
MOLX_URL=
MOLX_API_KEY=
# Firecrawl cloud fallback (when MOLX_URL empty or 5xx)
FIRECRAWL_URL=https://api.firecrawl.dev
FIRECRAWL_API_KEY=
# Waterfall providers (Bricks/TinyFish) — optional
TINYFISH_API_KEY=
# Lead sourcing (Apify) — optional; if empty, pipeline falls back to webSearch
APIFY_TOKEN=
APIFY_ACTOR=compass/crawler-google-places
# Enrichment (Bright Data Open Enrich / Apollo / SalesQL) — optional
BRIGHTDATA_API_KEY=
APOLLO_API_KEY=
SALESQL_API_KEY=
# Cron/scheduler secret for /api/automation/schedule (configure in hosting environment, never commit, verified server-side, never expose to frontend)
ALO_CRON_SECRET=
ALO_APP_URL=https://aloeducation.com
REDIS_URL=
# File signing secret for private document URLs — must be >=32 chars random (SEC-02) — never commit real value
FILE_SIGN_SECRET=REPLACE_WITH_LONG_RANDOM_32_PLUS_CHARS

# --- Agent Orchestrator & SEO Controlled Rollout (Phase A) ---
# One Department → One Model → Tests → Real Task → Approval → Activation
# SEO is first rollout: groq:llama-3.1-8b-instant PUBLIC no fallback
AGENT_MAX_STEPS=12
AGENT_MAX_RUNTIME_MS=120000
AGENT_MAX_TOOL_CALLS=8
AGENT_TOKEN_BUDGET=12000
AGENT_APPROVAL_POLICY=STANDARD
# Optional local AI for CONFIDENTIAL/RESTRICTED departments (leave empty for SEO PUBLIC)
LOCAL_AI_URL=
LOCAL_AI_MODEL=local-llama
# GroqGuard rate limit / circuit breaker (free-tier protection)
GROQ_PER_MINUTE=30
GROQ_MAX_CONCURRENCY=2
GROQ_MAX_QUEUE=10

# --- Chatwoot / Omnichannel (optional) ---
CHATWOOT_URL=
CHATWOOT_TOKEN=
CHATWOOT_ACCOUNT_ID=

# --- Nextcloud / Ghost / LanguageTool (optional) ---
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=
GHOST_URL=
GHOST_CONTENT_API_KEY=
GHOST_ADMIN_API_KEY=
LANGUAGETOOL_URL=
LANGUAGETOOL_USERNAME=
LANGUAGETOOL_API_KEY=

# --- Social OAuth extended (optional) ---
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_REDIRECT_URI=
INSTAGRAM_ACCESS_TOKEN=
# Nextcloud public site URL (if different from APP_URL)
NEXT_PUBLIC_SITE_URL=https://aloeducation.com
NEXT_PUBLIC_MOLX_URL=

# --- SMS / Voice providers (optional) ---
# Transport selection; URLs/keys remain server-only. No automated paid retries.
SMS_PROVIDER=generic
SMS_PROVIDER_URL=
SMS_SENDER_ID=
DOMOVINA_SMS_URL=
HTTPSMS_BASE_URL=https://api.httpsms.com
HTTPSMS_API_KEY=
HTTPSMS_FROM=
# Legacy aliases only: TOKEN is API key, PHONE_ID is E.164 sender number.
HTTPSMS_TOKEN=
HTTPSMS_PHONE_ID=
# Outbound receipts: exact registered HTTPS URL, account subject and >=32-char key.
HTTPSMS_WEBHOOK_SIGNING_KEY=
HTTPSMS_WEBHOOK_URL=
HTTPSMS_WEBHOOK_SUBJECT=
HTTPSMS_WEBHOOK_PROVIDER=httpsms
# Distinct cloud/local protocols. Operator-controlled URLs and workflows only.
RUNNINGHUB_API_URL=
RUNNINGHUB_API_KEY=
COMFYUI_API_URL=
COMFYUI_API_KEY=
COMFYUI_VIDEO_WORKFLOW_JSON=
BITWARDEN_URL=
IMAGE_GEN_PROVIDER=zai
DOODLE_NOTE_API_KEY=
DOODLE_NOTE_MODEL=

# --- Cron legacy (use ALO_CRON_SECRET for new scheduler) ---
CRON_SECRET=

OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_SITE_URL=https://crm.aloeducation.com
OPENROUTER_APP_NAME="ALO Education WhatsApp AI"

# ============================================================
# Unified Communication Center — provider webhook/signature keys
# (mandate §51). All values are placeholders — NEVER commit real
# secrets. Obtain each from the provider's official developer portal
# (see docs/integrations/provider-research/<provider>.md).
# ============================================================
# Meta (Facebook/Instagram/Messenger/WhatsApp) — app secret used to verify
# the X-Hub-Signature-256 webhook HMAC. Purpose: webhook signature. Secret: YES.
META_APP_ID=CONFIGURE_IN_SERVER_SECRET_STORE
META_APP_SECRET=
META_VERIFY_TOKEN=
# X (Twitter) — consumer secret used to verify x-twitter-webhooks-signature
# (base64 HMAC) and to answer the CRC challenge. Secret: YES.
X_CONSUMER_SECRET=
# Telegram — secret_token echoed in X-Telegram-Bot-Api-Secret-Token. Secret: YES.
TELEGRAM_WEBHOOK_SECRET=
# Google (YouTube/Google Business) — Pub/Sub push JWT audience for validation.
GOOGLE_PUBSUB_AUDIENCE=CONFIGURE_IN_SERVER_SECRET_STORE

# LIVE email transport — read by src/lib/email-service.ts (nodemailer).
# Optional for boot; without it email sending fails explicitly
# (SMTP_NOT_CONFIGURED). 587 = STARTTLS, 465 = implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
LOCAL_AI_API_KEY=

# ------------------------------------------------------------
# Email marketing engine (src/lib/email-marketing). Design: docs/email-marketing/README.md
# Defaults are SAFE: nothing is sent unless EMAIL_SENDING_ENABLED=true AND
# EMAIL_TEST_MODE=false. Test mode allows only EMAIL_TEST_RECIPIENTS.
# Caps are configured ceilings on SMTP attempts. They are NOT provider limits.
# Check your SMTP host's own sending limits before raising them.
EMAIL_SENDING_ENABLED=false
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENTS=
EMAIL_HOURLY_CAP=50
EMAIL_DAILY_CAP=300
EMAIL_BATCH_SIZE=20
EMAIL_MAX_ATTEMPTS=5
# Required before any campaign can be queued. At least 32 random characters.
EMAIL_UNSUBSCRIBE_SECRET=
EMAIL_FROM_NAME=ALO Education

# ------------------------------------------------------------
# UCC AI assistant translation provider (OPTIONAL — official provider
# credentials only). Without these, the UCC AI assistant translation
# action responds CONFIGURATION REQUIRED; all other assistant actions
# (reply suggestions, summaries, form prefill) work from stored
# conversation data only and never fabricate content.
# TRANSLATION_PROVIDER=
# TRANSLATION_API_KEY=
