# ============================================================================
# ALO Education — production environment template. NO REAL SECRETS HERE.
#
# Deployment contract (see docs/HOSTINGER-PRODUCTION-DEPLOYMENT.md):
#   HOSTING_PROVIDER=Hostinger
#   DEPLOYMENT_OWNER=Hostinger          # GitHub Actions never deploys
#   CI_OWNER=GitHub Actions             # validation only
#   PRODUCTION_BRANCH=main
#   PRODUCTION_DOMAIN=https://aloeducation.com
#
# Authoritative, machine-readable usage classification for EVERY variable:
#   docs/environment-classification.json  (regenerate: node scripts/audit-env-vars.mjs)
# The application code is authoritative. A variable that appears only in this
# template and is never read by code is listed below under "NOT CONSUMED".
# ============================================================================

# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION — verified against the consuming code
# ---------------------------------------------------------------------------
NODE_ENV=production

# Public origin. NEXT_PUBLIC_* is inlined into the browser bundle AT BUILD TIME,
# so it must be set before `npm run build`, not only at runtime.
NEXT_PUBLIC_APP_URL=https://aloeducation.com
NEXTAUTH_URL=https://aloeducation.com

# Canonical (and only) database connection source — Prisma reads env("DATABASE_URL").
# Form: mysql://USER:URL_ENCODED_PASSWORD@HOST:3306/DATABASE
# URL-encode the password (@ -> %40, : -> %3A, / -> %2F, # -> %23).
# Use the host Hostinger shows for the database; do NOT assume localhost.
DATABASE_URL="mysql://REPLACE_USER:REPLACE_URL_ENCODED_PASSWORD@REPLACE_DB_HOST:3306/REPLACE_DATABASE"

# next-auth v4 session signing. If absent, login silently issues NO session
# cookie (src/app/api/portal-auth/login/route.ts returns early).
#   generate: openssl rand -base64 48
NEXTAUTH_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# AES-256-GCM key for stored integration tokens. MUST be exactly 64 hexadecimal
# characters (32 bytes); src/lib/social/token-encryption.ts THROWS in production
# otherwise.
#   generate: openssl rand -hex 32
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Signs secure download URLs; throws in production when shorter than 32 chars.
#   generate: openssl rand -base64 48
FILE_SIGN_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# ---------------------------------------------------------------------------
# PORT / HOSTNAME — provider controlled. DO NOT SET unless Hostinger assigns a
# fixed port in the Node.js application settings.
# server.js sets HOSTNAME=0.0.0.0 itself and only validates PORT if supplied;
# otherwise the Next standalone default applies. The historical VPS port 3044
# belongs to the retired PM2/nginx architecture and is NOT VERIFIED for Hostinger.
# ---------------------------------------------------------------------------
# PORT=

# ---------------------------------------------------------------------------
# ONE-TIME SEEDING ONLY — never part of automatic deployment.
# `npm run db:seed` UPDATES the Super Admin passwordHash on every run, so wiring
# it into the Hostinger deploy command would reset the administrator password on
# each release. Run it manually, once. See docs/HOSTINGER-PRODUCTION-DEPLOYMENT.md.
# ---------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=admin@aloeducation.com
SEED_SUPER_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_ONE_TIME_ADMIN_PASSWORD

# ---------------------------------------------------------------------------
# MUST STAY EMPTY IN PRODUCTION
# Demo login is already hard-disabled when NODE_ENV=production, and a
# NEXT_PUBLIC_* value is readable by anyone in the browser bundle. Never put a
# real password here.
# ---------------------------------------------------------------------------
ENABLE_DEVELOPMENT_SAMPLE_DATA=false
DEVELOPMENT_SAMPLE_PASSWORD=

# ---------------------------------------------------------------------------
# NOT CONSUMED BY THE APPLICATION — kept only so operators recognise them.
# Verified: zero `process.env` references in src/, scripts/, prisma/, server.js
# (docs/environment-classification.json, classification "UNUSED").
#
#   DB_CONNECTION, DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD,
#   DB_CHARSET, DB_COLLATION
#       Laravel-style second database configuration. Prisma + DATABASE_URL is
#       the single authoritative connection source. Setting these does nothing
#       and risks drifting from DATABASE_URL — leave them unset.
#
#   MYSQL_ROOT_PASSWORD, MYSQL_DATABASE, MYSQL_USER, MYSQL_PASSWORD
#       docker-compose-only variables for the retired self-hosted stack. The
#       Hostinger application environment does not need them.
#
#   AUTH_SECRET, JWT_SECRET, SESSION_SECRET
#       Never read. This project uses next-auth v4, which reads NEXTAUTH_SECRET
#       (AUTH_SECRET is the Auth.js v5 name). Setting them has no effect.
#
#   APP_ENV, APP_DEBUG, APP_URL, PUBLIC_WEBSITE_URL
#       Laravel-era leftovers. Use NODE_ENV and NEXT_PUBLIC_APP_URL instead.
#       (APP_URL is read only by non-runtime helper scripts.)
# ---------------------------------------------------------------------------

TZ=Asia/Dhaka

# ---------------------------------------------------------------------------
# MAIL_* / IMAP_* / POP3_* — LEGACY, NOT READ by application code (verified in
# docs/environment-classification.json: zero references, destructured reads
# included). The live email transport is the SMTP_* block at the bottom of
# this file, consumed by src/lib/email-service.ts. These values are kept only
# so a future mailbox feature does not need to be re-invented; leaving them
# empty is equally correct.
# ---------------------------------------------------------------------------
MAIL_FROM_ADDRESS=noreply@aloeducation.com
MAIL_FROM_NAME="ALO Education"

MAIL_HOST=mail.aloeducation.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USERNAME=noreply@aloeducation.com
MAIL_PASSWORD=REPLACE_WITH_EMAIL_PASSWORD

IMAP_HOST=mail.aloeducation.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USERNAME=noreply@aloeducation.com
IMAP_PASSWORD=REPLACE_WITH_EMAIL_PASSWORD

POP3_HOST=mail.aloeducation.com
POP3_PORT=995
POP3_SECURE=true
POP3_USERNAME=noreply@aloeducation.com
POP3_PASSWORD=REPLACE_WITH_EMAIL_PASSWORD

# AI Layer Credentials & Configuration
GROQ_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=
AI_DEFAULT_MODEL=glm-4-flash
AI_FAST_MODEL=glm-4-flash
AI_SMART_MODEL=glm-4-plus
AI_AGENT_MODEL=glm-4-flash

# Free-tier AI providers — optional, catalogued in src/lib/ai-providers/catalog.ts
# Set ONLY the ones you hold a key for. Empty means "not connected" and the
# provider is skipped; nothing ever falls back to a paid API (PAID_AI_API_ALLOWED=false).
# Read dynamically by src/lib/ai-providers/resolve.ts.
GEMINI_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=
HUGGINGFACE_API_KEY=
SAMBANOVA_API_KEY=
TOGETHER_API_KEY=
DEEPINFRA_API_KEY=
SILICONFLOW_API_KEY=
SCALEWAY_API_KEY=
MODELSCOPE_API_KEY=
MORPH_API_KEY=
FEATHERLESS_API_KEY=
FRIENDLIAI_API_KEY=
ARCEE_API_KEY=
UPSTAGE_API_KEY=
QWEN_API_KEY=
POLLINATIONS_API_KEY=
# Per-provider model override where the catalog has no default:
# ALO_AI_<SLUG_IN_UPPER_SNAKE>_MODEL, e.g. ALO_AI_MISTRAL_MODEL=mistral-small-latest
# Unofficial third-party proxies (g4f-*, llm7) stay blocked unless this is true.
ALO_AI_ALLOW_UNOFFICIAL_PROVIDERS=false

# Storage & Integrations — private storage, never public/uploads
# (GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are declared once in the Social OAuth
# block below — do not duplicate them here.)
STORAGE_POOL_C=
META_API_KEY=
WHATSAPP_API_KEY=

# --- Malware scanning for inbound student documents ---
# src/lib/documents/malware-scan.ts. Production FAILS CLOSED: if clamd is
# unreachable, document uploads are rejected rather than stored unscanned.
# These two variables are therefore effectively required in production — leave
# them set for the whole life of the deployment, and monitor clamd health.
CLAMAV_HOST=
CLAMAV_PORT=3310


# --- WhatsApp Business Platform (Meta Cloud API) ---
# Required for official WhatsApp sends/receives. NEVER commit real tokens.
# See docs/WHATSAPP-META-SETUP.md and docs/EMPLOYEE-WHATSAPP-ASSIGNMENT.md
WHATSAPP_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_PHONE=
# Optional: Graph API version override
WHATSAPP_GRAPH_VERSION=v18.0

# --- 3CX / Telephony / SMS / Email provider tokens (optional) ---
THREECX_API_URL=
THREECX_API_TOKEN=
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=

# --- Social OAuth — official OAuth only (Admin Official Accounts + Employee My Accounts) ---
# Facebook + Instagram (Meta Business)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# LinkedIn Pages
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# YouTube / Google (same Google OAuth — used for YouTube channel + Search Console + Business Profile)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# TikTok for Business
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# X (Twitter) OAuth 2.0
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BEARER_TOKEN=
# Telegram Bot (BotFather token, not OAuth)
TELEGRAM_BOT_TOKEN=
# Pinterest
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Google Business Profile (uses GOOGLE_CLIENT_ID/SECRET + Business Profile API)
GOOGLE_BUSINESS_ACCOUNT_ID=

# --- Google SEO & Analytics (GA4 + Search Console) ---
# GA4 — consent-aware analytics (see docs/GOOGLE_SEO_SETUP.md)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# Search Console — OAuth uses GOOGLE_CLIENT_ID/SECRET + verified domain in Search Console
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://aloeducation.com
GOOGLE_SEARCH_CONSOLE_CREDENTIALS_JSON=
# Consent + indexing
NEXT_PUBLIC_GA4_ENABLED=false
NEXT_PUBLIC_CONSENT_MODE=true

# --- ALO Official WhatsApp Number Pool (spec §2) ---
ALO_MAIN_WHATSAPP_NUMBER=01805020100
ALO_COMPLAINT_WHATSAPP_NUMBER=01805020100
ALO_FOLLOWUP_WHATSAPP_NUMBER=01805020100
ALO_COO_WHATSAPP_NUMBER=01805020101
ALO_24_7_SUPPORT_NUMBER=01805020101
ALO_EMPLOYEE_WHATSAPP_START=01805020102
ALO_EMPLOYEE_WHATSAPP_END=01805020119
# --- Web Search → Scrape → Extract → AI → CRM (Molx + Firecrawl + Enrichment) ---
# Molx endpoint must be supplied by an approved reachable service.
MOLX_URL=
MOLX_API_KEY=
# Firecrawl cloud fallback (when MOLX_URL empty or 5xx)
FIRECRAWL_URL=https://api.firecrawl.dev
FIRECRAWL_API_KEY=
# Waterfall providers (Bricks/TinyFish) — optional
TINYFISH_API_KEY=
# Lead sourcing (Apify) — optional; if empty, pipeline falls back to webSearch
APIFY_TOKEN=
APIFY_ACTOR=compass/crawler-google-places
# Enrichment (Bright Data Open Enrich / Apollo / SalesQL) — optional
BRIGHTDATA_API_KEY=
APOLLO_API_KEY=
SALESQL_API_KEY=
# Cron/scheduler secret for /api/automation/schedule (configure in hosting environment, never commit, verified server-side, never expose to frontend)
ALO_CRON_SECRET=
ALO_APP_URL=https://aloeducation.com
REDIS_URL=
# NOTE: FILE_SIGN_SECRET is declared once in the REQUIRED block at the top of
# this file. Do not add a second copy — duplicate keys in a .env file silently
# override each other depending on the loader.

# --- Agent Orchestrator & SEO Controlled Rollout (Phase A) ---
# One Department → One Model → Tests → Real Task → Approval → Activation
# SEO is first rollout: groq:llama-3.1-8b-instant PUBLIC no fallback
AGENT_MAX_STEPS=12
AGENT_MAX_RUNTIME_MS=120000
AGENT_MAX_TOOL_CALLS=8
AGENT_TOKEN_BUDGET=12000
AGENT_APPROVAL_POLICY=STANDARD
# Optional local AI for CONFIDENTIAL/RESTRICTED departments (leave empty for SEO PUBLIC)
LOCAL_AI_URL=
LOCAL_AI_MODEL=local-llama
# GroqGuard rate limit / circuit breaker (free-tier protection)
GROQ_PER_MINUTE=30
GROQ_MAX_CONCURRENCY=2
GROQ_MAX_QUEUE=10

# --- Chatwoot / Omnichannel (optional) ---
CHATWOOT_URL=
CHATWOOT_TOKEN=
CHATWOOT_ACCOUNT_ID=

# --- Nextcloud / Ghost / LanguageTool (optional) ---
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=
GHOST_URL=
GHOST_CONTENT_API_KEY=
GHOST_ADMIN_API_KEY=
LANGUAGETOOL_URL=
LANGUAGETOOL_USERNAME=
LANGUAGETOOL_API_KEY=

# --- Social OAuth extended (optional) ---
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_REDIRECT_URI=
INSTAGRAM_ACCESS_TOKEN=
# Nextcloud public site URL (if different from APP_URL)
NEXT_PUBLIC_SITE_URL=https://aloeducation.com
NEXT_PUBLIC_MOLX_URL=

# --- SMS / Voice providers (optional) ---
DOMOVINA_SMS_URL=
HTTPSMS_TOKEN=
HTTPSMS_PHONE_ID=
BITWARDEN_URL=
IMAGE_GEN_PROVIDER=zai
DOODLE_NOTE_API_KEY=
DOODLE_NOTE_MODEL=

# --- Cron legacy (use ALO_CRON_SECRET for new scheduler) ---
CRON_SECRET=

OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# UNUSED by application code today (docs/environment-classification.json lists
# it as "UNUSED"). If OpenRouter integration is enabled later, this must be the
# canonical production origin:
OPENROUTER_SITE_URL=https://aloeducation.com
OPENROUTER_APP_NAME="ALO Education WhatsApp AI"

# --- LIVE EMAIL TRANSPORT (SMTP_*) — actually read by src/lib/email-service.ts ---
# OPTIONAL for boot: without these the app starts normally and email sending
# fails explicitly with SMTP_NOT_CONFIGURED (no silent drop, no fake success).
# Port: 587 (STARTTLS) or 465 (implicit TLS). Acceptance by the provider is not
# proof of inbox delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
LOCAL_AI_API_KEY=
