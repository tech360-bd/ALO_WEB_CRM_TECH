3:Tc41,{"@context":"https://schema.org","@graph":[{"@context":"https://schema.org","@type":"Organization","@id":"https://alaminn.info/higher-study#organization","name":"Alaminn.info Higher Study","url":"https://alaminn.info/higher-study","parentOrganization":{"@type":"Organization","name":"Alaminn.info","url":"https://alaminn.info"},"logo":{"@type":"ImageObject","url":"https://alaminn.info/logo.svg"},"description":"Higher Study platform on Alaminn.info — verified university, course, scholarship, PhD and supervisor information across 30 study destinations, with referral handoff to ALO Education for application processing.","knowsAbout":["International higher education","University applications","Scholarships","PhD and research opportunities","Academic supervisors","Study destinations","IELTS, PTE, TOEFL English proficiency"],"areaServed":"Global","sameAs":["https://aloeducation.com","https://english.aloeducation.com"]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is the Higher Study information on Alaminn.info free?","acceptedAnswer":{"@type":"Answer","text":"Yes. All verified university, course, scholarship, PhD and supervisor information is free to browse. When you choose to apply, you are transferred to ALO Education, Alaminn.info's official application partner, with full consent tracking."}},{"@type":"Question","name":"How is the information verified?","acceptedAnswer":{"@type":"Answer","text":"Every entity has a verification status (draft, pending-review, verified, published, needs-update or archived) and a last-verified timestamp. Where possible, we link to the official source so you can confirm details directly with the university or funding body."}},{"@type":"Question","name":"What does applying through ALO Education mean?","acceptedAnswer":{"@type":"Answer","text":"When you click Apply, we create a referral record with only public context (study level, country, programme slug) and transfer you to ALO Education's secure registration page. Your name, email and documents are collected by ALO Education after the transfer, on their own domain."}},{"@type":"Question","name":"Can I save universities and courses for later?","acceptedAnswer":{"@type":"Answer","text":"Yes. Use the Save button on any card to bookmark it. Anonymous saves are stored in your browser; if you sign in, they sync to your Alaminn.info account. You can also compare up to 4 entities side-by-side."}},{"@type":"Question","name":"Do you cover scholarships for international students?","acceptedAnswer":{"@type":"Answer","text":"Yes — we track 24 funding types including fully-funded, government, university, research-council and named programmes like Chevening, Commonwealth, Erasmus Mundus, Rhodes, Gates Cambridge, Marshall, Fulbright and DAAD."}},{"@type":"Question","name":"How often is the data updated?","acceptedAnswer":{"@type":"Answer","text":"Verification timestamps are shown on every entity. We sweep stale records and mark them as 'needs-update' when they pass their review cycle. You can subscribe to the bi-weekly digest for new scholarship and PhD deadlines."}}]}]}0:{"buildId":"lM9HtQ-WbXM1-EQARuZgj","rsc":["$","$1","c",{"children":[[["$","div",null,{"className":"border-b border-ink-100 bg-white","children":["$","div",null,{"className":"mx-auto max-w-[1320px] px-4 py-3 sm:px-6","children":["$","nav",null,{"aria-label":"Breadcrumb","className":"w-full","children":[["$","ol",null,{"className":"flex flex-wrap items-center gap-1.5 text-xs text-ink-500 sm:gap-2 sm:text-sm","children":[["$","li","Home-0",{"className":"inline-flex items-center gap-1.5","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-house h-3.5 w-3.5 text-ink-400","aria-hidden":"true","children":[["$","path","5wwlr5",{"d":"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0