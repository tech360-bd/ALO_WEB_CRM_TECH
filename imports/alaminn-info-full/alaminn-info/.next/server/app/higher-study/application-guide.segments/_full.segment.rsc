51:["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-ink-700","children":"It depends. Some universities waive the English requirement if your previous degree was taught in English (typically in the UK, USA, Ireland, Australia, New Zealand, Canada — but not all). Check each university's English waiver policy. If you're from Bangladesh, India, Pakistan or Nigeria, you usually still need to take an English test."}]
52:["$","details","3",{"className":"group rounded-xl border border-ink-100 bg-ink-50/40 p-4 [&_summary]:cursor-pointer [&_summary]:list-none","children":[["$","summary",null,{"className":"flex items-center justify-between gap-2 font-semibold text-ink-900","children":["What's the difference between SOP and personal statement?",["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right h-4 w-4 shrink-0 text-ink-400 transition-transform group-open:rotate-90","aria-hidden":"true","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-ink-700","children":"An SOP (Statement of Purpose) is typically longer (500–1000 words) and focuses on academic + research interests + career goals — used for postgraduate applications. A personal statement (UCAS undergrad in the UK) is shorter (4000 characters max) and broader — about why you want to study the subject, what makes you suitable, and your wider interests."}]]}]
53:["$","details","4",{"className":"group rounded-xl border border-ink-100 bg-ink-50/40 p-4 [&_summary]:cursor-pointer [&_summary]:list-none","children":[["$","summary",null,{"className":"flex items-center justify-between gap-2 font-semibold text-ink-900","children":["Can I apply for scholarships before I have an offer?",["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right h-4 w-4 shrink-0 text-ink-400 transition-transform group-open:rotate-90","aria-hidden":"true","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-ink-700","children":"Yes — and you should! Many scholarships (Chevening, Commonwealth, Erasmus Mundus, DAAD) have deadlines BEFORE course application deadlines, or run in parallel. Apply for scholarships as soon as applications open — usually 10–12 months before course start."}]]}]
54:["$","details","5",{"className":"group rounded-xl border border-ink-100 bg-ink-50/40 p-4 [&_summary]:cursor-pointer [&_summary]:list-none","children":[["$","summary",null,{"className":"flex items-center justify-between gap-2 font-semibold text-ink-900","children":["How much bank balance do I need to show for a student visa?",["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right h-4 w-4 shrink-0 text-ink-400 transition-transform group-open:rotate-90","aria-hidden":"true","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-ink-700","children":"It varies by country. UK: tuition for first year + £1,334/month (London) or £1,023/month (outside London) for 9 months. USA: cost shown on I-20. Australia: AUD 24,505/year + travel + tuition. Canada: CAD 10,000/year (Quebec: CAD 11,411) + tuition. Funds must usually be held for 28+ consecutive days before applying."}]]}]
55:["$","details","6",{"className":"group rounded-xl border border-ink-100 bg-ink-50/40 p-4 [&_summary]:cursor-pointer [&_summary]:list-none","children":[["$","summary",null,{"className":"flex items-center justify-between gap-2 font-semibold text-ink-900","children":["What happens if my visa is refused?",["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right h-4 w-4 shrink-0 text-ink-400 transition-transform group-open:rotate-90","aria-hidden":"true","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-ink-700","children":"You can usually re-apply, but you'll lose time and may need to defer your course start date. Common refusal reasons: insufficient financial evidence, weak English score, inconsistent SOP, or failing the credibility interview. Use our consultation service to review your visa application before submitting — it's free."}]]}]
56:["$","details","7",{"className":"group rounded-xl border border-ink-100 bg-ink-50/40 p-4 [&_summary]:cursor-pointer [&_summary]:list-none","children":[["$","summary",null,{"className":"flex items-center justify-between gap-2 font-semibold text-ink-900","children":["Should I apply through an agent or directly?",["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right h-4 w-4 shrink-0 text-ink-400 transition-transform group-open:rotate-90","aria-hidden":"true","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-ink-700","children":"Both routes work. Direct applications give you full control. Applying through a verified partner like ALO Education (via our consent-tracked referral) gives you document review, deadline tracking and often application fee waivers — without surrendering control of your data. Always check an agent's credentials and never pay for 'guaranteed admission'."}]]}]
