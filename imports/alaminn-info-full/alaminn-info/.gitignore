# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Alaminn.info — .gitignore (at repo root: /home/z/my-project)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ─── Environment & secrets ─────────────────────────────────────────
# Never commit real environment files. Only .env.example is allowed.
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
**/.env
**/.env.local
**/.env.*.local
**/.env.development
**/.env.production
**/.env.test
!.env.example
!**/.env.example

# ─── Build output ───────────────────────────────────────────────────
.next/
out/
dist/
build/
**/.next/
**/out/
**/dist/
**/build/

# ─── Dependencies ────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ─── Database files (SQLite dev only; production uses MariaDB) ───────
db/*.db
db/*.db-journal
db/*.sqlite
db/*.sqlite-journal
**/db/*.db
**/db/*.db-journal
**/db/*.sqlite
**/db/*.sqlite-journal

# ─── Logs ────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
**/*.log

# ─── Runtime / process files ────────────────────────────────────────
*.pid
*.seed
*.pid.lock
pids/

# ─── Coverage & test artifacts ──────────────────────────────────────
coverage/
.nyc_output/
.vitest-cache/

# ─── Editor / IDE / OS ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Project-specific runtime artifacts ─────────────────────────────
upload/
tool-results/
agent-ctx/
backups/

# ─── Other ──────────────────────────────────────────────────────────
skills/
*.pem
*.key
id_rsa*
id_ed25519*
.env*.backup
