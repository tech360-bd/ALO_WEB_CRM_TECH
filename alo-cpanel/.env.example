APP_ENV=production
APP_DEBUG=false
APP_URL=https://crm.aloeducation.com
APP_TIMEZONE=Asia/Dhaka
APP_NAME="ALO Education CRM"

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=aloeduca_alo_crm
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

OPENROUTER_API_KEY=CHANGE_ME
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_SITE_URL=https://crm.aloeducation.com
OPENROUTER_APP_NAME="ALO Education WhatsApp AI"

WHATSAPP_VERIFY_TOKEN=CHANGE_ME
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_BUSINESS_ACCOUNT_ID=CHANGE_ME
WHATSAPP_GRAPH_VERSION=v20.0

ALO_MAIN_WHATSAPP_NUMBER=01805020100
ALO_COMPLAINT_WHATSAPP_NUMBER=01805020100
ALO_FOLLOWUP_WHATSAPP_NUMBER=01805020100
ALO_COO_WHATSAPP_NUMBER=01805020101
ALO_24_7_SUPPORT_NUMBER=01805020101
ALO_EMPLOYEE_WHATSAPP_START=01805020102
ALO_EMPLOYEE_WHATSAPP_END=01805020119

WHATSAPP_DEFAULT_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_DEFAULT_BUSINESS_ACCOUNT_ID=CHANGE_ME

SESSION_NAME=ALO_CRM_SESSION
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_TTL=7200

CSRF_SECRET=CHANGE_ME
APP_KEY=CHANGE_ME

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Additional ALO CRM ---
MAIL_FROM_ADDRESS=noreply@aloeducation.com
MAIL_FROM_NAME="ALO Education"
MAIL_HOST=mail.aloeducation.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USERNAME=noreply@aloeducation.com
MAIL_PASSWORD=CHANGE_ME

