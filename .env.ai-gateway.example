# ============================================================================
# Shared AI Gateway — example configuration
# ----------------------------------------------------------------------------
# Copy to the gateway's own secret file (never into the repository). Placeholders
# only: no real credential belongs in this file.
#
#   install -m 600 .env.ai-gateway.example /etc/alo/ai-gateway.env
#
# The gateway fails closed. Missing app registry or provider configuration makes
# readiness fail; in production it refuses to start.
# ============================================================================

NODE_ENV=production

# --- Listeners --------------------------------------------------------------
# Both default to loopback. Expose the API only through the approved reverse
# proxy; never publish the metrics port.
AI_GATEWAY_HOST=127.0.0.1
AI_GATEWAY_PORT=3180
AI_GATEWAY_BASE_URL=http://127.0.0.1:3180
AI_GATEWAY_METRICS_HOST=127.0.0.1
AI_GATEWAY_METRICS_PORT=9180
AI_GATEWAY_METRICS_ENABLED=true

# --- Authentication ---------------------------------------------------------
# One identity per application. `tokenSha256` is the lowercase hex SHA-256 of a
# random token of at least 32 characters. Generate with:
#   node -e "const c=require('crypto');const t=c.randomBytes(32).toString('hex');console.log(t);console.log(c.createHash('sha256').update(t).digest('hex'))"
# Store the plaintext token only in the consuming application's secret store.
# dataClassification: PUBLIC | INTERNAL | CONFIDENTIAL | RESTRICTED
# allowExternal: true only after the provider DPA and data policy are approved.
AI_GATEWAY_APPS=[{"id":"crm","tokenSha256":"REPLACE_WITH_64_HEX_CHARACTERS","dataClassification":"INTERNAL","allowExternal":false,"requestsPerMinute":60},{"id":"phd","tokenSha256":"REPLACE_WITH_64_HEX_CHARACTERS","dataClassification":"CONFIDENTIAL","allowExternal":false,"allowedModels":["local-model"],"requestsPerMinute":30},{"id":"agentos","tokenSha256":"REPLACE_WITH_64_HEX_CHARACTERS","dataClassification":"INTERNAL","allowExternal":false,"requestsPerMinute":30}]

# --- Timeouts, retries, concurrency ----------------------------------------
AI_GATEWAY_REQUEST_TIMEOUT_MS=120000
AI_GATEWAY_MAX_RETRIES=2
AI_GATEWAY_RETRY_BASE_MS=120
AI_GATEWAY_CIRCUIT_BREAKER_ENABLED=true
AI_GATEWAY_CIRCUIT_FAILURE_THRESHOLD=5
AI_GATEWAY_CIRCUIT_RESET_MS=30000
AI_GATEWAY_MAX_CONCURRENT_REQUESTS=8
AI_GATEWAY_MAX_INPUT_BYTES=1048576
AI_GATEWAY_MAX_OUTPUT_TOKENS=4096

# --- Logging and audit ------------------------------------------------------
# Prompt and completion logging is refused in production; it exists only as an
# explicit, audited change for local debugging.
AI_GATEWAY_LOG_LEVEL=info
AI_GATEWAY_LOG_PROMPTS=false
AI_GATEWAY_LOG_COMPLETIONS=false
AI_GATEWAY_AUDIT_ENABLED=true

# --- Routing policy ---------------------------------------------------------
AI_GATEWAY_DEFAULT_ROUTE=policy_default
AI_GATEWAY_EXTERNAL_FALLBACK_ENABLED=false
AI_EXTERNAL_DATA_POLICY=restricted
AI_PROVIDER_ALLOWLIST=
AI_MONTHLY_BUDGET_LIMIT=
AI_MAX_COST_PER_REQUEST=

# --- Local model adapter ----------------------------------------------------
# Leave both blank to disable local inference. Verify memory/latency first.
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_NAME=
LOCAL_MODEL_API_KEY=
LOCAL_MODEL_REQUEST_TIMEOUT_MS=120000

# --- Approved external adapter ---------------------------------------------
# Enabled only when AI_EXTERNAL_DATA_POLICY=approved, AI_PROVIDER_ALLOWLIST
# contains `external`, and the provider's data terms are approved.
EXTERNAL_MODEL_BASE_URL=
EXTERNAL_MODEL_NAME=
EXTERNAL_MODEL_API_KEY=
EXTERNAL_MODEL_REQUEST_TIMEOUT_MS=60000

# --- Deterministic mock (non-production only) -------------------------------
# Used by scripts/verify-ai-gateway.sh and the unit tests. Never enable it in
# production: it would make readiness true without a real model.
AI_GATEWAY_ENABLE_MOCK=false
AI_GATEWAY_MOCK_MODEL=mock-1

# --- Monitoring -------------------------------------------------------------
PROMETHEUS_ENABLED=false
PROMETHEUS_BASE_URL=http://127.0.0.1:9090
GRAFANA_BASE_URL=http://127.0.0.1:3030
ALERTS_ENABLED=false
AI_USAGE_RETENTION_DAYS=30
