# ============================================================
# ALO Data & Evidence (large files — use external storage)
# ============================================================
# Large canonical datasets (>1MB) should NOT be tracked in git
# Keep only small manifests (<100KB) if needed for CI
# Use S3/R2/external storage for full datasets
*.csv
!prisma/seed-data/*.csv
ALO_*.csv
