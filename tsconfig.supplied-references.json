{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "types": [
      "node"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": false,
    "plugins": [],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [],
  "exclude": [
    "node_modules",
    "prisma",
    "scripts",
    "skills",
    "backend",
    "agents",
    "memory",
    "storage",
    "evidence",
    "backups",
    "extracted_packages",
    ".next"
  ],
