{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/application-manager/layout,_N_T_/application-manager/applications/layout,_N_T_/application-manager/applications/page,_N_T_/application-manager/applications"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/application-manager/applications/__PAGE__",
    "/application-manager/applications",
    "/application-manager",
    "/_index",
    "/_head"
  ]
}