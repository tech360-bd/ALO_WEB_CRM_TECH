{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/resources/layout,_N_T_/resources/blogs/layout,_N_T_/resources/blogs/page,_N_T_/resources/blogs"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/resources/blogs/__PAGE__",
    "/resources/blogs",
    "/resources",
    "/_index",
    "/_head"
  ]
}