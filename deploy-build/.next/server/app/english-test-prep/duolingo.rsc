7:["$","$L12",null,{"test":{"id":"test-det","slug":"duolingo","name":"Duolingo English Test (DET)","shortName":"Duolingo","officialOwner":"Duolingo Inc.","logoBadge":"🇺🇸 🇨🇦 🇬🇧 Online Adaptive","heroTitle":"Duolingo English Test Preparation & Fast Certification","heroSubtitle":"Prepare for the affordable, convenient computer-adaptive test taken at home in 1 hour with results in 48 hours.","expectedScore":"Score 110 - 130+ Overall (Subscores: Literacy, Comprehension, Conversation, Production)","quickFacts":[{"label":"Official Owner","value":"Duolingo Inc. (USA)"},{"label":"Test Duration","value":"1 Hour Online"},{"label":"Score Scale","value":"10 to 160 Points"},{"label":"Validity","value":"2 Years from Test Date"},{"label":"Test Fee in BD","value":"BDT 7,200 ($59 USD)"},{"label":"Global Recognition","value":"5,000+ Universities Worldwide"}],"overview":{"whatIsIt":"The Duolingo English Test is a modern language proficiency tool designed for international students and institutions, available online on demand.","whoAcceptsIt":"Over 5,000 universities worldwide, including Columbia, Yale, NYU, and hundreds of UK, Canadian, and European institutions.","whyUniversitiesRequireIt":"Fast, accurate adaptive assessment of English skills with verified video interview sample.","whyVisaOfficesRequireIt":"Accepted for US I-20 issuance, and accepted by universities sponsoring UK and European student visas.","globalRecognition":"Rapidly expanding across major US, UK, Canadian, and European higher education institutions.","history":"Launched in 2016 to democratize access to language testing.","purpose":"Assess integrated English proficiency conveniently from home via AI-proctored adaptive testing."},"quickInfo":{"duration":"1 Hour","resultTime":"48 Hours","scoreScale":"10 to 160 Points (5-point increments)","cost":"BDT 7,200 ($59 USD)","validity":"2 Years","format":"100% Online Computer-Adaptive at Home with Web Camera","acceptedCountries":["United States","United Kingdom","Canada","Germany","Ireland","France"],"officialWebsite":"https://englishtest.duolingo.com","bestFor":"Students needing fast, affordable certification for US and UK universities.","difficultyLevel":"Adaptive (Adjusts to your proficiency level)"},"whyChoose":{"advantages":["Affordable $59 fee compared to $200+ traditional exams.","Take anytime, anywhere from your computer at home.","Fast 48-hour certified score delivery.","Send scores to unlimited universities for free."],"disadvantages":["Strict computer proctoring rules (cannot look away from screen or wear headphones).","Not all Australian public universities accept DET."],"whoShouldTake":["Students applying to US, UK, and Canadian partner institutions accepting DET."],"whoShouldAvoid":["Students applying for Australian student visas requiring IELTS/PTE."],"careerValue":"Modern certified digital credential.","visaValue":"Accepted for US I-20 issuance and university-sponsored UK CAS.","scholarshipValue":"Accepted for university institutional merit awards."},"countriesAccepting":[{"country":"United States","flag":"🇺🇸","acceptanceRate":"95%","visaRule":"Accepted for Form I-20 issuance.","universityRule":"Score 110 - 130 standard.","profRegRule":"Varies by state."},{"country":"United Kingdom","flag":"🇬🇧","acceptanceRate":"65%","visaRule":"Accepted by universities assessing English for degree-level CAS.","universityRule":"Score 105 - 125.","profRegRule":"Check specific board."}],"universitiesAccepting":[{"tier":"Top Universities","typicalScore":"115 - 135+","foundationScore":"95","ugScore":"110","mastersScore":"120","mbaScore":"125","phdScore":"130","scholarshipScore":"135+","examples":["Yale University","NYU","Columbia University","McGill University"]}],"minimumScoresTable":[{"country":"United States","university":"New York University","courseLevel":"Undergraduate","minimumScore":"125","competitiveScore":"135","recommendedScore":"135","scholarshipScore":"140"}],"examPattern":[{"moduleName":"Adaptive Test","duration":"45 Mins","numQuestions":"Computer Adaptive Tasks","description":"C-Test, Read Aloud, Listen and Type, Write About Photo, Speak About Photo, Read then Write."},{"moduleName":"Video Interview & Writing Sample","duration":"15 Mins","numQuestions":"2 Tasks","description":"Unscored open-ended video recording and writing sample shared with universities."}],"moduleDetails":[{"moduleName":"Adaptive Tasks","purpose":"Measures Literacy, Comprehension, Conversation, and Production.","timeLimit":"45 Mins","questionTypes":["Fill in Blanks","Select Real Words","Read Aloud"],"markingCriteria":["AI automated scoring"],"proTips":["Keep eyes centered on camera."],"commonMistakes":["Looking away from screen."]}],"formatComparison":[{"feature":"Location","paperFormat":"N/A","computerFormat":"N/A","homeOnlineFormat":"Home Online"}],"scoringSystem":[{"scoreBand":"120 - 160","cefrLevel":"C1/C2 Advanced","gradeDescription":"Can understand complex spoken and written language.","uniAcceptance":"Top Tier Universities","visaAcceptance":"Full Visa Compliant"}],"countryFees":[{"country":"Global","currencyFee":"$$59 USD","bdtEquivalent":"BDT 7,200"}],"bookingProcess":[{"step":1,"title":"Create Duolingo Account","desc":"Sign up on englishtest.duolingo.com."},{"step":2,"title":"Purchase Test","desc":"Pay $59 via credit card."},{"step":3,"title":"Take Test Online","desc":"Start test within 21 days."}],"requiredDocs":["Original Passport or NID"],"testDayGuide":{"beforeArrival":["Test webcam and microphone."],"checkInRules":["Ensure room is quiet and well lit."],"duringExam":["Do not look away from screen."],"afterExam":["Results sent in 48 hours."]},"prepTimelines":[{"duration":"1 Month","targetStudentProfile":"Score 115+ target","focusAreas":["Subscore balance"],"dailyHours":"2 Hours / Day"}],"studyPlan":[{"period":"Week 1","listening":"Listen and Type practice.","reading":"C-Test fill in blanks.","writing":"Write about photo.","speaking":"Speak about photo.","vocabGrammar":"Real word selection."}],"commonMistakes":[{"category":"Security","mistake":"Looking off-camera.","solution":"Maintain eye contact with screen."}],"expertTips":[{"area":"Production Subscore","tip":"Write extended paragraphs with complex vocabulary for Write About Photo."}],"successStories":[{"studentName":"Mahmud Hasan","country":"United States","flag":"🇺🇸","university":"University of South Florida","course":"BSc Business","achievedScore":"125 Overall","requiredScore":"110","visaStatus":"F-1 Visa Granted"}],"faqs":[{"question":"Is Duolingo accepted for US student visa?","answer":"Yes, when accepted by your US university to issue the Form I-20."},{"question":"How long is Duolingo valid?","answer":"Scores are valid for 2 years from test completion."}],"seoArticle":{"title":"Duolingo English Test Prep Guide 2026","content":"Comprehensive guide to achieving 125+ on DET for study abroad."}}}]
