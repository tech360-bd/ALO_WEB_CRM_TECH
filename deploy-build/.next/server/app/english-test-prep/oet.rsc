7:["$","$L12",null,{"test":{"id":"test-oet","slug":"oet","name":"OET (Healthcare)","shortName":"OET","officialOwner":"Cambridge Boxhill Language Assessment (CBLA)","logoBadge":"🏥 Professional Healthcare","heroTitle":"OET Prep for Doctors, Nurses & Healthcare Professionals","heroSubtitle":"Excel in the Occupational English Test, designed specifically for 12 healthcare professions and accepted globally.","expectedScore":"Grade B (350+ out of 500) per sub-test","quickFacts":[{"label":"Format","value":"Paper or Computer at Center"},{"label":"Valid for","value":"2 Years"},{"label":"Registration Fee","value":"AUD $587"},{"label":"Results Release","value":"16 Business Days"}],"overview":{"whatIsIt":"The Occupational English Test (OET) is an international English language test that assesses the language communication skills of healthcare professionals.","whoAcceptsIt":"Accepted by major regulatory healthcare boards, councils, and universities in the UK, USA, Australia, Canada, Ireland, and New Zealand.","whyUniversitiesRequireIt":"Ensures healthcare students and professionals can communicate safely and effectively in clinical settings.","whyVisaOfficesRequireIt":"Required for healthcare migration visas and professional registration.","globalRecognition":"Widely recognized by healthcare regulators in English-speaking nations.","history":"Established in the late 1980s, co-owned by Cambridge Assessment English.","purpose":"Clinical workplace simulation of Listening, Reading, Writing, and Speaking skills."},"quickInfo":{"duration":"3 Hours approx.","resultTime":"16 Days","scoreScale":"0 - 500 (Grades A to E)","cost":"AUD $587 (approx BDT 46,000)","validity":"2 Years","format":"Paper-based or Computer-based (in-center)","acceptedCountries":["United Kingdom","USA","Australia","Canada","Ireland","New Zealand"],"officialWebsite":"https://www.occupationalenglishtest.org","bestFor":"Healthcare Registration & Study","difficultyLevel":"Advanced Professional"},"whyChoose":{"advantages":["Healthcare-specific scenarios","Builds clinical vocabulary","Respected by global medical boards"],"disadvantages":["Higher cost than other tests","Fewer test dates/locations"],"whoShouldTake":["Nurses and doctors seeking registration abroad","Healthcare postgraduate students"],"whoShouldAvoid":["General academic applicants","Business and engineering students"],"careerValue":"Highly valuable for clinical roles","visaValue":"Fully approved for medical visas","scholarshipValue":"Rarely linked to general scholarships"},"countriesAccepting":[{"country":"United Kingdom","flag":"🇬🇧","acceptanceRate":"High","visaRule":"Accepted for Health and Care worker visas","universityRule":"Accepted by medical schools","profRegRule":"Required by GMC & NMC"}],"universitiesAccepting":[{"tier":"Top Tier Medical","typicalScore":"Grade B (350+)","foundationScore":"N/A","ugScore":"Grade B","mastersScore":"Grade B","mbaScore":"N/A","phdScore":"Grade B","scholarshipScore":"N/A","examples":["King's College London","University of Edinburgh"]}],"minimumScoresTable":[{"country":"UK","university":"GMC / NMC Registration","courseLevel":"Professional Registration","minimumScore":"Grade B (350)","competitiveScore":"Grade B (350+)","recommendedScore":"Grade B (350)","scholarshipScore":"N/A"}],"examPattern":[{"moduleName":"Listening","duration":"45 Mins","numQuestions":"42 Questions","description":"Follow consultation audio and extract patient/treatment details."}],"moduleDetails":[{"moduleName":"OET Modules","purpose":"Test clinical communicative readiness.","timeLimit":"Approx 3 Hours","questionTypes":["Listening","Reading","Writing","Speaking"],"markingCriteria":["Linguistic and clinical appropriateness"],"proTips":["Focus on medical terms and clinical roleplay scenarios."],"commonMistakes":["Using generic academic essay structures in the Writing section."]}],"formatComparison":[{"feature":"Delivery","paperFormat":"Paper in Center","computerFormat":"Computer in Center","homeOnlineFormat":"OET@Home (Limited)"}],"scoringSystem":[{"scoreBand":"350 - 440 (Grade B)","cefrLevel":"C1 Level","gradeDescription":"Very Good Level of English","uniAcceptance":"Medical Schools & Boards","visaAcceptance":"Health Visa Compliant"}],"countryFees":[{"country":"Bangladesh","currencyFee":"AUD $587","bdtEquivalent":"BDT 46,000"}],"bookingProcess":[{"step":1,"title":"Register on OET Portal","desc":"Select profession and upload healthcare credentials."},{"step":2,"title":"Choose Venue & Date","desc":"Select preferred test center in Dhaka or Chittagong."},{"step":3,"title":"Pay Exam Fee","desc":"Pay AUD $587 using international card."}],"requiredDocs":["Valid Passport","Professional License details"],"testDayGuide":{"beforeArrival":["Prepare healthcare ID and Passport."],"checkInRules":["Verification of medical registration status."],"duringExam":["Clinical roleplays are recorded via microphone."],"afterExam":["Results sent to global boards automatically upon request."]},"prepTimelines":[{"duration":"4-6 Weeks","targetStudentProfile":"Qualified Nurses/Doctors","focusAreas":["Clinical writing","Roleplay fluency"],"dailyHours":"3 Hours"}],"studyPlan":[{"period":"Week 1-4","listening":"Clinical consultations","reading":"Medical journals","writing":"Patient referral letters","speaking":"Doctor-patient dialogue","vocabGrammar":"Medical terminology"}],"commonMistakes":[{"category":"Writing","mistake":"Including irrelevant general background information in referral letter.","solution":"Keep letter strictly focused on clinical case details."}],"expertTips":[{"area":"Speaking","tip":"Engage naturally during roleplays as if talking to a real patient."}],"successStories":[{"studentName":"Dr. Farhana Yasmin","country":"United Kingdom","flag":"🇬🇧","university":"GMC Registration","course":"Clinical Medicine","achievedScore":"Grade B (380 overall)","requiredScore":"Grade B","visaStatus":"Health Visa Approved"}],"faqs":[{"question":"Is OET accepted for GMC registration in the UK?","answer":"Yes, OET is fully accepted by the General Medical Council (GMC) for doctors and NMC for nurses."},{"question":"Can I take OET from home?","answer":"OET@Home is available in selected locations, but in-center paper/computer tests are preferred."}],"seoArticle":{"title":"OET Exam Guide 2026","content":"Complete overview of the Occupational English Test format, fees, and centers in Bangladesh..."}}}]
