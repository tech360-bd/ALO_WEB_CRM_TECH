7:["$","$L12",null,{"test":{"id":"test-oietc","slug":"oietc","name":"Oxford ELLT (OIETC)","shortName":"Oxford ELLT","officialOwner":"Oxford International Education Group (OIEG)","logoBadge":"🇬🇧 Oxford ELLT Official","heroTitle":"Oxford ELLT (OIETC) English Test Preparation","heroSubtitle":"Prepare for the Oxford ELLT 4-step English language level test trusted by 100+ UK and global universities.","expectedScore":"Level 6 - 8 (B2 to C1 Equivalent)","quickFacts":[{"label":"Official Owner","value":"Oxford International Education Group"},{"label":"Test Duration","value":"Modular (Complete over days or in single sitting)"},{"label":"Score Scale","value":"Level 1 to 12 (Mapped to CEFR & IELTS)"},{"label":"Validity","value":"2 Years"},{"label":"Test Fee in BD","value":"£120 GBP (Approx BDT 18,500)"},{"label":"Global Recognition","value":"100+ UK Universities and Colleges"}],"overview":{"whatIsIt":"The Oxford ELLT (English Language Level Test) is a modular online and test centre English language proficiency assessment created by Oxford International.","whoAcceptsIt":"Over 100 UK universities and colleges for undergraduate and postgraduate degree admissions.","whyUniversitiesRequireIt":"Fast, reliable university-endorsed English qualification.","whyVisaOfficesRequireIt":"Accepted by UK Higher Education Institutions with degree-awarding powers to issue CAS letters.","globalRecognition":"Widely recognized across UK higher education sector.","history":"Developed by Oxford International Education Group.","purpose":"Deliver flexible, modular language assessment with live human examiner speaking interview."},"quickInfo":{"duration":"Modular: 4 Separate Stages","resultTime":"Typically 48 Hours","scoreScale":"Level 1 to Level 12 (Level 6 = IELTS 6.0, Level 7 = IELTS 6.5, Level 8 = IELTS 7.0)","cost":"£120 GBP (BDT 18,500)","validity":"2 Years","format":"Online Portal with live online examiner speaking test","acceptedCountries":["United Kingdom","Canada","Europe"],"officialWebsite":"https://oxfordellt.com","bestFor":"Students targeting UK universities with fast turnaround.","difficultyLevel":"Moderate"},"whyChoose":{"advantages":["Modular format: complete Reading and Listening at your own pace within test window.","Live 1-on-1 speaking test with experienced UK examiner.","Direct acceptance for CAS issuance at 100+ UK universities."],"disadvantages":["Primarily accepted in the UK; limited acceptance in Australia."],"whoShouldTake":["Students applying to UK universities accepting Oxford ELLT."],"whoShouldAvoid":["Students needing Australian Subclass 500 visa compliance."],"careerValue":"Certified CEFR assessment.","visaValue":"Accepted for degree-level UK student visas.","scholarshipValue":"Eligible for partner university awards."},"countriesAccepting":[{"country":"United Kingdom","flag":"🇬🇧","acceptanceRate":"75%","visaRule":"Accepted by HEIs for degree-level CAS.","universityRule":"Level 6 to 8.","profRegRule":"Check with provider."}],"universitiesAccepting":[{"tier":"UK Universities","typicalScore":"Level 7 (IELTS 6.5)","foundationScore":"Level 5","ugScore":"Level 6","mastersScore":"Level 7","mbaScore":"Level 7","phdScore":"Level 8","scholarshipScore":"Level 8+","examples":["Coventry","Hertfordshire","Greenwich","Bangor","Dundee"]}],"minimumScoresTable":[{"country":"United Kingdom","university":"Coventry University","courseLevel":"MSc International Business","minimumScore":"Level 7","competitiveScore":"Level 8","recommendedScore":"Level 8","scholarshipScore":"Level 8"}],"examPattern":[{"moduleName":"Reading","duration":"40 Mins","numQuestions":"2 Texts","description":"Online reading comprehension."},{"moduleName":"Listening","duration":"25 Mins","numQuestions":"2 Audio Tracks","description":"Online listening tasks."},{"moduleName":"Writing","duration":"60 Mins","numQuestions":"1 Essay (250-350 words)","description":"Academic discursive writing."},{"moduleName":"Speaking","duration":"15 Mins","numQuestions":"Live 1-on-1 Video Interview","description":"Spoken discussion on writing submission and unseen topic."}],"moduleDetails":[{"moduleName":"Oxford ELLT Modules","purpose":"Assesses CEFR level from B1 to C2.","timeLimit":"Modular","questionTypes":["Reading","Listening","Writing","Speaking"],"markingCriteria":["CEFR Mapping"],"proTips":["Be ready to discuss your writing essay in the live speaking test."],"commonMistakes":["Not preparing for speaking questions about your essay."]}],"formatComparison":[{"feature":"Delivery","paperFormat":"N/A","computerFormat":"Test Centre Available","homeOnlineFormat":"Oxford ELLT Portal Online"}],"scoringSystem":[{"scoreBand":"Level 7 - 8","cefrLevel":"B2/C1 (IELTS 6.5 - 7.0)","gradeDescription":"Degree Ready","uniAcceptance":"UK Partner Universities","visaAcceptance":"Full UKVI Degree CAS"}],"countryFees":[{"country":"Bangladesh","currencyFee":"£120 GBP","bdtEquivalent":"BDT 18,500"}],"bookingProcess":[{"step":1,"title":"Register on Oxford ELLT","desc":"Create student account."},{"step":2,"title":"Purchase Token","desc":"Buy test portal license."},{"step":3,"title":"Complete Modules","desc":"Complete R/L/W and book live speaking session."}],"requiredDocs":["Valid Passport"],"testDayGuide":{"beforeArrival":["Check web camera."],"checkInRules":["Show passport on camera."],"duringExam":["No outside assistance."],"afterExam":["Certificate in 48 hours."]},"prepTimelines":[{"duration":"2-3 Weeks","targetStudentProfile":"Targeting Level 7+","focusAreas":["Essay defense","Speaking fluency"],"dailyHours":"2 Hours"}],"studyPlan":[{"period":"Week 1-2","listening":"Academic tracks","reading":"Text skimming","writing":"250-word essays","speaking":"Live interview practice","vocabGrammar":"Topic vocabulary"}],"commonMistakes":[{"category":"Speaking","mistake":"Forgetting what was written in the writing task during the speaking interview.","solution":"Review your essay before the speaking test."}],"expertTips":[{"area":"Speaking","tip":"The examiner will ask specific follow-up questions about your writing submission."}],"successStories":[{"studentName":"Zahidul Karim","country":"United Kingdom","flag":"🇬🇧","university":"University of Greenwich","course":"MBA","achievedScore":"Level 7 (IELTS 6.5 equivalent)","requiredScore":"Level 7","visaStatus":"UK Visa Approved"}],"faqs":[{"question":"Is Oxford ELLT accepted for UK student visas?","answer":"Yes, when accepted by your UK university with degree-awarding powers for CAS issuance."},{"question":"What score is Level 7?","answer":"Level 7 corresponds to IELTS 6.5 overall (CEFR B2/C1)."}],"seoArticle":{"title":"Oxford ELLT (OIETC) Guide 2026","content":"Complete overview of the Oxford ELLT test structure and preparation..."}}}]
