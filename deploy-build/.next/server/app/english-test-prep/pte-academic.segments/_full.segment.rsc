7:["$","$L12",null,{"test":{"id":"test-pte","slug":"pte-academic","name":"PTE Academic","shortName":"PTE","officialOwner":"Pearson Education Ltd","logoBadge":"🇦🇺 🇬🇧 🇳🇿 🇨🇦 Pearson Official","heroTitle":"PTE Academic Preparation & Fast Score Masterclass","heroSubtitle":"Master Pearson's 2-hour computer-delivered test with 100% AI objective scoring and results delivered in typically 48 hours.","expectedScore":"Score 58 - 68+ Overall (Min 50-58 communicative skills)","quickFacts":[{"label":"Official Owner","value":"Pearson PLC"},{"label":"Test Duration","value":"2 Hours Single Session"},{"label":"Score Scale","value":"10 to 90 Points"},{"label":"Validity","value":"2 Years from Test Date"},{"label":"Test Fee in BD","value":"BDT 22,000 - 23,000 ($200 USD)"},{"label":"Global Recognition","value":"3,300+ Universities, 100% Australia/NZ Visa"}],"overview":{"whatIsIt":"PTE Academic is a computer-based English language test trusted by universities, colleges and governments around the world.","whoAcceptsIt":"100% of Australian and New Zealand universities and visa routes, 99% of UK universities, top Canadian DLIs, and growing US institutions.","whyUniversitiesRequireIt":"Fast, unbiased AI evaluation of academic speaking, writing, reading, and listening capability.","whyVisaOfficesRequireIt":"Approved by the Australian Department of Home Affairs, UK Home Office, and New Zealand Immigration.","globalRecognition":"Accepted by Harvard Business School, INSEAD, Oxford, Yale, and 3,300+ global institutions.","history":"Launched in 2009 by Pearson as the first fully automated AI-scored academic English test.","purpose":"Assess integrated communicative skills in a modern 2-hour computer session."},"quickInfo":{"duration":"2 Hours","resultTime":"Typically 48 Hours (often within 24 hours)","scoreScale":"10 to 90 Global Scale of English","cost":"BDT 22,000 - 23,000","validity":"2 Years","format":"100% Computer-delivered at Pearson VUE test centres","acceptedCountries":["Australia","United Kingdom","New Zealand","Canada","United States","Ireland","Germany"],"officialWebsite":"https://www.pearsonpte.com","bestFor":"Students wanting fast results, AI objective scoring, and targeting Australia/UK/Canada.","difficultyLevel":"Moderate (High focus on typing and mic clarity)"},"whyChoose":{"advantages":["Ultra-fast results in as little as 48 hours.","100% AI objective scoring with zero human examiner bias.","Single 2-hour continuous test session including speaking on headset.","Unlimited free score reports sent electronically to universities."],"disadvantages":["Integrated scoring tasks (e.g. Read Aloud affects both Speaking and Reading).","Microphone sensitivity requires clear articulation in test room."],"whoShouldTake":["Students targeting Australia, UK, Canada, and New Zealand universities.","Applicants who prefer typing over handwriting essays."],"whoShouldAvoid":["Students with severe speech dysfluency or heavy typing anxiety."],"careerValue":"Recognized by global professional bodies including Australian Nursing and Engineers Australia.","visaValue":"100% accepted for Australian Subclass 500 and UK Student visas.","scholarshipValue":"Accepted for all major international merit scholarships."},"countriesAccepting":[{"country":"Australia","flag":"🇦🇺","acceptanceRate":"100%","visaRule":"100% accepted by Australian DHA for all visa subclasses.","universityRule":"Score 58 - 65 for direct entry.","profRegRule":"Accepted by all Australian professional boards."},{"country":"United Kingdom","flag":"🇬🇧","acceptanceRate":"99%","visaRule":"Accepted by 99% of UK universities sponsoring Student Route visas.","universityRule":"Score 58 - 68 for degree courses.","profRegRule":"Accepted for UK professional registrations."},{"country":"Canada","flag":"🇨🇦","acceptanceRate":"95%","visaRule":"Approved for SDS and regular Study Permits.","universityRule":"Score 60+ accepted across DLIs.","profRegRule":"Accepted across provincial licensing."},{"country":"New Zealand","flag":"🇳🇿","acceptanceRate":"100%","visaRule":"100% accepted by Immigration New Zealand.","universityRule":"Score 58+ standard.","profRegRule":"Accepted by NZ boards."}],"universitiesAccepting":[{"tier":"Top Universities","typicalScore":"Score 65 - 73","foundationScore":"46","ugScore":"58","mastersScore":"65","mbaScore":"68","phdScore":"68","scholarshipScore":"73+","examples":["Melbourne","Sydney","UNSW","Warwick","King's College London"]}],"minimumScoresTable":[{"country":"Australia","university":"UNSW Sydney","courseLevel":"Master of IT","minimumScore":"65 (54 each)","competitiveScore":"70","recommendedScore":"70","scholarshipScore":"75"},{"country":"United Kingdom","university":"University of Bristol","courseLevel":"BSc Economics","minimumScore":"66 (60 each)","competitiveScore":"70","recommendedScore":"70","scholarshipScore":"75"}],"examPattern":[{"moduleName":"Speaking & Writing","duration":"54 - 67 Minutes","numQuestions":"Personal Intro, Read Aloud, Repeat Sentence, Describe Image, Re-tell Lecture, Answer Short Question, Summarize Written Text, Essay (20 mins)","description":"Assesses spoken fluency, pronunciation, text summarization, and academic essay composition."},{"moduleName":"Reading","duration":"29 - 30 Minutes","numQuestions":"Fill in Blanks (R&W), Multiple Choice, Re-order Paragraphs, Fill in Blanks (Reading)","description":"Academic reading comprehension and contextual vocabulary selection."},{"moduleName":"Listening","duration":"30 - 43 Minutes","numQuestions":"Summarize Spoken Text, Multiple Choice, Fill in Blanks, Highlight Correct Summary, Select Missing Word, Highlight Incorrect Words, Write from Dictation","description":"Audio comprehension, note-taking, and sentence transcription."}],"moduleDetails":[{"moduleName":"Speaking & Writing","purpose":"Integrated AI assessment of oral fluency, phoneme accuracy, grammar and structure.","timeLimit":"54-67 Mins","questionTypes":["Read Aloud","Repeat Sentence","Describe Image","Write Essay"],"markingCriteria":["Content","Oral Fluency","Pronunciation","Grammar","Vocabulary"],"proTips":["Maintain steady pace without pausing for more than 3 seconds.","Speak clearly directly into microphone."],"commonMistakes":["Hesitation / filler words ('um', 'ah')","Over-complicating essay vocabulary"]},{"moduleName":"Reading","purpose":"Assesses academic reading analysis, collocation awareness, and paragraph coherence.","timeLimit":"29-30 Mins","questionTypes":["Fill in the Blanks","Re-order Paragraphs"],"markingCriteria":["1 mark per correct blank/pair"],"proTips":["Focus heavily on grammatical collocations (prepositions, verb tenses)."],"commonMistakes":["Spending too long on difficult multiple-choice questions"]},{"moduleName":"Listening","purpose":"Evaluates ability to comprehend lectures, discussions and transcribe spoken English accurately.","timeLimit":"30-43 Mins","questionTypes":["Write from Dictation","Summarize Spoken Text"],"markingCriteria":["Word count accuracy","Spelling","Punctuation"],"proTips":["Write from Dictation carries huge marks; reserve at least 5-6 mins for it."],"commonMistakes":["Spelling errors in Write from Dictation"]}],"formatComparison":[{"feature":"Test Mode","paperFormat":"N/A","computerFormat":"100% Computer Pearson VUE","homeOnlineFormat":"PTE Academic Online (Home)"}],"scoringSystem":[{"scoreBand":"79 - 90 Points","cefrLevel":"C2 (IELTS 8.0 - 9.0)","gradeDescription":"Expert User","uniAcceptance":"All Tier 1 Universities","visaAcceptance":"Maximum Migration Points"},{"scoreBand":"65 - 78 Points","cefrLevel":"C1 (IELTS 7.0 - 7.5)","gradeDescription":"Very Good User","uniAcceptance":"Top Russell Group / G8","visaAcceptance":"Full Visa Compliant"},{"scoreBand":"58 - 64 Points","cefrLevel":"B2+ (IELTS 6.5)","gradeDescription":"Competent User","uniAcceptance":"Standard Degree Entry","visaAcceptance":"Full Visa Compliant"},{"scoreBand":"50 - 57 Points","cefrLevel":"B2 (IELTS 6.0)","gradeDescription":"Modest User","uniAcceptance":"Foundation / Pathway Entry","visaAcceptance":"Full Visa Compliant"}],"countryFees":[{"country":"Bangladesh","currencyFee":"$$200 USD (BDT 22,500)","bdtEquivalent":"BDT 22,500"}],"bookingProcess":[{"step":1,"title":"Create myPTE Account","desc":"Sign up at pearsonpte.com."},{"step":2,"title":"Choose Test Centre","desc":"Select authorized Pearson test centres in Dhaka or Sylhet."},{"step":3,"title":"Schedule & Pay","desc":"Select date and pay fee with international debit/credit card."}],"requiredDocs":["Original Valid International Passport"],"testDayGuide":{"beforeArrival":["Arrive 30 mins early with passport."],"checkInRules":["Palm vein scan and digital signature check."],"duringExam":["Test mic position before starting."],"afterExam":["Receive email notification within 48 hours to view score."]},"prepTimelines":[{"duration":"3-4 Weeks","targetStudentProfile":"Targeting 65+ Score","focusAreas":["Write from Dictation","Repeat Sentence","Read Aloud"],"dailyHours":"2-3 Hours"}],"studyPlan":[{"period":"Week 1-3","listening":"Write from Dictation drills","reading":"Collocation blanks","writing":"Essay templates","speaking":"Read aloud & describe image","vocabGrammar":"Academic word lists"}],"commonMistakes":[{"category":"Speaking","mistake":"Pausing for more than 3 seconds causes mic to close automatically.","solution":"Keep speaking smoothly and never pause mid-sentence."}],"expertTips":[{"area":"Listening","tip":"Write from Dictation contributes massive marks to both Listening and Writing."}],"successStories":[{"studentName":"Tanzim Ahmed","country":"Australia","flag":"🇦🇺","university":"Monash University","course":"Master of Banking & Finance","achievedScore":"PTE 72 Overall","requiredScore":"PTE 65","visaStatus":"Subclass 500 Granted"}],"faqs":[{"question":"Is PTE Academic accepted for Australia student visas?","answer":"Yes, 100% of Australian universities and the Department of Home Affairs accept PTE Academic."},{"question":"How quickly are PTE results released?","answer":"Typically within 