"Australia","Germany","France","Japan"],"officialWebsite":"https://www.ets.org/toefl","bestFor":"Students applying to USA and Canada universities.","difficultyLevel":"Challenging academic passages"},"whyChoose":{"advantages":["Gold standard for United States and top North American universities.","Shortened 2-hour modern test format with Writing for an Academic Discussion.","MyBest Scores feature combines highest section scores from all valid tests."],"disadvantages":["Heavy academic vocabulary and integrated lecture listening tasks.","Strict timer per section."],"whoShouldTake":["Students targeting USA universities, Ivy League, and STEM graduate programs."],"whoShouldAvoid":["Students targeting purely Australian vocational training pathways."],"careerValue":"Global recognition across multinational corporations and research institutes.","visaValue":"Accepted for US F-1 visa I-20 issuance and Canadian study permits.","scholarshipValue":"Standard prerequisite for Fulbright and US university assistantships."},"countriesAccepting":[{"country":"United States","flag":"🇺🇸","acceptanceRate":"100%","visaRule":"Universally accepted for Form I-20 and F-1 visa.","universityRule":"Score 80 (Undergrad) to 100+ (Graduate).","profRegRule":"Accepted by US licensing boards."},{"country":"Canada","flag":"🇨🇦","acceptanceRate":"98%","visaRule":"Accepted for Canadian study permit processing.","universityRule":"Score 88 - 100 across U15.","profRegRule":"Accepted provincially."}],"universitiesAccepting":[{"tier":"US Top Tier","typicalScore":"90 - 105+","foundationScore":"65","ugScore":"80","mastersScore":"90 - 100","mbaScore":"100","phdScore":"100","scholarshipScore":"105+","examples":["MIT","Stanford","Harvard","Columbia","NYU"]}],"minimumScoresTable":[{"country":"United States","university":"New York University","courseLevel":"Master of Science","minimumScore":"100 (22 each)","competitiveScore":"105","recommendedScore":"105","scholarshipScore":"110"}],"examPattern":[{"moduleName":"Reading","duration":"35 Minutes","numQuestions":"20 Questions (2 Passages)","description":"Academic texts evaluating inference, vocabulary, and main idea."},{"moduleName":"Listening","duration":"36 Minutes","numQuestions":"28 Questions (3 Lectures, 2 Conversations)","description":"University classroom discussions and lectures."},{"moduleName":"Speaking","duration":"16 Minutes","numQuestions":"4 Tasks","description":"1 Independent task + 3 Integrated tasks (read/listen/speak)."},{"moduleName":"Writing","duration":"29 Minutes","numQuestions":"2 Tasks","description":"Integrated Task (20 mins) + Writing for an Academic Discussion (10 mins)."}],"moduleDetails":[{"moduleName":"All 4 Sections","purpose":"Comprehensive academic English evaluation.","timeLimit":"1h 56m","questionTypes":["Reading","Listening","Speaking","Writing"],"markingCriteria":["0-30 scaled score per section"],"proTips":["Take structured notes during listening lectures."],"commonMistakes":["Running out of time on reading passages."]}],"formatComparison":[{"feature":"Mode","paperFormat":"N/A","computerFormat":"ETS Test Centre PC","homeOnlineFormat":"TOEFL iBT Home Edition"}],"scoringSystem":[{"scoreBand":"100 - 120","cefrLevel":"C1/C2 Advanced","gradeDescription":"Proficient Academic English","uniAcceptance":"Ivy League & Top 50 Global","visaAcceptance":"Full Visa Compliant"},{"scoreBand":"80 - 99","cefrLevel":"B2/C1 Competent","gradeDescription":"Standard Academic Level","uniAcceptance":"All Standard US Universities","visaAcceptance":"Full Visa Compliant"}],"countryFees":[{"country":"Bangladesh","currencyFee":"$$195 USD","bdtEquivalent":"BDT 23,000"}],"bookingProcess":[{"step":1,"title":"Create ETS Account","desc":"Register on ets.org/toefl."},{"step":2,"title":"Select Test Date & Centre","desc":"Choose test centre in Dhaka/Chittagong."},{"step":3,"title":"Pay Fee","desc":"Pay $195 with international card."}],"requiredDocs":["Original Valid International Passport"],"testDayGuide":{"beforeArrival":["Arrive 30 mins before scheduled time."],"checkInRules":["Photo ID check and digital voice sample."],"duringExam":["Use provided scratch paper for notes."],"afterExam":["Unofficial Reading/Listening scores shown on screen immediately."]},"prepTimelines":[{"duration":"1-2 Months","targetStudentProfile":"Targeting 90-100+","focusAreas":["Lecture note taking","Discussion writing"],"dailyHours":"2-3 Hours"}],"studyPlan":[{"period":"Week 1-4","listening":"Academic lectures","reading":"Complex passages","writing":"Academic discussion","speaking":"Integrated tasks","vocabGrammar":"TOEFL vocabulary"}],"commonMistakes":[{"category":"Speaking","mistake":"Not finishing speech within 45/60 second time limit.","solution":"Practice with a countdown timer."}],"expertTips":[{"area":"Writing","tip":"In Writing for an Academic Discussion, state your point clearly and add a new perspective."}],"successStories":[{"studentName":"Rayan Chowdhury","country":"United States","flag":"🇺🇸","university":"Purdue University","course":"BSc Mechanical Engineering","achievedScore":"104 (R28, L27, S24, W25)","requiredScore":"88","visaStatus":"F-1 Visa Granted"}],"faqs":[{"question":"Is TOEFL iBT accepted in the UK?","answer":"Yes, 100% of UK universities accept TOEFL iBT for degree-level courses."},{"question":"What are MyBest Scores?","answer":"MyBest scores combine your highest section scores from all test dates in the previous 2 years."}],"seoArticle":{"title":"TOEFL iBT Strategy Guide 2026","content":"Master the 2-hour TOEFL iBT with proven academic strategies..."}}}],null,"$L3"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"-vqd6LRgMzstdVGtzj8DZ"}
