{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/partner/layout,_N_T_/partner/applications/layout,_N_T_/partner/applications/page,_N_T_/partner/applications"
  },
  "segmentPaths": [
