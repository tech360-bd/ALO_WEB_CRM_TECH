{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/destinations/layout,_N_T_/destinations/[slug]/layout,_N_T_/destinations/[slug]/page,_N_T_/destinations/dubai"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/destinations/$d$slug/__PAGE__",
    "/destinations/$d$slug",
    "/destinations",
    "/_index",
    "/_head"
  ]
}