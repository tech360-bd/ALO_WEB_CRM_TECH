    "tests/unit/student-documents-versioning.test.ts",
    "src/app/api/crm/documents/verification-queue/route.ts",
    "src/app/api/crm/documents/dashboard/route.ts",
    "src/app/api/counselor/documents/upload-on-behalf/route.ts",
