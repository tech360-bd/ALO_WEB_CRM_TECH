{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "incremental": false
  },
  "include": [
    "src/lib/documents/**/*.ts",
    "src/app/api/crm/documents/**/*.ts",
    "src/app/api/counselor/documents/**/*.ts",
    "src/app/api/partner/documents/**/*.ts",
    "src/app/api/student/documents/**/*.ts",
