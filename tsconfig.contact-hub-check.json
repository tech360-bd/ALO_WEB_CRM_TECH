    "src/app/crm/campaign-approval/page.tsx",
    "src/components/contacts/contact-hub-view.tsx",
    "src/components/marketing/marketing-command-center-compat.tsx",
    "src/lib/permissions.ts",
    "src/proxy.ts",
    "next.config.ts"
