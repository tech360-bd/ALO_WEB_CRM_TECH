# ALO Education — Production .htaccess (Apache / LiteSpeed)
# Path A: Next.js standalone behind Apache proxy (cPanel)
# Canonical: https://aloeducation.com (non-www, HTTPS enforced)
# Private app: /home/aloeduca/alo-web-crm (outside public_html)
# Generated: 2026-09-15T16:50:00Z (verified 2026-09-15 GCU London 560/11200/145600)

# --- Front-controller: proxy to Node standalone ---
# If Node is available via cPanel "Setup Node.js App", proxy all to 3000
# Alternative: if using static export, serve from public_html/_next

RewriteEngine On
RewriteBase /

# 1. HTTPS enforcement
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 2. Canonical non-www (remove www)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# 3. Authorization header forwarding (for API auth)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# 4. Proxy to Node (requires mod_proxy) — if Node app on 3000
# Uncomment if using Node standalone:
# RewriteCond %{REQUEST_FILENAME} !-f
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
# ProxyPassReverse / http://127.0.0.1:3000/

# 5. Directory listing OFF
Options -Indexes

# 6. Block hidden files/dirs (.env, .git, .htaccess)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
RedirectMatch 403 ^/\.git/.*
RedirectMatch 403 ^/\.env.*

# 7. Block sensitive extensions
<FilesMatch "\.(env|sql|log|sh|bak|backup|swp|ini|conf|config)$">
  Require all denied
</FilesMatch>
# Block Composer/config/SQL/backup/log files
RewriteRule ^(composer\.(json|lock)|package-lock\.json|yarn\.lock)$ - [F,L]
RewriteRule ^(.*\.(sql|bak|backup|log|env|config\.js))$ - [F,L]

# 8. Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HSTS (enable after SSL verified)
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# 9. Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# 10. Browser caching (static assets)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/json "access plus 1 month"
  ExpiresDefault "access plus 2 days"
</IfModule>

# 11. Custom error docs (no stack leak)
ErrorDocument 403 /errors/403.html
ErrorDocument 404 /errors/404.html
ErrorDocument 500 /errors/500.html

# 12. Prevent rewrite loops — already handled by !-f/!-d above
# Static assets served directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Fallback to Next.js (if not proxied, serve index)
# For static export: RewriteRule ^ index.html [L]
