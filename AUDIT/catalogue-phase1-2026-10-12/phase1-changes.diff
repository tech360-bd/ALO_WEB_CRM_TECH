+  it('POST rejects client-set verification/attribution, bad URLs, bad types and cross-origin', async () => {
+    const base = { entityType: 'course', entityId: 'C1', sourceUrl: 'https://www.uni-a.ac.uk/x' };
+    for (const body of [
+      { ...base, verificationStatus: 'verified' },
+      { ...base, checkedBy: 'super-admin' },
+      { ...base, sourceUrl: 'http://www.uni-a.ac.uk/x' },
+      { ...base, sourceUrl: 'https://fake.example.com/x' },
+      { ...base, entityType: 'student' },
+      { ...base, entityId: { not: '' } },
+      { ...base, sourceType: 'Aggregator' },
+    ]) {
+      expect((await sourceLogsPOST(req('/api/source-logs', 'POST', body))).status, JSON.stringify(body)).toBe(400);
+    }
+    expect((await sourceLogsPOST(req('/api/source-logs', 'POST', base, 'https://attacker.test'))).status).toBe(403);
+    expect(writes()).toHaveLength(0);
+  });
+
+  it('data-quality GET is admin-only and performs no writes; persisting is an explicit POST', async () => {
+    for (const who of [student, partner, marketing]) {
+      m.auth.mockResolvedValue(who);
+      expect((await dataQualityGET(req('/api/data-quality?entityType=course&entityId=C1'))).status).toBe(403);
+    }
+    m.auth.mockResolvedValue(admin);
+    const res = await dataQualityGET(req('/api/data-quality?entityType=course&entityId=C1'));
+    expect(res.status).toBe(200);
+    expect(await res.json()).toMatchObject({ persisted: false });
+    expect(writes()).toHaveLength(0);
+
+    expect((await dataQualityPOST(req('/api/data-quality', 'POST', { entityType: 'course', entityId: 'C1' }, 'https://attacker.test'))).status).toBe(403);
+    expect(writes()).toHaveLength(0);
+    const post = await dataQualityPOST(req('/api/data-quality', 'POST', { entityType: 'course', entityId: 'C1' }));
+    expect(post.status).toBe(200);
+    expect(m.calls.filter((c) => c.op === 'dataQualityScore.upsert')).toHaveLength(1);
+    expect((await dataQualityPOST(req('/api/data-quality', 'POST', { entityType: 'student', entityId: 'C1' }))).status).toBe(400);
+  });
+
+  it('error responses do not leak driver messages', async () => {
+    (m.db.dataQualityScore.findMany as any).mockImplementationOnce(() => { throw new Error('mysql://user:password@host'); });
+    const res = await dataQualityGET(req('/api/data-quality'));
+    expect(res.status).toBe(500);
+    expect(await res.text()).not.toContain('secret');
+  });
+});
+
+describe('content-page guards', () => {
+  it('accepts only https, credential-free, non-synthetic source URLs', () => {
+    expect(isAcceptableSourceUrl('https://www.auckland.ac.nz/en/study.html')).toBe(true);
+    for (const bad of ['http://www.auckland.ac.nz', 'https://user:pw@www.auckland.ac.nz', 'https://localhost/x', 'https://x.example.org', 'https://site.test', 'ftp://a.b', 'not a url', '', null, 42]) {
+      expect(isAcceptableSourceUrl(bad as any), String(bad)).toBe(false);
+    }
+  });
+  it('drops unknown keys and never passes control fields through', () => {
+    const r = sanitizeCoursePageFields({ overview: 'x', verificationStatus: 'VERIFIED', approvalStatus: 'PUBLISHED', lastVerifiedAt: 'now', id: 'z', extra: 1 });
+    expect(r).toEqual({ ok: true, data: { overview: 'x' } });
+  });
+});
diff --git a/tests/unit/catalogue-phase1-real-auth.test.ts b/tests/unit/catalogue-phase1-real-auth.test.ts
new file mode 100644
index 00000000..b4593a3a
--- /dev/null
+++ b/tests/unit/catalogue-phase1-real-auth.test.ts
@@ -0,0 +1,56 @@
+/**
+ * Catalogue Phase 1 (2026-10-12): unauthenticated requests against the REAL
+ * auth middleware. Only `@/lib/db` and `next-auth` are mocked, so this proves
+ * the handlers themselves refuse anonymous and forged-bearer callers before
+ * any catalogue read or write, independent of the proxy.
+ */
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+const h = vi.hoisted(() => {
+  const calls: string[] = [];
+  const any = (name: string) => new Proxy({}, {
+    get: (_t, op: string) => (..._args: unknown[]) => { calls.push(`${name}.${op}`); return Promise.resolve(op.startsWith('findMany') ? [] : null); },
+  });
+  const db = new Proxy({}, { get: (_t, model: string) => any(model) });
+  return { calls, db };
+});
+
+vi.mock('@/lib/db', () => ({ db: h.db }));
+vi.mock('next-auth', () => ({ getServerSession: vi.fn(() => Promise.resolve(null)), NextAuth: vi.fn() }));
+
+import { NextRequest } from 'next/server';
+import { GET as downloadErrors } from '@/app/api/crm/course-import/download-errors/route';
+import { GET as sourceLogsGET, POST as sourceLogsPOST } from '@/app/api/source-logs/route';
+import { GET as dataQualityGET, POST as dataQualityPOST } from '@/app/api/data-quality/route';
+import { PATCH as importCenterPATCH } from '@/app/api/import-center/route';
+import { POST as cfaPOST, PATCH as cfaPATCH } from '@/app/api/course-finder/admin/route';
+
+const CATALOGUE_TABLES = /^(crmImportError|sourceLog|officialSource|dataQualityScore|crmCourse|crmUniversity|coursePage|universityPage|countryPage|examPage|auditLog)\./;
+
+beforeEach(() => { h.calls.length = 0; });
+
+describe('catalogue handlers refuse unauthenticated callers with the real auth middleware', () => {
+  const cases: Array<[string, () => Promise<Response>]> = [
+    ['download-errors GET', () => downloadErrors(new NextRequest('https://alo.test/api/crm/course-import/download-errors?batchId=b1') as never)],
+    ['source-logs GET', () => sourceLogsGET(new NextRequest('https://alo.test/api/source-logs'))],
+    ['source-logs POST', () => sourceLogsPOST(new NextRequest('https://alo.test/api/source-logs', { method: 'POST', body: '{"entityType":"course","entityId":"C1","sourceUrl":"https://u.ac.uk"}' }))],
+    ['data-quality GET', () => dataQualityGET(new NextRequest('https://alo.test/api/data-quality?entityId=C1'))],
+    ['data-quality POST', () => dataQualityPOST(new NextRequest('https://alo.test/api/data-quality', { method: 'POST', body: '{"entityId":"C1"}' }))],
+    ['import-center PATCH', () => importCenterPATCH(new NextRequest('https://alo.test/api/import-center', { method: 'PATCH', body: '{"type":"course","slug":"x","action":"publish"}' }))],
+    ['course-finder/admin POST', () => cfaPOST(new NextRequest('https://alo.test/api/course-finder/admin', { method: 'POST', body: '{}' }) as never)],
+    ['course-finder/admin PATCH', () => cfaPATCH(new NextRequest('https://alo.test/api/course-finder/admin', { method: 'PATCH', body: '{"id":"x"}' }) as never)],
+  ];
+  for (const [name, call] of cases) {
+    it(`${name}: 401 and no catalogue access`, async () => {
+      const res = await call();
+      expect(res.status).toBe(401);
+      expect(h.calls.filter((c) => CATALOGUE_TABLES.test(c))).toEqual([]);
+    });
+  }
+
+  it('a forged bearer token is also refused before catalogue access', async () => {
+    const res = await downloadErrors(new NextRequest('https://alo.test/api/crm/course-import/download-errors?batchId=b1', { headers: { authorization: 'Bearer forged' } }) as never);
+    expect(res.status).toBe(401);
+    expect(h.calls.filter((c) => CATALOGUE_TABLES.test(c))).toEqual([]);
+  });
+});
diff --git a/tests/unit/catalogue-phase1-proxy.test.ts b/tests/unit/catalogue-phase1-proxy.test.ts
