  permission PortalPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model PortalUserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
