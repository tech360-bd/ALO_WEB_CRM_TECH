model StudentRecommendation {
  id              String   @id @default(cuid())
  studentId       String
  refereeName     String   @default("")
  refereePosition String   @default("")
  refereeEmail    String   @default("")
  refereeOrg      String   @default("")
  letterUrl       String   @default("")
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model StudentVisaHistory {
  id            String   @id @default(cuid())
  studentId     String
  country       String   @default("")
  visaType      String   @default("")
  status        String   @default("")
