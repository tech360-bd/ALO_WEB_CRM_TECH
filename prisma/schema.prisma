  aiGenerated    Boolean  @default(false)
  aiApproved     Boolean  @default(true)
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())

  conversation UccConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  UccAttachment[]
}

model UccAttachment {
  id               String   @id @default(cuid())
