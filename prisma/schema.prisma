model CvReview {
  id        String   @id @default(cuid())
  studentId String
  cvUrl     String   @default("")
  content   String   @default("")
  feedback  String   @default("")
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EnglishTest {
  id          String   @id @default(cuid())
  name        String
  type        String
  description String   @default("")
  duration    Int      @default(120)
  sections    String   @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MockTest {
  id        String   @id @default(cuid())
  name      String
  testType  String
  isFree    Boolean  @default(false)
  price     Float    @default(0)
  duration  Int      @default(120)
  sections  String   @default("[]")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestSession {
  id          String    @id @default(cuid())
  studentId   String
  testId      String
  mockTestId  String?
  testType    String
  status      String    @default("in_progress")
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  duration    Int       @default(0)
  createdAt   DateTime  @default(now())
}

model TestAnswer {
  id          String   @id @default(cuid())
  sessionId   String
  section     String
  questionNum Int
  answer      String   @default("")
  isCorrect   Boolean  @default(false)
  score       Float    @default(0)
  createdAt   DateTime @default(now())
}

model TestResult {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  listeningScore Float    @default(0)
  readingScore   Float    @default(0)
  writingScore   Float    @default(0)
  speakingScore  Float    @default(0)
  overallScore   Float    @default(0)
  bandEstimate   String   @default("")
  weakAreas      String   @default("[]")
  strengths      String   @default("[]")
  aiFeedback     String   @default("")
  createdAt      DateTime @default(now())
}

model AiExamFeedback {
  id              String   @id @default(cuid())
  sessionId       String   @unique
  taskAchievement String   @default("")
  coherence       String   @default("")
  lexicalResource String   @default("")
  grammar         String   @default("")
  improvementPlan String   @default("")
  createdAt       DateTime @default(now())
}

model AiInterviewSession {
  id             String    @id @default(cuid())
  studentId      String
  interviewType  String
  status         String    @default("in_progress")
  readinessScore Float     @default(0)
  riskLevel      String    @default("needs_practice")
  transcript     String    @default("[]")
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
