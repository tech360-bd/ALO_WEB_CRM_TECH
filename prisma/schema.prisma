}

model StudentVisaHistory {
  id            String   @id @default(cuid())
  studentId     String
  country       String   @default("")
  visaType      String   @default("")
  status        String   @default("")
  refusalReason String   @default("")
  appliedDate   String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model StudentFunding {
  id               String   @id @default(cuid())
  studentId        String
  fundingType      String   @default("self")
  sponsorName      String   @default("")
  sponsorRelation  String   @default("")
  sponsorIncome    String   @default("")
  sponsorBank      String   @default("")
  bankStatementUrl String   @default("")
  sponsorDocUrl    String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model StudentAdmissionPreference {
  id               String   @id @default(cuid())
  studentId        String
  preferredCountry String   @default("")
  preferredCourse  String   @default("")
  preferredLevel   String   @default("")
  preferredIntake  String   @default("")
  budgetRange      String   @default("")
  scholarshipNeed  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Application {
  id                   String    @id @default(cuid())
  applicationCode      String    @unique @default(cuid())
  studentId            String
  partnerId            String?   @default("")
  counselorId          String    @default("")
  counselorName        String    @default("")
  applicationOfficer   String    @default("")
  appTeamOfficerId     String?   @default("")
  visaOfficerId        String    @default("")
  universityId         String?   @default("")
  universityName       String    @default("")
  courseId             String?   @default("")
  courseName           String    @default("")
  campusId             String?   @default("")
  country              String    @default("")
  intake               String    @default("")
  intakeId             String?   @default("")
  level                String    @default("")
  applicationId        String    @default("")
  // Source normalization
  applicationSource    String    @default("DIRECT_ALO_APPLICATION") // DIRECT_ALO_APPLICATION, STUDENT_SELF_APPLICATION, PARTNER_APPLICATION, B2B_INBOUND_APPLICATION, B2B_OUTBOUND_APPLICATION, UNIVERSITY_DIRECT_PORTAL, MANUAL_IMPORT, REFERRAL, EVENT_SEMINAR_LEAD, WEBSITE_COURSE_FINDER_LEAD
  sourceVisibility     String    @default("public_safe")
  isB2b                Boolean   @default(false)
  isB2bConfidential    Boolean   @default(false)
  b2bType              String?   @default("") // B2B_INBOUND, B2B_OUTBOUND
  b2bProviderId        String?   @default("")
  // Pipeline
  stage                String    @default("APPLICATION_DRAFT") // APPLICATION_DRAFT, PROFILE_REVIEW, DOCUMENT_REVIEW, READY_TO_SUBMIT, SUBMITTED_TO_ALO_APPLICATION_TEAM, SUBMITTED_TO_B2B, SUBMITTED_TO_UNIVERSITY, ACKNOWLEDGEMENT_RECEIVED, DECISION_PENDING, MORE_DOCUMENTS_REQUESTED, INTERVIEW_REQUIRED, CONDITIONAL_OFFER, UNCONDITIONAL_OFFER, REJECTED, DEFERRED, WITHDRAWN, DEPOSIT_PENDING, DEPOSIT_PAID, CAS_PENDING, CAS_RECEIVED, I20_PENDING, I20_RECEIVED, COE_PENDING, COE_RECEIVED, VISA_HANDOVER_READY, VISA_FILE_CREATED, CLOSED
  safeStatus           String    @default("DRAFT") // DRAFT, UNDER_REVIEW, DOCUMENTS_REQUIRED, SUBMITTED, DECISION_PENDING, OFFER_RECEIVED, REJECTED, DEFERRED, VISA_PREPARATION
  reviewStatus         String    @default("PENDING") // PENDING, APPROVED, REJECTED, NEEDS_MORE_INFO
  documentStatus       String    @default("PENDING") // PENDING, COMPLETE, INCOMPLETE, UNDER_REVIEW, VERIFIED
  paymentStatus        String    @default("PENDING") // PENDING, PAID, PARTIAL, OVERDUE
  offerStatus          String    @default("PENDING") // PENDING, CONDITIONAL_OFFER, UNCONDITIONAL_OFFER, REJECTED, DEFERRED, WITHDRAWN
  casI20CoeStatus      String    @default("NOT_STARTED") // NOT_STARTED, PENDING, RECEIVED, etc
  visaHandoverStatus   String    @default("NOT_READY") // NOT_READY, READY, HANDOVER_COMPLETE, VISA_FILE_CREATED
  status               String    @default("active")
  deadline             String    @default("")
  deadlineDate         DateTime?
  // Finance
  applicationFeeStatus String    @default("PENDING")
  depositStatus        String    @default("PENDING")
  // SLA
  slaStatus            String    @default("ON_TRACK") // ON_TRACK, DUE_TODAY, DUE_IN_3_DAYS, DUE_IN_7_DAYS, OVERDUE
  // Audit
  createdBy            String?   @default("")
  updatedBy            String?   @default("")
  notes                String    @default(dbgenerated("(_utf8mb4'')")) @db.Text
  internalNotes        String    @default(dbgenerated("(_utf8mb4'')")) @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  b2bApplications B2bApplication[]
  statusLogs      ApplicationStatusLog[]
  comments        ApplicationComment[]
  documents       ApplicationDocument[]
  deadlines       ApplicationDeadline[]
  tasks           ApplicationTask[]
  notifications   ApplicationNotification[]
  offer           ApplicationOffer?
  casI20Coe       ApplicationCasI20Coe?
  finance         ApplicationFinance?

  @@index([studentId])
  @@index([partnerId])
  @@index([counselorId])
  @@index([applicationOfficer])
  @@index([universityId])
  @@index([courseId])
  @@index([applicationSource])
  @@index([isB2b])
  @@index([b2bProviderId])
  @@index([stage])
  @@index([safeStatus])
  @@index([status])
}

model ApplicationStageHistory {
  id            String   @id @default(cuid())
  applicationId String
  stage         String
  status        String   @default("completed")
  note          String   @default("")
  actor         String   @default("")
  createdAt     DateTime @default(now())
}

model StudentDocument {
  id                String    @id @default(cuid())
  studentId         String
  caseId            String    @default("")
  category          String
  fileName          String    @default("")
  fileUrl           String    @default("")
  status            String    @default("not_uploaded")
  version           Int       @default(1)
  previousVersionId String    @default("")
  rejectionReason   String    @default(dbgenerated("(_utf8mb4'')")) @db.Text
  reviewerNote      String    @default(dbgenerated("(_utf8mb4'')")) @db.Text
  reviewedBy        String    @default("")
  reviewedAt        DateTime?
  archivedAt        DateTime?
  isArchived        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([studentId])
  @@index([caseId])
  @@index([status])
  @@index([category])
}

model StudentMessage {
  id         String   @id @default(cuid())
  studentId  String
  senderType String   @default("student")
  senderName String   @default("")
  message    String   @default("")
  channel    String   @default("portal")
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model TimelineEvent {
  id          String   @id @default(cuid())
  studentId   String
  stage       String
  title       String
  description String   @default("")
  actor       String   @default("system")
  actionUrl   String   @default("")
