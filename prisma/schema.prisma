model KnowledgeSharingPost {
  id                 String    @id @default(cuid())
  title              String
  slug               String    @unique
  content            String    @db.LongText
  summary            String?   @db.Text
  category           String    @default("general") // general, university_update, visa_update, scholarship, country_guide, course_info, partnership, business_strategy, training, announcement, research
  tags               String    @default("[]") // JSON array
  fileUrl            String? // optional attachment private storage
  fileType           String? // pdf, image, docx, etc
  fileSize           Int?
  authorId           String
  authorName         String    @default("")
  authorRole         String    @default("") // STUDENT, PARTNER, EMPLOYEE, COUNSELOR, ADMIN, SUPER_ADMIN, INTERNATIONAL_OFFICER
  authorEmail        String    @default("")
  visibility         String    @default("ALL") // ALL, EMPLOYEE, STUDENT, PARTNER, COUNSELOR, ADMIN, INTERNATIONAL_OFFICER
  status             String    @default("PENDING") // PENDING, APPROVED, REJECTED, PUBLISHED, ARCHIVED
  verificationStatus String    @default("NEEDS_REVIEW") // NEEDS_REVIEW, VERIFIED, REJECTED
  upvotes            Int       @default(0)
  views              Int       @default(0)
  isPinned           Boolean   @default(false)
  isFeatured         Boolean   @default(false)
  approvedById       String?
  approvedAt         DateTime?
  rejectionReason    String?
  sourceUrl          String?
  universitySlug     String?
  countrySlug        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  comments   KnowledgeSharingComment[]
  upvoteLogs KnowledgeSharingUpvote[]

  @@index([category])
  @@index([visibility])
  @@index([status])
  @@index([authorId])
  @@index([universitySlug])
  @@index([countrySlug])
  @@index([createdAt])
}

model KnowledgeSharingComment {
  id         String               @id @default(cuid())
  postId     String
  post       KnowledgeSharingPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId   String
  authorName String               @default("")
  authorRole String               @default("")
  content    String               @db.Text
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([postId])
  @@index([authorId])
}

model KnowledgeSharingUpvote {
