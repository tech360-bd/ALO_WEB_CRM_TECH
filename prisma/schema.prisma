}

// ============================================================
// CONTENT RELATIONSHIPS — unified related-content engine
// Connects SERVICES, SCHOLARSHIPS, RESOURCES, COURSES, UNIVERSITIES, COUNTRIES
// ============================================================

model ContentRelationship {
  id               String   @id @default(cuid())
  sourceType       String   // SERVICE, SCHOLARSHIP, RESOURCE, COURSE, UNIVERSITY, COUNTRY
  sourceId         String
  targetType       String   // SERVICE, SCHOLARSHIP, RESOURCE, COURSE, UNIVERSITY, COUNTRY
  targetId         String
  relationshipType String   // RELATED, FAQ_REFERENCE, REQUIREMENT_REFERENCE
  sortOrder        Int      @default(0)
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())

  // Optional relations — only populated for entities that have Prisma models.
  // For COURSE / UNIVERSITY / COUNTRY targets, the relations stay null and the
  // string IDs are resolved at query time by the consumer.
  serviceSource      Service?      @relation("ContentRelationship_ServiceSource", fields: [sourceId], references: [id], onDelete: Cascade)
  scholarshipSource  Scholarship?  @relation("ContentRelationship_ScholarshipSource", fields: [sourceId], references: [id], onDelete: Cascade)
  resourceSource     Resource?     @relation("ContentRelationship_ResourceSource", fields: [sourceId], references: [id], onDelete: Cascade)
  serviceTarget      Service?      @relation("ContentRelationship_ServiceTarget", fields: [targetId], references: [id], onDelete: Cascade)
  scholarshipTarget  Scholarship?  @relation("ContentRelationship_ScholarshipTarget", fields: [targetId], references: [id], onDelete: Cascade)
  resourceTarget     Resource?     @relation("ContentRelationship_ResourceTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
}

// ============================================================
// AI TASK QUEUE + AI ACTIONS + AUTOMATION
// ============================================================

model AiTask {
  id              String   @id @default(cuid())
  taskCode        String   @unique // ALO-AITASK-XXXXX
  agentId         String? // AiAgent.id
  agentName       String   // e.g. "Lead Intake Agent"
  department      String   // e.g. "Lead Management"
  crmId           String? // Lead.studentId or Lead.leadId
  crmType         String? // LEAD, STUDENT, APPLICATION
  applicationId   String?
  priority        String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status          String   @default("QUEUED") // QUEUED, RUNNING, WAITING, COMPLETED, FAILED, ESCALATED, CANCELLED
  action          String   // e.g. "qualify_lead", "score_lead", "assign_counselor"
  input           String?  @default("{}") // JSON: task input data
  result          String?  @default("{}") // JSON: task result
  errorMessage    String?
  retryCount      Int      @default(0)
  maxRetries      Int      @default(3)
  approvalRequired Boolean @default(false)
  approvedById    String?
  approvedAt      DateTime?
  deadline        DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  actions         AiAction[]

  @@index([status])
  @@index([agentId])
  @@index([crmId])
  @@index([priority])
  @@index([createdAt])
}

model AiAction {
  id              String   @id @default(cuid())
  taskId          String
  task            AiTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agentName       String
  actionType      String   // TOOL_CALL, LLM_CALL, CRM_UPDATE, NOTIFICATION, ESCALATION
  toolName        String?  // e.g. "create_lead", "search_course"
  toolInput       String?  @default("{}") // JSON
  toolResult      String?  @default("{}") // JSON
  crmId           String?
  crmType         String?
  success         Boolean  @default(true)
  errorMessage    String?
  duration        Int?     // milliseconds
  createdAt       DateTime @default(now())

  @@index([taskId])
  @@index([agentName])
  @@index([actionType])
  @@index([createdAt])
}

model FormSubmission {
  id              String   @id @default(cuid())
  submissionCode  String   @unique // ALO-FS-XXXXX
  source          String   // WEBSITE, WHATSAPP, FACEBOOK, etc.
  channel         String?  // form name, page URL
  sourceUrl       String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  rawPayload      String   @default("{}") // JSON: complete raw form data
  normalizedData  String?  @default("{}") // JSON: normalized fields
  crmId           String? // linked Lead.leadId or Student.studentId
  crmType         String? // LEAD, STUDENT
  processingStatus String @default("PENDING") // PENDING, PROCESSED, DUPLICATE, ERROR
  errorMessage    String?
  ipAddress       String?
  createdAt       DateTime @default(now())

  @@index([source])
  @@index([crmId])
  @@index([processingStatus])
}

model AutomationMetric {
  id              String   @id @default(cuid())
  category        String   // lead_intake, data_entry, lead_qualification, assignment, course_matching, document_processing, follow_up, deadline_tracking, communication, reporting, qa
