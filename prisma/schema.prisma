  userAgent  String    @default("")
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id            String   @id @default(cuid())
