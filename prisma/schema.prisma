generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String              @id @default(cuid())
  email                      String              @unique
  name                       String?
  role                       String              @default("student")
  permissions                String              @default("[]")
  actingAsRole               String?
  actingAsUserId             String?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  marketingApprovals         MarketingApproval[]
  marketingReviewedApprovals MarketingApproval[] @relation("ApprovalReviewer")
  marketingAuditLogs         MarketingAuditLog[]
  marketingCreatedLeads      MarketingLead[]     @relation("LeadCreator")
}

model DeploymentSequence {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model MarketingCampaign {
  id                  String    @id @default(cuid())
  name                String
  goal                String
  platform            String    @default("facebook")
  strategy            String    @default("")
  status              String    @default("draft")
  banglaCaption       String    @default("")
  englishCaption      String    @default("")
  mixedCaption        String    @default("")
  whatsappMessage     String    @default("")
  messengerReply      String    @default("")
  emailCopy           String    @default("")
  smsCopy             String    @default("")
  posterPrompt        String    @default("")
  videoScript         String    @default("")
  voiceScript         String    @default("")
  subtitle            String    @default("")
  thumbnailConcept    String    @default("")
  hashtags            String    @default("[]")
  cta                 String    @default("")
  landingPage         String    @default("")
  followUpSequence    String    @default("[]")
  commentReplies      String    @default("[]")
  dmQualification     String    @default("")
  brandCheck          Boolean   @default(false)
  metaPolicyCheck     Boolean   @default(false)
  safetyCheck         Boolean   @default(false)
  visaClaimCheck      Boolean   @default(false)
  leadsGenerated      Int       @default(0)
  hotLeads            Int       @default(0)
  conversionRate      Float     @default(0)
  costPerLead         Float     @default(0)
  roi                 Float     @default(0)
  topContent          String    @default("[]")
  weakContent         String    @default("[]")
  countryInterest     String    @default("{}")
  courseInterest      String    @default("{}")
  counselorConversion String    @default("{}")
  targetCountry       String    @default("")
  targetCourse        String    @default("")
  budget              Float     @default(0)
  startDate           DateTime?
  endDate             DateTime?
  publishedAt         DateTime?
  approvedById        String?
  approvedAt          DateTime?
  createdById         String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model MarketingContentIdea {
  id           String   @id @default(cuid())
  keyword      String   @default("")
  country      String   @default("")
  course       String   @default("")
  intake       String   @default("")
  scholarship  String   @default("")
  language     String   @default("english")
  platform     String   @default("facebook")
  audienceType String   @default("")
  funnelStage  String   @default("awareness")
  ideaType     String   @default("")
  title        String   @default("")
  description  String   @default("")
  trending     Boolean  @default(false)
  status       String   @default("new")
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MarketingGeneratedContent {
  id                String    @id @default(cuid())
  contentType       String    @default("social_post")
  topic             String    @default("")
  keywords          String    @default("[]")
  language          String    @default("english")
  platform          String    @default("facebook")
  tone              String    @default("professional")
  cta               String    @default("")
  includeImage      Boolean   @default(false)
  includeVideo      Boolean   @default(false)
  variations        Int       @default(1)
  approvalRequired  Boolean   @default(true)
  targetCountry     String    @default("")
  targetCourse      String    @default("")
  targetStudentType String    @default("")
  campaignId        String?
  title             String    @default("")
  body              String    @default("")
  status            String    @default("draft")
  publishedAt       DateTime?
  approvedById      String?
  approvedAt        DateTime?
  rejectedById      String?
  rejectedAt        DateTime?
  rejectionReason   String    @default("")
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model MarketingAsset {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("image")
  url         String   @default("")
  thumbnail   String   @default("")
  platform    String   @default("")
  campaignId  String?
  category    String   @default("generated")
  tags        String   @default("[]")
  status      String   @default("active")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MarketingTemplate {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("social")
  platform    String   @default("facebook")
  content     String   @default("")
  variables   String   @default("[]")
  category    String   @default("general")
  status      String   @default("active")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MarketingVideo {
  id           String    @id @default(cuid())
  title        String    @default("")
  script       String    @default("")
  banglaVoice  String    @default("")
  englishVoice String    @default("")
  mixedVoice   String    @default("")
  scenePlan    String    @default("")
  subtitle     String    @default("")
  thumbnail    String    @default("")
  brandOverlay Boolean   @default(true)
  aspectRatio  String    @default("16:9")
  platform     String    @default("facebook")
  status       String    @default("draft")
  approvedById String?
  approvedAt   DateTime?
  publishedAt  DateTime?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model MarketingCalendar {
  id           String    @id @default(cuid())
  title        String
  description  String    @default("")
  platform     String    @default("facebook")
  campaignId   String?
  contentId    String?
  status       String    @default("scheduled")
  scheduledAt  DateTime
  publishedAt  DateTime?
  failedAt     DateTime?
  failReason   String    @default("")
  reminderSent Boolean   @default(false)
  autoReminder Boolean   @default(true)
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model MarketingApproval {
  id            String    @id @default(cuid())
  itemType      String
  itemId        String
  title         String    @default("")
  description   String    @default("")
  status        String    @default("pending")
  requestedById String
  reviewedById  String?
  reviewedAt    DateTime?
  rejectionNote String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  requestedBy   User      @relation(fields: [requestedById], references: [id])
  reviewedBy    User?     @relation("ApprovalReviewer", fields: [reviewedById], references: [id])

  @@index([requestedById], map: "MarketingApproval_requestedById_fkey")
  @@index([reviewedById], map: "MarketingApproval_reviewedById_fkey")
}

model MarketingSocialMessage {
  id              String    @id @default(cuid())
  platform        String    @default("facebook")
  channel         String    @default("comment")
  threadId        String    @default("")
  externalId      String    @default("")
  senderName      String    @default("")
  senderId        String    @default("")
  senderAvatar    String    @default("")
  message         String    @default("")
  messageRaw      String    @default("")
  intent          String    @default("")
  isResolved      Boolean   @default(false)
  contactId       String?
  leadId          String?
  suggestedReply  String    @default("")
  replySent       String    @default("")
  repliedAt       DateTime?
  convertedToLead Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model MarketingDMThread {
  id                  String   @id @default(cuid())
  platform            String   @default("messenger")
  externalThreadId    String   @default("")
  contactName         String   @default("")
  contactPhone        String   @default("")
  contactId           String?
  leadId              String?
  status              String   @default("active")
  qualifyingQuestions String   @default("[]")
  responses           String   @default("{}")
  qualified           Boolean  @default(false)
  sentPortalLink      Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model MarketingComment {
  id                String    @id @default(cuid())
  platform          String    @default("facebook")
  postId            String    @default("")
  externalCommentId String    @default("")
  authorName        String    @default("")
  authorId          String    @default("")
  text              String    @default("")
  intent            String    @default("")
  isLead            Boolean   @default(false)
  convertedToLead   String    @default("")
  leadId            String?
  contactId         String?
  status            String    @default("new")
  replyText         String    @default("")
  repliedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([platform, status])
  @@index([leadId])
}

model MarketingLead {
  id              String    @id @default(cuid())
  name            String    @default("")
  phone           String    @default("")
  email           String    @default("")
  destination     String    @default("")
  level           String    @default("")
  intake          String    @default("")
  ieltsScore      Float     @default(0)
  pteScore        Float     @default(0)
  budget          String    @default("")
  consent         Boolean   @default(false)
  source          String    @default("")
  sourceDetail    String    @default("")
  campaignId      String?
  score           Float     @default(0)
  status          String    @default("new")
  hotLead         Boolean   @default(false)
  counselorId     String?
  counselorName   String    @default("")
  assignedAt      DateTime?
  followUpDueAt   DateTime?
  followUpDone    Boolean   @default(false)
  convertedAt     DateTime?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdByIdUser User?     @relation("LeadCreator", fields: [createdById], references: [id])

  @@index([createdById], map: "MarketingLead_createdById_fkey")
}

model MarketingLeadScore {
  id           String   @id @default(cuid())
  leadId       String
  score        Float    @default(0)
  factors      String   @default("{}")
  calculatedAt DateTime @default(now())
}

model MarketingCampaignSource {
  id          String   @id @default(cuid())
  campaignId  String
  platform    String
  source      String   @default("")
  leads       Int      @default(0)
  clicks      Int      @default(0)
  impressions Int      @default(0)
  cost        Float    @default(0)
  date        DateTime @default(now())
}

model MarketingReport {
  id          String   @id @default(cuid())
  type        String   @default("daily")
  periodStart DateTime
  periodEnd   DateTime
  data        String   @default("{}")
  createdById String
  createdAt   DateTime @default(now())
}

model MarketingAgentJob {
  id                 String   @id @default(cuid())
  agentName          String
  agentType          String
  status             String   @default("idle")
  input              String   @default("{}")
  output             String   @default("")
  error              String   @default("")
  duration           Int      @default(0)
  ragEnabled         Boolean  @default(true)
  memoryUsed         Boolean  @default(true)
  protectedMode      Boolean  @default(true)
  permissionRequired Boolean  @default(false)
  approvalId         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MarketingAgentMemory {
  id        String   @id @default(cuid())
  agentName String
  category  String
  key       String
  value     String   @default("")
  metadata  String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarketingAuditLog {
  id           String   @id @default(cuid())
  userId       String
  userName     String   @default("")
  role         String   @default("")
  actingAsRole String   @default("")
  action       String
  resource     String   @default("")
  resourceId   String   @default("")
  details      String   @default("{}")
  ipAddress    String   @default("")
  userAgent    String   @default("")
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "MarketingAuditLog_userId_fkey")
}

model MarketingRagSource {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("document")
  description String   @default("")
  filePath    String   @default("")
  content     String   @default("")
  status      String   @default("active")
  chunkCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MarketingRagChunk {
  id        String   @id @default(cuid())
  sourceId  String
  content   String
  embedding String   @default("")
  metadata  String   @default("{}")
  createdAt DateTime @default(now())
}

model MarketingImprovementProposal {
  id            String    @id @default(cuid())
  agentName     String
  category      String
  title         String
  description   String    @default("")
  impact        String    @default("medium")
  status        String    @default("proposed")
  implementedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model SocialConnectedAccount {
  id          String    @id @default(cuid())
  platform    String
  accountName String
  accountId   String    @default("")
  avatar      String    @default("")
  status      String    @default("connected")
  lastSyncAt  DateTime?
  tokenRef    String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SocialWebhookEvent {
  id          String    @id @default(cuid())
  platform    String
  eventType   String
  payload     String    @default("{}")
  status      String    @default("success")
  error       String    @default("")
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

model Student {
  id              String    @id @default(cuid())
  studentId       String    @unique
  userId          String?
