}

// Reusable marketing model profiles for video/image generation.
// 10 profiles (5 male, 5 female) — culturally appropriate for Bangladesh.
// Must NOT represent real people unless consent is explicitly recorded.
model MarketingModel {
  id                   String    @id @default(cuid())
  modelId              String    @unique // MM-0001
  displayName          String
  gender               String // MALE | FEMALE
  ageRange             String // "25-30"
  appearanceDesc       String // culturally appropriate description
  voiceProfile         String? // link to VoiceProfile
  language             String    @default("bn") // bn | en | banglish
  accent               String? // "dhaka" | "standard-bengali" | "bangladeshi-english"
  wardrobe             String? // JSON array of approved wardrobe options
  // Rights & consent
  brandUsageRights     Boolean   @default(false)
  consentStatus        String    @default("PENDING") // PENDING | GRANTED | REVOKED
  consentDocumentId    String? // link to signed consent FileMetadata
  consentDate          DateTime?
  consentExpiresAt     DateTime?
  approvedPlatforms    String    @default("[]") // JSON array
  // Reference image (only stored if consent granted)
  referenceImageFileId String?
  isSynthetic          Boolean   @default(true) // true = AI-generated avatar, not a real person
  // Status
  status               String    @default("ACTIVE") // ACTIVE | INACTIVE | ARCHIVED
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([gender])
  @@index([status])
  @@index([consentStatus])
}

// Voice profiles for TTS in marketing creatives.
// Must not impersonate a real person's voice without explicit consent.
model VoiceProfile {
  id                String    @id @default(cuid())
  voiceId           String    @unique // VP-0001
  displayName       String
  language          String    @default("bn") // bn | en | banglish
  accent            String? // "dhaka" | "standard-bengali" | "bangladeshi-english"
  gender            String // MALE | FEMALE
  voiceStyle        String? // "warm" | "professional" | "energetic" | "calm"
  // Consent
  consentStatus     String    @default("PENDING") // PENDING | GRANTED | REVOKED
  consentDocumentId String?
  consentDate       DateTime?
  usageRights       String? // JSON describing permitted usage
  isSynthetic       Boolean   @default(true) // true = synthetic voice, not a real person's voice
  // Status
  status            String    @default("ACTIVE")
  providerVoiceId   String? // TTS provider's voice ID
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([language])
  @@index([status])
  @@index([consentStatus])
}

