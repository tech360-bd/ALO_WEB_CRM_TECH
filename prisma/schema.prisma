  createdAt      DateTime @default(now())
}

model ScholarshipMatch {
  id              String   @id @default(cuid())
  studentId       String
  universityName  String   @default("")
  scholarshipName String   @default("")
  coverage        String   @default("")
  eligibility     String   @default("")
