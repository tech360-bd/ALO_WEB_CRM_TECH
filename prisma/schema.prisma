// ============================================================
// UNIVERSITY & OFFICIAL DATA MONITORING SYSTEM (Task 21)
// AI-powered 7-day monitoring agent for university/course data
// ============================================================

// Official source URL registered for a university, course, or government authority.
// One university may have multiple official sources (course catalogue, admissions,
// scholarships, international office, government visa page, etc.)
model OfficialSource {
  id                  String    @id @default(cuid())
  // What entity this source describes
  entityType          String // UNIVERSITY | COURSE | COUNTRY | GOVERNMENT | AUTHORITY
  universitySlug      String? // set when entityType = UNIVERSITY or COURSE
  courseSlug          String? // set when entityType = COURSE
  countrySlug         String? // set when entityType = COUNTRY / GOVERNMENT / AUTHORITY
  // Source metadata
  sourceUrl           String    @unique // the official URL to monitor
  sourceName          String // human label e.g. "University of Oxford — Course Catalogue"
  sourceType          String    @default("UNIVERSITY_OFFICIAL") // UNIVERSITY_OFFICIAL | GOVERNMENT | AUTHORITY | ADMISSIONS_PORTAL | PDF | APPROVED_INSTITUTIONAL
  category            String? // CATALOGUE | ADMISSIONS | SCHOLARSHIPS | VISAS | FEES | INTAKES | REQUIREMENTS | POLICY
  priority            Int       @default(1) // 1 = official university, 2 = government, 3 = authority, 4 = portal, 5 = PDF, 6 = approved institutional
  // Monitoring config
  monitoringEnabled   Boolean   @default(true)
  checkFrequencyDays  Int       @default(7)
  lastCheckedAt       DateTime?
  lastHttpStatus      Int?
  lastContentHash     String? // SHA-256 of normalized page content
  lastError           String?
  consecutiveFailures Int       @default(0)
  // Lifecycle
  status              String    @default("ACTIVE") // ACTIVE | PAUSED | RETIRED | BROKEN
  discoveredAt        DateTime  @default(now())
  lastVerifiedAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  snapshots SourceSnapshot[]
  changes   DataChange[]
  documents OfficialDocument[]

  @@index([entityType])
  @@index([universitySlug])
  @@index([courseSlug])
  @@index([countrySlug])
  @@index([status])
  @@index([priority])
}

// A point-in-time snapshot of an official source's content.
// Used for change detection (diff against previous snapshot).
model SourceSnapshot {
  id                String         @id @default(cuid())
  sourceId          String
  source            OfficialSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  capturedAt        DateTime       @default(now())
  httpStatus        Int
  contentHash       String // SHA-256 of normalized content
  contentLength     Int            @default(0)
  title             String? // <title> or detected heading
  contentType       String? // text/html, application/pdf, etc.
  // We store a truncated normalized text extract (not raw HTML) to keep DB size sane.
  // Full raw HTML is optionally stored in object storage in production.
  textExtract       String // normalized plain text (truncated to 50KB)
  // AI-generated structured summary of what the page currently says
  aiSummary         String? // short AI summary of key facts found on the page
  aiKeyFacts        String         @default("{}") // JSON of {field: value} extracted by AI
  // Snapshot metadata
  captureDurationMs Int            @default(0)
  fetchError        String?
  createdAt         DateTime       @default(now())

  @@index([sourceId])
  @@index([capturedAt])
}

// A detected change between two snapshots. One change record per field that changed.
model DataChange {
  id                 String         @id @default(cuid())
  runId              String // VerificationRun id
  sourceId           String
  source             OfficialSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  // What entity changed
  entityType         String // UNIVERSITY | COURSE | FACULTY | SCHOLARSHIP | GOVERNMENT_POLICY
  universitySlug     String?
  courseSlug         String?
  countrySlug        String?
  // Change classification (one of the 27 change types from the spec)
  changeType         String // NEW_UNIVERSITY | UNIVERSITY_UPDATED | UNIVERSITY_CLOSED | NEW_FACULTY | FACULTY_UPDATED | NEW_COURSE | COURSE_UPDATED | COURSE_CLOSED | COURSE_RENAMED | COURSE_CODE_CHANGED | FEE_CHANGED | INTAKE_CHANGED | DEADLINE_CHANGED | REQUIREMENT_CHANGED | ENGLISH_REQUIREMENT_CHANGED | SCHOLARSHIP_NEW | SCHOLARSHIP_UPDATED | SCHOLARSHIP_CLOSED | DURATION_CHANGED | CAMPUS_CHANGED | STUDY_MODE_CHANGED | APPLICATION_PROCESS_CHANGED | OFFICIAL_POLICY_CHANGE | GOVERNMENT_POLICY_CHANGE | SOURCE_CHANGED | SOURCE_UNAVAILABLE | POSSIBLE_DATA_CONFLICT | NEEDS_MANUAL_REVIEW
  fieldName          String // e.g. "tuition", "intake", "deadline", "englishRequirement"
  // Values (preserved for history — NEVER destroy old value)
  oldValue           String? // previous verified value (NULL if field didn't exist before)
  newValue           String? // newly detected value (NULL if field removed)
  // Evidence
  sourceUrl          String // official URL where the change was detected
  sourcePageTitle    String?
  detectedAt         DateTime       @default(now())
  previousVerifiedAt DateTime? // when the OLD value was last verified
  newSourceDate      String? // publication date if detectable from the source page
  // AI analysis
  aiExplanation      String? // human-readable AI explanation of the change
  confidence         Float          @default(0) // 0.0–1.0
  impactLevel        String         @default("LOW") // LOW | MEDIUM | HIGH | CRITICAL
  // Approval workflow
  status             String         @default("PENDING") // PENDING | APPROVED | REJECTED | NEEDS_REVIEW | RECHECK_REQUESTED | SUPERSEDED
  reviewedBy         String? // userId of Super Admin
  reviewedAt         DateTime?
  reviewNotes        String?
  // When approved, the production database mutation is applied and recorded here
  appliedAt          DateTime?
  appliedBy          String?
  // Supersession: if a newer change supersedes this one, link it
  supersededBy       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  values    DataChangeValue[]
  approvals ApprovalAction[]

  @@index([runId])
  @@index([sourceId])
  @@index([entityType])
  @@index([universitySlug])
  @@index([courseSlug])
  @@index([changeType])
  @@index([status])
  @@index([impactLevel])
  @@index([detectedAt])
}

// Full versioned history of every field value for a change (supports multi-field changes).
model DataChangeValue {
  id           String     @id @default(cuid())
  changeId     String
  change       DataChange @relation(fields: [changeId], references: [id], onDelete: Cascade)
  fieldName    String // e.g. "tuition.international", "intake.september", "english.ielts"
  oldValue     String?
  newValue     String?
  oldValueHash String? // for fast comparison
  newValueHash String?
  createdAt    DateTime   @default(now())

  @@index([changeId])
  @@index([fieldName])
}

// A single monitoring run (executed every 7 days by the scheduler).
model VerificationRun {
  id                  String        @id @default(cuid())
  jobId               String // MonitoringJob id
  job                 MonitoringJob @relation(fields: [jobId], references: [id])
  runId               String        @unique // human-readable run identifier e.g. "VR-2026-08-08-001"
  status              String        @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED | PARTIAL
  startedAt           DateTime      @default(now())
  completedAt         DateTime?
  // Scope
  universitiesChecked Int           @default(0)
  coursesChecked      Int           @default(0)
  sourcesChecked      Int           @default(0)
  // Results
  changesDetected     Int           @default(0)
  newUniversities     Int           @default(0)
  newCourses          Int           @default(0)
  updatedCourses      Int           @default(0)
  closedCourses       Int           @default(0)
  feeChanges          Int           @default(0)
  intakeChanges       Int           @default(0)
  deadlineChanges     Int           @default(0)
  requirementChanges  Int           @default(0)
  scholarshipChanges  Int           @default(0)
  governmentChanges   Int           @default(0)
  criticalChanges     Int           @default(0)
  failedSources       Int           @default(0)
  conflicts           Int           @default(0)
  manualReviewItems   Int           @default(0)
  // Error tracking
  errorMessage        String?
  retryCount          Int           @default(0)
  // AI-generated 7-day report summary
  aiReportSummary     String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([jobId])
  @@index([status])
  @@index([startedAt])
}

// Approval queue entry — one per pending DataChange that needs Super Admin review.
model ApprovalQueueItem {
  id          String    @id @default(cuid())
  changeId    String    @unique // one queue entry per change
  queueType   String    @default("STANDARD") // STANDARD | CRITICAL | CONFLICT | RECHECK | MANUAL_REVIEW
  priority    Int       @default(0) // higher = more urgent
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED | RECHECK_REQUESTED | RESOLVED
  assignedTo  String? // userId of assigned Super Admin (optional)
  requestedBy String? // userId who requested recheck (if applicable)
  enqueuedAt  DateTime  @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([queueType])
  @@index([priority])
}

// Audit trail of every approval/rejection/recheck/manual-edit action.
model ApprovalAction {
  id              String     @id @default(cuid())
  changeId        String
  change          DataChange @relation(fields: [changeId], references: [id], onDelete: Cascade)
  action          String // APPROVE | REJECT | REQUEST_RECHECK | MARK_VERIFIED | MANUAL_EDIT | FORCE_PUBLISH | ESCALATE
  performedBy     String // userId
  performedAt     DateTime   @default(now())
  notes           String?
  // For MANUAL_EDIT actions, record what was edited
  editedFieldName String?
  editedOldValue  String?
  editedNewValue  String?
  // Snapshot of approval context
  metadata        String? // JSON: {ip, userAgent, role, ...}
  createdAt       DateTime   @default(now())

  @@index([changeId])
  @@index([action])
  @@index([performedBy])
}

// Persistent scheduler job record. Survives server restarts.
// The mini-service reads this to know when to run next and to acquire locks.
model MonitoringJob {
  id                 String    @id @default(cuid())
  jobId              String    @unique // stable identifier e.g. "university-monitor-7d"
  name               String // "ALO University & Official Data Monitoring Agent"
  description        String?
  schedule           String    @default("0 3 * * 1") // cron: every Monday 03:00
  enabled            Boolean   @default(true)
  // Locking (prevents duplicate concurrent execution)
  lockedBy           String? // process ID / instance ID holding the lock
  lockedAt           DateTime?
  lockExpiresAt      DateTime? // lock auto-expires after this time (crash recovery)
  // Last run info
  lastRunId          String? // VerificationRun.id
  lastRunStartedAt   DateTime?
  lastRunCompletedAt DateTime?
  lastRunStatus      String?
  nextRunAt          DateTime?
  // Stats
  totalRuns          Int       @default(0)
  successfulRuns     Int       @default(0)
  failedRuns         Int       @default(0)
  // Retry config
  maxRetries         Int       @default(3)
  retryDelayMs       Int       @default(60000)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  runs VerificationRun[]

  @@index([enabled])
  @@index([nextRunAt])
}

// Per-run log entries for debugging and audit.
model MonitoringLog {
  id         String   @id @default(cuid())
  runId      String? // VerificationRun.id (null for scheduler-level logs)
  jobId      String? // MonitoringJob.id
  level      String   @default("INFO") // INFO | WARN | ERROR | DEBUG | AUDIT
  message    String
  entityType String? // UNIVERSITY | COURSE | SOURCE
  entitySlug String?
  sourceUrl  String?
  metadata   String? // JSON
  createdAt  DateTime @default(now())

  @@index([runId])
  @@index([jobId])
  @@index([level])
  @@index([createdAt])
}

// When two official sources disagree about the same fact, a conflict is created.
model DataConflict {
  id                String    @id @default(cuid())
  entityType        String // UNIVERSITY | COURSE | SCHOLARSHIP | POLICY
  universitySlug    String?
  courseSlug        String?
  countrySlug       String?
  fieldName         String // the disputed field
  // Conflicting values from different official sources
  conflictingValues String    @default("[]") // JSON array of {sourceUrl, sourceName, value, detectedAt}
  status            String    @default("PENDING") // PENDING | RESOLVED | ESCALATED
  resolution        String? // SUPERSEDED | MERGED | MANUAL_OVERRIDE
  resolvedBy        String?
  resolvedAt        DateTime?
  resolutionNotes   String?
  detectedAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([entityType])
  @@index([universitySlug])
  @@index([courseSlug])
  @@index([status])
}

// Official documents (PDFs, handbooks, guides) discovered on official sources.
// Versioned — never replace without preserving previous version.
model OfficialDocument {
  id              String         @id @default(cuid())
  sourceId        String
  source          OfficialSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  universitySlug  String?
  courseSlug      String?
  countrySlug     String?
  title           String // document title
  documentType    String // ADMISSION_GUIDE | APPLICATION_GUIDE | SCHOLARSHIP_PDF | INTERNATIONAL_GUIDE | PROGRAMME_HANDBOOK | POLICY_PDF | COUNTRY_REQUIREMENT | PROSPECTUS | FEES_PDF | VISA_PDF
  sourceUrl       String // direct URL to the document
  publicationDate String? // detected publication date if available
  discoveredAt    DateTime       @default(now())
  lastCheckedAt   DateTime?
  fileHash        String? // SHA-256 of the file content (for versioning)
  fileSizeBytes   Int?
  mimeType        String?
  version         String? // version label if detectable
  approvalStatus  String         @default("DISCOVERED") // DISCOVERED | APPROVED | REJECTED | SUPERSEDED
  storageLocation String? // local path or object storage key
  supersededBy    String? // id of newer version
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([sourceId])
  @@index([universitySlug])
  @@index([courseSlug])
  @@index([documentType])
  @@index([approvalStatus])
}

// Faculty / School / Department directory for a university.
// Populated during monitoring when the official catalogue is traversed.
model UniversityFaculty {
  id                 String    @id @default(cuid())
  universitySlug     String
  facultyName        String // e.g. "Faculty of Engineering"
  facultyType        String    @default("FACULTY") // FACULTY | SCHOOL | DEPARTMENT | COLLEGE | INSTITUTE
  parentFacultyId    String? // for nested departments
  officialUrl        String? // official faculty page URL
  programmeCount     Int       @default(0) // count of discovered programmes
  lastVerifiedAt     DateTime?
  verificationStatus String    @default("UNVERIFIED")
  approvalStatus     String    @default("PENDING")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([universitySlug])
  @@index([facultyType])
  @@index([approvalStatus])
}

// ============================================================
// STORAGE ARCHITECTURE (Task 22)
// Server-side file storage with three pools, checksums, audit
// ============================================================

// Central file metadata record. Every file uploaded, generated,
// or received by the platform gets a FileMetadata row. The actual
// file bytes live on disk in the configured storage pool; the DB
// stores the metadata + checksum + access policy + audit trail.
model FileMetadata {
  id                 String         @id @default(cuid())
  uuid               String         @unique // UUID-based storage name (never trust client filename)
  originalName       String // client-provided filename (sanitized)
  storedName         String // actual on-disk filename (uuid + extension)
  mimeType           String // server-validated MIME type (never trust client)
  extension          String // lowercase extension without dot
  sizeBytes          BigInt // verified file size
  checksumSha256     String // SHA-256 of file content (for integrity + dedup)
  // Storage routing
  storagePool        String // STUDENT_PARTNER | OFFICIAL | OPERATIONAL
  storagePath        String // relative path within pool, e.g. "student/STU-000001/documents/passport/uuid.pdf"
  absolutePath       String? // computed absolute path (for server-side access)
  // Entity linkage (who/what this file belongs to)
  entityType         String // STUDENT | PARTNER | EMPLOYEE | APPLICATION | EXAM | INTERVIEW | CAMPAIGN | OFFICIAL | PROJECT | LEAD | COMMUNICATION | REVIEW | BRAND
  entityId           String? // the entity ID (studentId, partnerId, etc.)
  studentId          String?
  partnerId          String?
  employeeId         String?
  applicationId      String?
  projectId          String?
  // Upload context
  uploadedBy         String? // userId
  uploadedAt         DateTime       @default(now())
  uploadedFromIp     String?
  source             String         @default("WEB_UPLOAD") // WEB_UPLOAD | API | WHATSAPP | EMAIL | AI_GENERATED | IMPORT | EXTERNAL
  // Access control
  visibility         String         @default("STUDENT_VISIBLE") // STUDENT_VISIBLE | INTERNAL_ONLY | PARTNER_VISIBLE | B2B_CONFIDENTIAL | PUBLIC | ARCHIVED
  accessPolicy       String         @default("OWNER_AND_STAFF") // OWNER_ONLY | OWNER_AND_STAFF | STAFF_ONLY | PARTNER_ONLY | PUBLIC | SUPER_ADMIN_ONLY
  // Lifecycle
  status             String         @default("ACTIVE") // ACTIVE | QUARANTINED | ARCHIVED | DELETED
  isDeleted          Boolean        @default(false)
  deletedAt          DateTime?
  deletedBy          String?
  deletionReason     String?
  // Versioning
  version            Int            @default(1)
  previousVersionId  String? // link to previous version if this is a replacement
  previousVersion    FileMetadata?  @relation("FileVersions", fields: [previousVersionId], references: [id])
  versions           FileMetadata[] @relation("FileVersions")
  // Retention
  retentionPolicy    String? // STUDENT_PERMANENT | EMPLOYEE_5Y | MARKETING_2Y | PROJECT_PERMANENT | EXAM_PERMANENT
  retentionExpiresAt DateTime?
  // Metadata
  metadata           String? // JSON: {dimensions, duration, pages, altText, ...}
  tags               String? // JSON array of string tags
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  events FileEvent[]

  @@index([storagePool])
  @@index([entityType])
  @@index([entityId])
  @@index([studentId])
  @@index([partnerId])
  @@index([employeeId])
  @@index([applicationId])
  @@index([uploadedBy])
  @@index([status])
  @@index([visibility])
  @@index([checksumSha256])
  @@index([createdAt])
}

// Audit trail for every file event (upload/download/view/delete/etc).
model FileEvent {
  id              String       @id @default(cuid())
  fileId          String
  file            FileMetadata @relation(fields: [fileId], references: [id], onDelete: Cascade)
  action          String // UPLOAD | DOWNLOAD | VIEW | SHARE | MOVE | COPY | VERSION | ARCHIVE | RESTORE | DELETE | FAILED_UPLOAD | QUARANTINE
  performedBy     String? // userId
  performedAt     DateTime     @default(now())
  performedFromIp String?
  result          String       @default("SUCCESS") // SUCCESS | FAILURE | DENIED
  details         String? // JSON: {reason, error, ...}
  createdAt       DateTime     @default(now())

  @@index([fileId])
  @@index([action])
  @@index([performedBy])
  @@index([createdAt])
}

// Storage pool configuration (capacity, usage, warnings).
model StoragePool {
  id                String    @id @default(cuid())
  poolKey           String    @unique // STUDENT_PARTNER | OFFICIAL | OPERATIONAL
  name              String // "Student & Partner Private Storage"
  description       String?
  mountPath         String // absolute path on server, e.g. "/home/alo/storage/student-partner"
  capacityBytes     BigInt    @default(0) // 0 = unlimited
  usedBytes         BigInt    @default(0)
  fileCount         Int       @default(0)
  warningThreshold  Int       @default(70) // percent
  highThreshold     Int       @default(85)
  criticalThreshold Int       @default(95)
  status            String    @default("HEALTHY") // HEALTHY | WARNING | HIGH | CRITICAL | OFFLINE
  lastHealthCheck   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([poolKey])
}

// ============================================================
// STUDENT REVIEW SYSTEM (Task 22)
// Review collection, consent, moderation, publication
// ============================================================

// A review invitation sent to a student. Each invitation has a
// unique secure token so the student can submit without logging in.
model ReviewInvitation {
  id                   String    @id @default(cuid())
  token                String    @unique // secure random token for /review/{token}
  studentId            String?
  studentName          String
  studentEmail         String?
  studentPhone         String?
  counselorId          String?
  country              String? // destination country
  serviceType          String? // ADMISSIONS | VISA | ENGLISH_TEST | SOP | GENERAL
  // Campaign context
  campaignId           String? // which review campaign this belongs to
  // Multi-channel links (student chooses where to submit)
  googleReviewUrl      String? // official Google review link
  facebookRecommendUrl String? // official Facebook recommendation link
  // Status
  status               String    @default("SENT") // SENT | OPENED | SUBMITTED | EXPIRED | REVOKED
  sentAt               DateTime  @default(now())
  openedAt             DateTime?
  submittedAt          DateTime?
  expiresAt            DateTime?
  // Linking
  reviewId             String? // link to StudentReview once submitted
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([token])
  @@index([sentAt])
}

// A student review submission. Never published without explicit consent.
model StudentReview {
  id                  String    @id @default(cuid())
  invitationId        String? // link back to the invitation
  studentId           String?
  studentName         String // display name (may be anonymized based on consent)
  studentEmail        String?
  country             String? // destination country
  counselorName       String?
  serviceType         String? // ADMISSIONS | VISA | ENGLISH_TEST | SOP | GENERAL
  // Review content
  rating              Int // 1-5 stars
  reviewText          String
  photoFileId         String? // link to FileMetadata if student uploaded a photo
  // Consent (all three must be explicitly captured)
  consentPublish      Boolean   @default(false) // publish on ALO website
  consentMarketing    Boolean   @default(false) // use in marketing materials
  consentShowName     Boolean   @default(false) // show name/profile image
  consentCapturedAt   DateTime?
  consentIp           String?
  // Moderation
  aiSpamScore         Float     @default(0) // 0-1
  aiFlags             String    @default("[]") // JSON array of flags
  aiSentiment         String? // POSITIVE | NEUTRAL | NEGATIVE
  moderationStatus    String    @default("PENDING") // PENDING | APPROVED | REJECTED | NEEDS_REVIEW
  moderatedBy         String?
  moderatedAt         DateTime?
  moderationNotes     String?
  // Publication
  publicationStatus   String    @default("INTERNAL") // INTERNAL | PUBLISHED | UNPUBLISHED
  publishedAt         DateTime?
  unpublishedAt       DateTime?
  // Multi-channel tracking (which platforms the student submitted to)
  googleSubmitted     Boolean   @default(false) // student clicked Google link
  googleSubmittedAt   DateTime?
  facebookSubmitted   Boolean   @default(false)
  facebookSubmittedAt DateTime?
  // Lifecycle
  isVerifiedStudent   Boolean   @default(false) // confirmed to be a real ALO student
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([invitationId])
  @@index([studentId])
  @@index([moderationStatus])
  @@index([publicationStatus])
  @@index([rating])
  @@index([createdAt])
}

// ============================================================
// MARKETING BRAND PROFILE + MODEL/VOICE LIBRARY (Task 22)
// ============================================================

// The single ALO Education brand profile. Marketing Manager configures
// this once; every creative generator uses it. Never hard-code branding.
model BrandProfile {
  id              String   @id @default(cuid())
  name            String   @default("ALO Education")
