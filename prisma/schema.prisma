model ApplicationStageHistory {
  id            String   @id @default(cuid())
  applicationId String
  stage         String
  status        String   @default("completed")
  note          String   @default("")
  actor         String   @default("")
  createdAt     DateTime @default(now())
}

model StudentDocument {
  id              String    @id @default(cuid())
  studentId       String
  category        String
  fileName        String    @default("")
  fileUrl         String    @default("")
  status          String    @default("not_uploaded")
  rejectionReason String    @default("")
  reviewerNote    String    @default("")
  reviewedBy      String    @default("")
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model StudentMessage {
  id         String   @id @default(cuid())
  studentId  String
  senderType String   @default("student")
  senderName String   @default("")
  message    String   @default("")
  channel    String   @default("portal")
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
