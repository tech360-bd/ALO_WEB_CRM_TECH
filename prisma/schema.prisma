// ALO Education - Complete Student Management, CRM, Admission & Visa Workflow System
// Prisma schema (MySQL 8)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS & RBAC
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?
  passwordHash  String    @default("alo-temporary")
  name          String
  role          String    @default("STUDENT") // SUPER_ADMIN, ADMIN, HR_MANAGER, BRANCH_MANAGER, COUNSELOR, APPLICATION_TEAM, VISA_OFFICER, VISA_INTERVIEW_OFFICER, FINANCE, MARKETING_MANAGER, MARKETING, FRONT_DESK, SUPPORT_STAFF, PARTNER, STUDENT, ENGLISH_TRAINER, MOCK_TEST_ADMIN
  status        String    @default("ACTIVE") // ACTIVE, SUSPENDED, RESIGNED, TERMINATED, PENDING
  avatar        String?
  mustChangePwd Boolean   @default(false)
  lastLoginAt   DateTime?
  permissions   String    @default("[]") // JSON array of permission strings
  partnerId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  leadsAssigned    Lead[]                @relation("CounselorLeads")
  studentsAssigned Student[]             @relation("CounselorStudents")
  auditLogs        AuditLog[]
  timelineEvents   TimelineEvent[]
  marketingAccess  MarketingUserAccess[]

  @@index([role])
  @@index([status])
}

// ============================================================
// LEADS - First touch point (website, whatsapp, sms, facebook, etc.)
// ============================================================

model Lead {
  id               String   @id @default(cuid())
  leadId           String   @unique // ALO-L-XXXXX
  fullName         String
  email            String?
  phone            String
  altPhone         String?
  source           String   @default("WEBSITE") // WEBSITE, WHATSAPP, SMS, FACEBOOK, INSTAGRAM, PHONE_CALL, PARTNER_REFERRAL, OFFICE_VISIT, EVENT, MOCK_TEST, COURSE_FINDER
  sourceDetail     String? // campaign name, partner name, etc.
  preferredCountry String?
  preferredCourse  String?
  notes            String?
  counselorId      String?
  counselor        User?    @relation("CounselorLeads", fields: [counselorId], references: [id])
  status           String   @default("NEW") // NEW, CONTACTED, QUALIFIED, CONVERTED, LOST, DUPLICATE
  duplicateOfId    String?
  studentId        String? // converted to student
  welcomeSent      Boolean  @default(false)
  // ─── Automation fields ───
  preferredLevel   String? // Foundation, Bachelor, Masters, MBA, PhD
  preferredIntake  String? // September 2026, January 2027, etc.
  budget           String? // e.g. "£20000"
  englishTest      String? // IELTS, PTE, TOEFL, etc.
  englishScore     String? // e.g. "7.0"
  currentQualification String? // HSC, BSc, etc.
  cgpa             String? // e.g. "3.45"
  leadScore        Int      @default(0) // 0-100
  leadTier         String   @default("COLD") // HOT, WARM, COLD, URGENT, AT_RISK
  assignedReason   String? // why this counselor was assigned
  branch           String?
  priority         String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  followUpDate      DateTime?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  rawSubmission    String? // JSON: complete raw form data
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  timelineEvents TimelineEvent[]
  leadOutreach   LeadOutreach[]

  @@index([source])
  @@index([status])
  @@index([counselorId])
}

// ============================================================
// STUDENT - Full profile (mission control data source)
// ============================================================

model Student {
  id        String  @id @default(cuid())
  studentId String  @unique // ALO-S-XXXXX
  userId    String? // linked login account
  leadId    String? // origin lead

  // B. Personal Information
  firstName        String
  lastName         String
  fullName         String
  nationality      String  @default("Bangladeshi")
  dateOfBirth      String?
  gender           String?
  maritalStatus    String?
  cityOfBirth      String?
  countryOfBirth   String  @default("Bangladesh")
  presentAddress   String?
  permanentAddress String?

  // C. Contact Information
  email             String
  altEmail          String?
  mobile            String
  altMobile         String?
  emergencyName     String?
  emergencyRelation String?
  emergencyPhone    String?

  // D. Education History (JSON array)
  educationHistory     String  @default("[]")
  // E. Passport
  hasPassport          Boolean @default(false)
  passportNumber       String?
  passportIssuePlace   String?
  passportIssueCountry String?
  passportIssueDate    String?
  passportExpiryDate   String?

  // F. English Test (JSON array)
  englishTests      String @default("[]")
  englishTestStatus String @default("YET_TO_RECEIVE") // YET_TO_RECEIVE, PLANNING, RECEIVED

  // G. Work Experience (JSON array)
  workExperience String @default("[]")

  // H. Recommendations (JSON array)
  recommendations String @default("[]")

  // I. Background & Visa History
  hasPreviousVisa  Boolean @default(false)
  visaHistory      String  @default("[]")
  previousRefusal  Boolean @default(false)
  refusalDetail    String?
  dependentStatus  String?
  dependentsCount  Int     @default(0)
  medicalCondition String?
  criminalOffense  String?
  riskNote         String?

  // J. Funding & Sponsor
  fundingStatus       String  @default("SELF_FUNDED")
  sponsorRelation     String  @default("APPLICANT")
  sourceOfFund        String?
  bankStatementStatus String  @default("NOT_STARTED")
  sponsorDocStatus    String  @default("NOT_STARTED")

  // K. Admission Preference
  studyDestination     String?
  programTitle         String?
  studyLevel           String?
  studyArea            String?
  intake               String?
  universityPreference String?

  // Profile meta
  profileCompletion Int      @default(0) // 0-100
  counselorId       String?
  counselor         User?    @relation("CounselorStudents", fields: [counselorId], references: [id])
  partnerId         String?
  status            String   @default("ACTIVE") // ACTIVE, INACTIVE, GRADUATED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  documents           Document[]
  applications        Application[]
  interviews          InterviewSession[]
  mockTests           MockTest[]
  visaCases           VisaCase[]
  timelineEvents      TimelineEvent[]
  payments            Payment[]
  benefitEntitlements StudentBenefitEntitlement[]
  mockTestVouchers    StudentMockTestVoucher[]
  aiMemory            AiStudentMemory[]
  referralsMade       Referral[] @relation("ReferralsMade")
  visaChecklistItems  VisaChecklistItem[]
  visaReadiness       VisaReadinessAssessment[]
  notifications       StudentNotification[]
  helpTickets         StudentHelpTicket[]

  @@index([counselorId])
  @@index([status])
}

// ============================================================
// DOCUMENTS - Secure Document Hub
// ============================================================

model Document {
  id              String    @id @default(cuid())
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category        String // PASSPORT, NID, ACADEMIC_CERT, TRANSCRIPT, CV, SOP, BANK_STATEMENT, SPONSOR_DOC, VISA_DOC, REFUSAL_LETTER, MEDICAL, IELTS_CERT, OTHER
  name            String
  required        Boolean   @default(true)
  fileName        String?
  fileType        String?
  fileSize        Int?
  // Security: no public URL. Stored path only, accessed via private download route with permission check.
  storagePath     String?
  status          String    @default("PENDING") // PENDING, UPLOADED, UNDER_REVIEW, APPROVED, REJECTED
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  uploadedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([category])
}

// ============================================================
// APPLICATIONS - Application Pipeline
// ============================================================

model Application {
  id               String   @id @default(cuid())
  applicationId    String   @unique // ALO-APP-XXXXX
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  university       String
  course           String
  country          String
  intake           String
  studyLevel       String
  deadline         String?
  counselorId      String?
  appTeamOfficerId String?
  visaOfficerId    String?
  stage            String   @default("COUNSELING") // COUNSELING, ELIGIBILITY_CHECKED, DOCUMENTS_PENDING, DOCUMENTS_RECEIVED, UNIVERSITY_SHORTLISTED, APPLICATION_PREPARING, APPLICATION_SUBMITTED, CONDITIONAL_OFFFER, UNCONDITIONAL_OFFER, DEPOSIT_PENDING, CAS_INTERVIEW, CAS_PENDING, CAS_ISSUED, VISA_DOCUMENTS, VISA_SUBMITTED, VISA_DECISION_PENDING, VISA_APPROVED, VISA_REFUSED, PRE_DEPARTURE, ENROLLED
  priority         String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([studentId])
  @@index([stage])
  @@index([country])
}

// ============================================================
// AI INTERVIEW SESSIONS
// ============================================================

model InterviewSession {
  id          String    @id @default(cuid())
  sessionId   String    @unique
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type        String // UNIVERSITY_CREDIBILITY, VISA_INTERVIEW, PRE_CAS, SCHOLARSHIP, GENERAL_ENGLISH
  status      String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  transcript  String    @default("[]") // JSON array of Q&A
  scores      String? // JSON: { communication, confidence, courseKnowledge, ... }
  readiness   String? // ready, needs_practice, high_risk, human_review_required
  riskLevel   String?
  feedback    String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([studentId])
  @@index([type])
}

// ============================================================
// ENGLISH MOCK TESTS
// ============================================================

model MockTest {
  id             String    @id @default(cuid())
  testId         String    @unique
  studentId      String?
  student        Student?  @relation(fields: [studentId], references: [id])
  guestName      String?
  guestPhone     String?
  testType       String // IELTS, IELTS_UKVI, PTE, TOEFL, DET, OIETC, GRE, GMAT, SAT, ACT, PLACEMENT
  isFree         Boolean   @default(true)
  status         String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  overallScore   Float?
  listeningScore Float?
  readingScore   Float?
  writingScore   Float?
  speakingScore  Float?
  weakAreas      String? // JSON
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([studentId])
  @@index([testType])
}

// ============================================================
// VISA CASES - Visa Interview Officer Dashboard
// ============================================================

model VisaCase {
  id                String   @id @default(cuid())
  caseId            String   @unique // ALO-V-XXXXX
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  applicationId     String?
  country           String
  university        String
  course            String
  intake            String?
  casStatus         String   @default("PENDING") // PENDING, ISSUED
  visaStage         String   @default("VISA_DOCUMENTS") // VISA_DOCUMENTS, VISA_SUBMITTED, VISA_DECISION_PENDING, VISA_APPROVED, VISA_REFUSED
  interviewStatus   String   @default("NOT_SCHEDULED") // NOT_SCHEDULED, SCHEDULED, COMPLETED
  interviewDate     String?
  docStatus         String   @default("PENDING")
  assignedOfficerId String?
  priority          String   @default("NORMAL")
  deadline          String?
  aiReadinessScore  Float?
  financialRisk     String? // LOW, MEDIUM, HIGH
  studyGapRisk      String?
  sponsorRisk       String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([studentId])
  @@index([visaStage])
  @@index([assignedOfficerId])
}

// ============================================================
// TIMELINE - Student journey events (CRM timeline)
// ============================================================

model TimelineEvent {
  id          String   @id @default(cuid())
  studentId   String?
  student     Student? @relation(fields: [studentId], references: [id])
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id])
  userId      String? // who performed the action
  user        User?    @relation(fields: [userId], references: [id])
  type        String // LEAD_CREATED, PROFILE_UPDATED, DOC_UPLOADED, DOC_APPROVED, APP_STATUS_CHANGED, VISA_STATUS_CHANGED, INTERVIEW_COMPLETED, MOCK_TEST_DONE, AI_ACTION, MESSAGE_SENT, PAYMENT, NOTE
  title       String
  description String?
  meta        String? // JSON
  createdAt   DateTime @default(now())

  @@index([studentId])
  @@index([leadId])
}

// ============================================================
// AUDIT LOG - Security & compliance
// ============================================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // LOGIN, FAILED_LOGIN, LOGOUT, PROFILE_UPDATE, DOC_UPLOAD, DOC_APPROVE, DOC_REJECT, APP_STATUS_CHANGE, VISA_STATUS_CHANGE, MOCK_CREDIT_CHANGE, PAYMENT_UPDATE, COMMISSION_APPROVE, SALARY_ACCESS, ROLE_CHANGE, PERMISSION_CHANGE, AI_ACTION, MESSAGE_ACTION, DATA_IMPORT, PUBLIC_PUBLISH
  resource   String?
  resourceId String?
  details    String? // JSON
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
}

// ============================================================
// MARKETING CAMPAIGNS
// ============================================================

model Campaign {
  id               String   @id @default(cuid())
  name             String
  channel          String // FACEBOOK, INSTAGRAM, WHATSAPP, WEBSITE, GOOGLE, EMAIL, EVENT
  status           String   @default("DRAFT") // DRAFT, ACTIVE, PAUSED, COMPLETED
  budget           Float?
  spent            Float    @default(0)
  leadsCount       Int      @default(0)
  conversionsCount Int      @default(0)
  startDate        String?
  endDate          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([channel])
  @@index([status])
}

// ============================================================
// PAYMENTS / COMMISSION / FINANCE
// ============================================================

model Payment {
  id               String   @id @default(cuid())
  paymentId        String   @unique
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type             String // APPLICATION_FEE, DEPOSIT, TUITION, SERVICE_CHARGE, MOCK_TEST, COMMISSION
  amount           Float
  currency         String   @default("BDT")
  status           String   @default("PENDING") // PENDING, PAID, REFUNDED
  method           String? // CASH, BANK_TRANSFER, CARD, MOBILE_BANKING
  partnerId        String?
  commissionAmount Float?
  commissionStatus String? // PENDING, APPROVED, PAID
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([studentId])
  @@index([status])
}

// ============================================================
// AI COMMAND CENTER - Departments & Agents
// ============================================================

model AiAgent {
  id               String    @id @default(cuid())
  department       String // Student Admission, Counseling, Application, Visa, Marketing, WhatsApp, Social Media, English Test, AI Interview, Document Checking, SOP/CV, University Data, Course Finder, Finance, HRM, Reports, Security/RBAC, Audit
  agentName        String
  agentCode        String
  description      String?
  status           String    @default("ACTIVE") // ACTIVE, IDLE, PAUSED
  jobsProcessed    Int       @default(0)
  pendingApprovals Int       @default(0)
  lastRunAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([department])
}

// ============================================================
// PUBLIC WEBSITE CONTENT - Country / University / Course / Exam pages
// All content is ALO-original, with source verification metadata.
// ============================================================

model CountryPage {
  id                 String    @id @default(cuid())
  slug               String    @unique // uk, canada, australia, usa, germany
  name               String // United Kingdom
  shortName          String // UK
  flag               String // emoji
  capital            String
  currency           String
  intro              String // hero subtitle
  quickFacts         String    @default("{}") // JSON: cities, intakes, studyLevels, duration, tuitionRange, livingCost, workRights, postStudyRoute, englishTests, visaType
  whyStudy           String    @default("[]") // JSON array: [{icon, heading, explanation}]
  pathway            String    @default("{}") // JSON education pathway
  popularCourses     String    @default("[]") // JSON: [{name, level, career}]
  entryRequirements  String    @default("{}") // JSON by level: foundation/bachelor/topup/masters/mba/phd
  documents          String    @default("[]") // JSON: [{category, name, required, explanation}]
  visaProcess        String    @default("[]") // JSON array of steps
  interviewTypes     String    @default("[]") // JSON
  workRights         String    @default("{}") // JSON: termTimeWork, vacationWork, postStudyRoute, sourceUrl
  scholarships       String    @default("[]") // JSON array
  cities             String    @default("[]") // JSON: [{name, costLevel, vibe, universities, transport, jobs, livingCost}]
  faqs               String    @default("[]") // JSON: [{q, a}]
  sourceUrl          String?
  lastVerifiedAt     DateTime?
  verificationStatus String    @default("VERIFIED") // VERIFIED, NEEDS_REVIEW, UNVERIFIED
  approvalStatus     String    @default("PUBLISHED") // DRAFT, PENDING_REVIEW, PUBLISHED
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  universities UniversityPage[]
}

model UniversityPage {
  id                 String      @id @default(cuid())
  slug               String      @unique
  name               String
  countrySlug        String
  country            CountryPage @relation(fields: [countrySlug], references: [slug])
  city               String
  overview           String // ALO-written summary
  strengths          String      @default("[]") // JSON array
  quickFacts         String      @default("{}") // JSON: intakes, tuitionRange, englishTests, scholarship, applicationStatus
  entryRequirements  String      @default("{}") // JSON by level
  tuition            String      @default("{}") // JSON: ug, pg, mba, deposit, scholarship, paymentPlan
  applicationSteps   String      @default("[]") // JSON
  documents          String      @default("[]") // JSON
  faqs               String      @default("[]")
  sourceUrl          String?
  lastVerifiedAt     DateTime?
  verificationStatus String      @default("VERIFIED")
  approvalStatus     String      @default("PUBLISHED")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  courses CoursePage[]
}

model CoursePage {
  id                  String         @id @default(cuid())
  slug                String         @unique
  name                String
  universitySlug      String
  university          UniversityPage @relation(fields: [universitySlug], references: [slug])
  countrySlug         String
  city                String
  level               String // Foundation, Bachelor, Masters, MBA, PhD
  subject             String // Computer Science, Business, etc.
  duration            String
  intake              String
  tuition             String
  scholarship         String?
  englishRequirement  String
  academicRequirement String
  overview            String
  modules             String         @default("[]") // JSON
  careerOutcomes      String         @default("[]") // JSON
  documents           String         @default("[]") // JSON
  faqs                String         @default("[]")
  deadline            String?
  sourceUrl           String?
  lastVerifiedAt      DateTime?
  verificationStatus  String         @default("VERIFIED")
  approvalStatus      String         @default("PUBLISHED")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model ExamPage {
  id                 String    @id @default(cuid())
  slug               String    @unique // ielts, pte, toefl, duolingo, ellt, gre, gmat, sat, act, placement
  name               String // IELTS, PTE Academic
  fullName           String // International English Language Testing System
  intro              String
  whatIs             String // ALO-written explanation
  modules            String    @default("[]") // JSON
  mockRules          String    @default("[]") // JSON
  freeQuota          String    @default("{}") // JSON: aloStudents, guestStudents
  examExperience     String    @default("[]") // JSON: timer, audio, etc.
  aiScoring          String    @default("{}") // JSON
  speakingPractice   String    @default("{}")
  writingReview      String    @default("{}")
  resultReport       String    @default("[]") // JSON
  pricing            String    @default("{}") // JSON
  faqs               String    @default("[]")
  disclaimer         String
  sourceUrl          String?
  lastVerifiedAt     DateTime?
  verificationStatus String    @default("VERIFIED")
  approvalStatus     String    @default("PUBLISHED")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// ============================================================
// COUNSELOR PORTAL & EMPLOYEE HR MODELS
// ============================================================

model EmployeeHR {
  id                 String   @id @default(cuid())
  userId             String   @unique
  employeeId         String   @unique // AE-EMP-XXXXX
  officialEmail      String
  officialPhone      String
  branch             String   @default("Dhaka HQ")
  designation        String
  department         String
  joiningDate        String
  employmentType     String   @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, PROBATION
  status             String   @default("ACTIVE") // ACTIVE, ON_LEAVE, RESIGNED, TERMINATED
  // Salary & compensation (private — visible only with permission)
  baseSalary         Float    @default(0)
  salaryCurrency     String   @default("BDT")
  // Performance
  performanceScore   Float    @default(0) // 0-100
  targetLeads        Int      @default(0)
  achievedLeads      Int      @default(0)
  targetConversion   Float    @default(0)
  achievedConversion Float    @default(0)
  // Manager
  managerId          String?
  // Documents
  documents          String   @default("[]") // JSON array of {name, type, uploadedAt}
  warnings           String   @default("[]") // JSON
  managerFeedback    String   @default("[]") // JSON
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@index([branch])
}

model EmployeeAttendance {
  id        String   @id @default(cuid())
  userId    String
  date      String // YYYY-MM-DD
  checkIn   String?
  checkOut  String?
  status    String   @default("PRESENT") // PRESENT, ABSENT, LEAVE, LATE, HALF_DAY, HOLIDAY
  workHours Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([date])
}

model EmployeeCommission {
  id            String   @id @default(cuid())
  userId        String
  studentId     String?
  applicationId String?
  amount        Float
  currency      String   @default("BDT")
  status        String   @default("PENDING") // PENDING, APPROVED, PAID
  month         String // YYYY-MM
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model EmployeeBonus {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  currency  String   @default("BDT")
  reason    String
  month     String
  status    String   @default("PENDING") // PENDING, APPROVED, PAID
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmployeeIncrement {
  id            String   @id @default(cuid())
  userId        String
  oldSalary     Float
  newSalary     Float
  percentage    Float
  effectiveDate String
  reason        String?
  approvedBy    String?
  createdAt     DateTime @default(now())

  @@index([userId])
}

model EmployeePerformance {
  id                String   @id @default(cuid())
  userId            String
  period            String // YYYY-MM or YYYY-Qn
  score             Float // 0-100
  leadsHandled      Int      @default(0)
  conversionRate    Float    @default(0)
  satisfactionScore Float    @default(0)
  slaCompliance     Float    @default(0) // percentage
  notes             String?
  createdAt         DateTime @default(now())

  @@index([userId])
}

// ============================================================
// PERMISSION & RBAC MODELS
// ============================================================

model Permission {
  id              String           @id @default(cuid())
  module          String // Student, Documents, Communication, Application, Visa, Marketing, HR Self, Private HR
  feature         String // e.g. "students.view_assigned"
  action          String // view, create, update, approve, export, download
  description     String
  defaultRoles    String           @default("[]") // JSON array of roles that get this by default
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())

  @@unique([module, feature, action])
  @@index([module])
}

model RolePermission {
  id           String     @id @default(cuid())
  role         String // SUPER_ADMIN, ADMIN, COUNSELOR, etc.
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  scope        String     @default("ASSIGNED_ONLY") // OWN_ONLY, ASSIGNED_ONLY, ALL
  grantedBy    String?
  createdAt    DateTime   @default(now())

  @@unique([role, permissionId])
  @@index([role])
}

// ============================================================
// TASKS, APPOINTMENTS, SLA
// ============================================================

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
