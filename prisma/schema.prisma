  email           String    @default("")
  phone           String    @default("")
  password        String    @default("")
  userType        String    @default("ALO_FULL_STUDENT")
  status          String    @default("active")
  profileComplete Int       @default(0)
  journeyStage    String    @default("lead_created")
  currentCountry  String    @default("")
  currentCity     String    @default("")
  counselorId     String?
