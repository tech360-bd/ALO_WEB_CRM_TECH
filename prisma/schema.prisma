// ==========================================
// ENTERPRISE UNIFIED COMMUNICATION CENTER (UCC)
// ==========================================

model SocialIntegration {
  id                String    @id @default(cuid())
  provider          String // whatsapp, meta_business, facebook_page, instagram, google_analytics, google_search_console, youtube, telegram, smtp_email, sms_provider
  name              String
  status            String    @default("disconnected") // connected, disconnected, expired, error
  connectedAccount  String?
  businessAccountId String?
  accessToken       String?
  refreshToken      String?
  tokenExpiresAt    DateTime?
  webhookStatus     String    @default("inactive") // active, inactive, error
  webhookSecret     String?
  apiVersion        String    @default("v19.0")
  healthStatus      String    @default("healthy") // healthy, warning, degraded
  lastSyncAt        DateTime?
  metadata          String    @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts SocialAccount[]
}

model SocialAccount {
  id            String   @id @default(cuid())
  integrationId String
  provider      String
  assetId       String // Page ID, Phone Number ID, Channel ID, Property ID
  assetName     String
  assetType     String // facebook_page, whatsapp_number, instagram_business, youtube_channel, ga_property
  phoneNumber   String?
  isPrimary     Boolean  @default(false)
  status        String   @default("active")
  metadata      String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  integration SocialIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

model UccConversation {
  id                 String   @id @default(cuid())
  channel            String // whatsapp, facebook, instagram, live_chat, portal, email, sms, internal, telegram
  channelAccountId   String?
  externalId         String? // Message thread ID or Phone Number
  participantName    String
  participantPhone   String?
  participantEmail   String?
  studentId          String?
  leadId             String?
  assignedToUserId   String?
  assignedRole       String?
  destinationCountry String?
  status             String   @default("open") // open, pending, closed, snoozed
  priority           String   @default("normal") // low, normal, high, urgent
  lastMessageText    String?
  lastMessageAt      DateTime @default(now())
  unreadCount        Int      @default(0)
  tags               String   @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  messages    UccMessage[]
  attachments UccAttachment[]
}

model UccMessage {
  id             String   @id @default(cuid())
  conversationId String
  direction      String // inbound, outbound, system, internal_note
  senderId       String?
  senderName     String
  senderRole     String   @default("user") // student, employee, system, ai
  channel        String
  content        String
  messageType    String   @default("text") // text, image, document, voice, video, location, template
  status         String   @default("sent") // sent, delivered, read, failed
  aiGenerated    Boolean  @default(false)
  aiApproved     Boolean  @default(true)
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())

  conversation UccConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  UccAttachment[]
}

model UccAttachment {
  id               String   @id @default(cuid())
  conversationId   String
  messageId        String?
  fileName         String
  fileType         String // document, passport, visa, transcript, cv, sop, bank_statement, image
  mimeType         String
  fileSize         Int
  fileUrl          String
  detectedDocType  String? // passport, offer_letter, cas, ielts, transcript
  studentId        String?
  applicationId    String?
  ocrExtractedData String   @default("{}")
  createdAt        DateTime @default(now())

  conversation UccConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      UccMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
}

model UccRoutingRule {
