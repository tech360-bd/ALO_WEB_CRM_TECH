model Department {
  id          String     @id @default(cuid())
  name        String
  code        String     @unique
  description String?
  status      String     @default("ACTIVE")
  createdAt   DateTime   @default(now())
  employees   Employee[]
}

model Office {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  address   String?
  city      String?
  country   String?
  phone     String?
  status    String     @default("ACTIVE")
  createdAt DateTime   @default(now())
  employees Employee[]
}

model Employee {
  id                  String      @id @default(cuid())
  employeeCode        String      @unique // AE-EMP-XXXXX
  userId              String? // link to User (for login)
  fullName            String
  companyEmail        String      @unique
  personalEmail       String?
  phone               String?
  designation         String // Chairman, CEO, Director, Office Manager, Country Manager, Counselor, Senior Counselor, Application Manager, Application Team, Visa Officer, Finance Officer, Marketing Manager, Marketing Officer, Front Desk, HR Manager, Support Staff, Viewer
  departmentId        String?
  department          Department? @relation(fields: [departmentId], references: [id])
  officeId            String?
  office              Office?     @relation(fields: [officeId], references: [id])
  joiningDate         String
  employmentType      String      @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, PROBATION
  reportingManagerId  String?
  profileStatus       String      @default("INCOMPLETE") // INCOMPLETE, SUBMITTED, UNDER_REVIEW, APPROVED, CORRECTION_REQUIRED, SUSPENDED, INACTIVE, TERMINATED
  status              String      @default("ACTIVE") // ACTIVE, SUSPENDED, INACTIVE, TERMINATED
  workSchedule        String?
  weeklyHoliday       String?
  role                String      @default("STAFF") // maps to User.role for RBAC
  permissionPackageId String? // assigned partner/employee package
  createdById         String? // who created this employee (Super Admin)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  profile            EmployeeProfile?
  education          EmployeeEducation[]
  emergencyContacts  EmployeeEmergencyContact[]
  salary             EmployeeSalary?
  documents          EmployeeDocument[]
  activationTokens   EmployeeActivationToken[]
  packageAssignments PartnerPackageAssignment[]
  quotaRequests      ExtraQuotaRequest[]

  @@index([designation])
  @@index([departmentId])
  @@index([officeId])
  @@index([profileStatus])
  @@index([status])
}

model EmployeeProfile {
  id               String   @id @default(cuid())
  employeeId       String   @unique
  dob              String?
  gender           String?
  maritalStatus    String?
  nationality      String   @default("Bangladeshi")
  presentAddress   String?
  permanentAddress String?
  photo            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model EmployeeEducation {
  id              String   @id @default(cuid())
  employeeId      String
  degree          String
  institution     String
  passingYear     String
  result          String?
  certificatePath String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model EmployeeEmergencyContact {
  id         String   @id @default(cuid())
  employeeId String
  name       String
  relation   String
  phone      String
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model EmployeeSalary {
  id            String   @id @default(cuid())
  employeeId    String   @unique
  salaryAmount  Float
  allowance     Float    @default(0)
  bonus         Float    @default(0)
