}

model StudentEnglishTest {
  id             String   @id @default(cuid())
  studentId      String
  testType       String
  overallScore   Float    @default(0)
  readingScore   Float    @default(0)
  writingScore   Float    @default(0)
  listeningScore Float    @default(0)
  speakingScore  Float    @default(0)
  testDate       String   @default("")
  certificateUrl String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StudentWorkExperience {
  id          String   @id @default(cuid())
  studentId   String
  company     String   @default("")
  position    String   @default("")
  startDate   String   @default("")
  endDate     String   @default("")
  description String   @default("")
  letterUrl   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StudentRecommendation {
  id              String   @id @default(cuid())
  studentId       String
  refereeName     String   @default("")
  refereePosition String   @default("")
  refereeEmail    String   @default("")
  refereeOrg      String   @default("")
