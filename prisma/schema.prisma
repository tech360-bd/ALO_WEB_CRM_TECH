  title             String
  shortDescription  String
  description       String
  icon              String
  heroImage         String?
  content           String   // JSON: { whatItIs, whyItMatters, whoNeedsIt, whatAloHelpsWith, process[], timeline, fees }
  eligibility       String?
  requirements      String?  // JSON array
  documents         String?  // JSON array
