  dateOfBirth    String   @default("")
  expiryDate     String   @default("")
  issueDate      String   @default("")
  passportUrl    String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StudentEnglishTest {
