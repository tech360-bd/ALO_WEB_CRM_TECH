  sentAt                DateTime?
  emailSentAt           DateTime?
  whatsappSentAt        DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([applicationId])
  @@index([studentId])
}

model DocumentVersion {
  id              String    @id @default(cuid())
  documentId      String                    // links to StudentDocument
  studentId       String    @default("")
  applicationId   String    @default("")
  versionNumber   Int       @default(1)
  fileUrl         String    @default("")
  fileName        String    @default("")
  fileSize        Int       @default(0)
  fileHash        String    @default("")
  status          String    @default("uploaded")  // uploaded | under_review | verified | rejected | superseded
  rejectionReason String    @default("")
  uploadedAt      DateTime  @default(now())
  reviewedBy      String    @default("")
  reviewedAt      DateTime?
  studentComment  String    @default("")
  internalNote    String    @default("")

  @@index([documentId])
  @@index([studentId])
}

model ApplicationComment {
  id              String   @id @default(cuid())
  applicationId   String
  studentId       String   @default("")
  commentType     String   @default("student_visible")  // student_visible | internal_only
  authorId        String   @default("")
  authorName      String   @default("")
  authorType      String   @default("counselor")   // student | counselor | admin | system
  content         String
  attachmentUrl   String   @default("")
  attachmentName  String   @default("")
  notifyStudent   Boolean  @default(false)
  emailSent       Boolean  @default(false)
  whatsappSent    Boolean  @default(false)
  readByStudent   Boolean  @default(false)
  readAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([applicationId])
  @@index([studentId])
  @@index([commentType])
}

// --- Interview Intelligence ---

model InterviewProgram {
  id               String   @id @default(cuid())
  applicationId    String   @unique
  studentId        String   @default("")
  universityName   String   @default("")
  courseName       String   @default("")
  country          String   @default("")
  researchStatus   String   @default("pending")   // pending | researching | ready
  researchData     String   @default("{}")         // RAG + agent research results
  researchSourceCount Int   @default(0)
  researchLastUpdated DateTime?
  questionsGenerated Boolean @default(false)
  questionCount    Int      @default(0)
  answersGenerated Boolean  @default(false)
  pdfGenerated     Boolean  @default(false)
  pdfVersion       Int      @default(0)
  practiceWindowStart DateTime?
  practiceWindowEnd   DateTime?
  practiceWindowHours Int   @default(72)
  sessionCount     Int      @default(0)
  aiReadiness      String   @default("not_assessed")  // not_assessed | needs_practice | ready_with_improvement | ready
  humanReadiness   String   @default("not_reviewed")  // not_reviewed | needs_practice | ready | not_ready
  humanReviewerId  String   @default("")
  humanReviewedAt  DateTime?
  humanReviewNote  String   @default("")
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  questions        InterviewQuestion[]
  answers          InterviewStudentAnswer[]
  sessions         InterviewPracticeSession[]
  pdfRecords       InterviewPdfRecord[]

  @@index([applicationId])
  @@index([studentId])
}

model InterviewQuestion {
  id               String   @id @default(cuid())
  programId        String
  category         String   @default("general")  // university | course | country | visa | financial | future_plan | academic | english | credibility | personal
  question         String
  purpose          String   @default("")    // what the interviewer wants to understand
  difficulty       String   @default("medium")  // easy | medium | hard
  frequency        String   @default("common")  // rare | occasional | common | very_common
  sourceType       String   @default("ai_generated")  // ai_generated | historical | official | counselor
  sourceDetail     String   @default("")
  lastVerified     DateTime?
  confidenceLevel  String   @default("medium")  // low | medium | high
  followUpQuestions String  @default("[]")  // JSON array
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  program          InterviewProgram @relation(fields: [programId], references: [id])

  @@index([programId])
  @@index([category])
}

model InterviewStudentAnswer {
  id               String   @id @default(cuid())
  programId        String
  studentId        String   @default("")
  questionId       String   @default("")
  questionText     String
  category         String   @default("")
  studentFactsProvided String @default("{}")   // raw student inputs
  naturalAnswer    String   @default("")       // AI-drafted natural answer
  shortAnswer      String   @default("")
  expandedAnswer   String   @default("")
  keyPoints        String   @default("[]")
  thingsToAvoid    String   @default("[]")
  followUpAnswers  String   @default("{}")
  aiGenerated      Boolean  @default(true)
  studentReviewed  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  program          InterviewProgram @relation(fields: [programId], references: [id])

  @@index([programId])
  @@index([studentId])
}

model InterviewPracticeSession {
  id               String   @id @default(cuid())
  programId        String
  studentId        String   @default("")
  applicationId    String   @default("")
  sessionType      String   @default("text")   // text | voice | video
  status           String   @default("active")  // active | completed | expired
  questionsAsked   String   @default("[]")
  answers          String   @default("[]")
  transcript       String   @default("[]")
  videoUrl         String   @default("")
  audioUrl         String   @default("")
  aiScores         String   @default("{}")
  weakAreas        String   @default("[]")
  improvementTips  String   @default("[]")
  sessionDuration  Int      @default(0)   // seconds
  startedAt        DateTime @default(now())
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  program          InterviewProgram @relation(fields: [programId], references: [id])

  @@index([programId])
  @@index([studentId])
}

model InterviewPdfRecord {
  id               String   @id @default(cuid())
  programId        String
  studentId        String   @default("")
  applicationId    String   @default("")
  pdfType          String   @default("full_pack")  // full_pack | questions_only | answers_only | financial | future_plan | checklist
  versionNumber    Int      @default(1)
  fileUrl          String   @default("")
  fileName         String   @default("")
  generatedBy      String   @default("system")
  downloadedBy     String   @default("")
  downloadedAt     DateTime?
  downloadCount    Int      @default(0)
  practiceWindowStartedAt DateTime?
  createdAt        DateTime @default(now())

  program          InterviewProgram @relation(fields: [programId], references: [id])

  @@index([programId])
  @@index([studentId])
}

// --- Student World State + Next Best Action ---

model StudentWorldState {
  id               String   @id @default(cuid())
  studentId        String   @unique
  goal             String   @default("")
  targetCountries  String   @default("[]")
  targetCourses    String   @default("[]")
  targetIntakes    String   @default("[]")
  academicState    String   @default("incomplete")
  englishState     String   @default("unknown")
  financialState   String   @default("unknown")
  applicationState String   @default("none")
  documentState    String   @default("none")
  interviewState   String   @default("none")
  visaState        String   @default("none")
  riskLevel        String   @default("low")
  engagementScore  Int      @default(50)
  lastLoginAt      DateTime?
  lastActionAt     DateTime?
  nextBestActions  String   @default("[]")
  updatedAt        DateTime @updatedAt

  @@index([studentId])
}

model StudentNextBestAction {
  id               String   @id @default(cuid())
  studentId        String
  applicationId    String   @default("")
  priority         String   @default("medium")   // urgent | high | medium | low
  category         String   @default("document") // document | application | payment | interview | visa | general
  title            String
  description      String   @default("")
  actionType       String   @default("manual")   // manual | auto | ai_assisted
  actionUrl        String   @default("")
  dueDate          DateTime?
  isCompleted      Boolean  @default(false)
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([studentId])
  @@index([priority])
}

model StudentEvent {
  id               String   @id @default(cuid())
  studentId        String
  applicationId    String   @default("")
  eventType        String                       // DOCUMENT_UPLOADED | OFFER_RECEIVED | PAYMENT_VERIFIED | etc
  eventData        String   @default("{}")
  actorId          String   @default("")
  actorType        String   @default("system")  // student | counselor | system | ai
  actorName        String   @default("")
  ipAddress        String   @default("")
  channel          String   @default("")
  createdAt        DateTime @default(now())

  @@index([studentId])
  @@index([eventType])
  @@index([applicationId])
}

// --- Success + Alumni ---

model SuccessRecord {
  id               String   @id @default(cuid())
  studentId        String
  applicationId    String   @default("")
  studentCode      String   @default("")
  studentName      String   @default("")
  universityName   String   @default("")
  courseName       String   @default("")
  country          String   @default("")
  intake           String   @default("")
  visaApprovedAt   DateTime?
  successDate      DateTime @default(now())
  reviewRequestSent Boolean @default(false)
  reviewRequestSentAt DateTime?
  googleReviewLink String   @default("")
  facebookReviewLink String  @default("")
  testimonialConsent Boolean @default(false)
  testimonialText  String   @default("")
  publishedOnWebsite Boolean @default(false)
  publishApprovedBy String  @default("")
  publishApprovedAt DateTime?
  alumniId         String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  reviewRequests   ReviewRequest[]

  @@index([studentId])
}

model ReviewRequest {
  id               String   @id @default(cuid())
  successId        String
  studentId        String   @default("")
  requestType      String   @default("google")  // google | facebook | alo_testimonial
  requestSentAt    DateTime?
  reviewLink       String   @default("")
  qrCodeUrl        String   @default("")
  reviewSubmitted  Boolean  @default(false)
  reviewText       String   @default("")
  reviewRating     Int?
  reviewSubmittedAt DateTime?
  consentGiven     Boolean  @default(false)
  consentGivenAt   DateTime?
  status           String   @default("sent")  // sent | submitted | declined
  createdAt        DateTime @default(now())

  success          SuccessRecord @relation(fields: [successId], references: [id])

  @@index([successId])
  @@index([studentId])
}

model AlumniRecord {
  id               String   @id @default(cuid())
  studentId        String   @unique
  studentCode      String   @default("")
  studentName      String   @default("")
  universityName   String   @default("")
  country          String   @default("")
  courseName       String   @default("")
  intake           String   @default("")
  graduationYear   String   @default("")
  currentLocation  String   @default("")
  currentOccupation String  @default("")
  referralPreference Boolean @default(false)
  communicationPreference String @default("email")
  linkedinUrl      String   @default("")
  testimonialId    String   @default("")
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([studentId])
}

// --- No-Service-Charge Declaration ---

model ServiceChargeDeclaration {
  id               String   @id @default(cuid())
  studentId        String
  applicationId    String
  studentName      String   @default("")
  studentCode      String   @default("")
  universityName   String   @default("")
  declarationText  String                    // locked at signing time
  templateVersion  String   @default("v1")
  signedAt         DateTime @default(now())
  signedByStudentId String  @default("")
  ipAddress        String   @default("")
  sessionId        String   @default("")
  deviceInfo       String   @default("")
  isValid          Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([studentId])
  @@index([applicationId])
}

// --- Student Auth (portal-specific) ---

model StudentSession {
  id               String   @id @default(cuid())
  studentId        String
  token            String   @unique
  ipAddress        String   @default("")
  userAgent        String   @default("")
  deviceInfo       String   @default("")
  expiresAt        DateTime
  lastActiveAt     DateTime @default(now())
  revokedAt        DateTime?
  revokedReason    String   @default("")
  createdAt        DateTime @default(now())

  @@index([studentId])
  @@index([token])
}

model StudentLoginAttempt {
  id               String   @id @default(cuid())
  email            String   @default("")
  phone            String   @default("")
  studentId        String   @default("")
  success          Boolean  @default(false)
  failureReason    String   @default("")
  ipAddress        String   @default("")
  userAgent        String   @default("")
  createdAt        DateTime @default(now())

  @@index([email])
  @@index([studentId])
}

// --- B2B Provider & Application Management ---

model B2bProvider {
  id                 String           @id @default(cuid())
  providerCode       String           @unique
  name               String
  providerType       String           @default("GLOBAL_B2B")
  countryCoverage    String           @default("[]")
  universityCoverage String           @default("[]")
  contactPerson      String           @default("")
  email              String           @default("")
  phone              String           @default("")
  portalUrl          String           @default("")
  loginNote          String           @default("")
  agreementFile      String           @default("")
  commissionRule     String           @default("")
  paymentCondition   String           @default("")
  claimStage         String           @default("ENROLLMENT")
  status             String           @default("ACTIVE")
  createdBy          String           @default("")
  approvedBy         String           @default("")
  lastReviewedAt     DateTime?
  internalNote       String           @default("")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  applications       B2bApplication[]

  @@index([providerCode])
  @@index([status])
}

model B2bApplication {
  id                    String       @id @default(cuid())
  applicationId         String       @unique
  b2bProviderId         String
  b2bType               String       @default("B2B_OUTBOUND")
  b2bReference          String       @default("")
  submissionRoute       String       @default("PORTAL")
  submittedDate         DateTime?
  acknowledgementNumber String       @default("")
  b2bStatus             String       @default("SUBMITTED")
  b2bCommissionType     String       @default("PERCENTAGE")
  b2bCommissionAmount   Float        @default(0)
  b2bPaymentCondition   String       @default("")
  b2bClaimStage         String       @default("ENROLLMENT")
  b2bInternalNote       String       @default("")
  lastFollowupAt        DateTime?
  nextFollowupAt        DateTime?
  createdBy             String       @default("")
  updatedBy             String       @default("")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  provider              B2bProvider  @relation(fields: [b2bProviderId], references: [id], onDelete: Cascade)

  @@index([b2bProviderId])
  @@index([b2bStatus])
}

model ApplicationDeadline {
  id           String    @id @default(cuid())
  applicationId String
  deadlineType String
  deadlineDate DateTime
  status       String    @default("PENDING")
  assignedTo   String    @default("")
  reminderSent Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([applicationId])
  @@index([deadlineDate])
}

model ApplicationTask {
  id              String    @id @default(cuid())
  applicationId   String
  taskTitle       String
  taskDescription String    @default("")
  assignedTo      String    @default("")
  priority        String    @default("NORMAL")
  status          String    @default("PENDING")
  dueDate         DateTime?
  createdBy       String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([applicationId])
  @@index([assignedTo])
}

model ApplicationSubmissionReceipt {
  id                    String    @id @default(cuid())
  applicationId         String
  submissionMethod      String    @default("DIRECT_UNIVERSITY_PORTAL")
  submittedBy           String    @default("")
  submittedTo           String    @default("")
  submissionDate        DateTime  @default(now())
  acknowledgementNumber String    @default("")
  portalReference       String    @default("")
  universityAppId       String    @default("")
  appFeeStatus          String    @default("PAID")
  receiptFileUrl        String    @default("")
  expectedResponseDate  DateTime?
  followupDate          DateTime?
  submissionNote        String    @default("")
  createdAt             DateTime  @default(now())

  @@index([applicationId])
}


