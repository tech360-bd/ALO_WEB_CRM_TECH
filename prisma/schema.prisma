}

model TestAnswer {
  id          String   @id @default(cuid())
  sessionId   String
  section     String
  questionNum Int
  answer      String   @default("")
  isCorrect   Boolean  @default(false)
  score       Float    @default(0)
  createdAt   DateTime @default(now())
}

model TestResult {
  id             String   @id @default(cuid())
