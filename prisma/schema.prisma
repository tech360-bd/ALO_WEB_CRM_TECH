  id                 String   @id @default(cuid())
  title              String
  slug               String   @unique
  countrySlug        String   @default("") // UK, USA, Canada, Australia, etc
  region             String   @default("") // Europe, North America, Asia, etc
  strategyType       String   @default("RAPID_PARTNERSHIP") // RAPID_PARTNERSHIP, RESEARCH_COLLABORATION, AGENT_AGREEMENT, COMMISSION_BASED
  description        String   @db.LongText
  bestMethods        String   @db.LongText // JSON or markdown: best methods for rapidly establishing partnerships
  bestLocations      String   @db.LongText // JSON or markdown: best locations/cities/universities for partnerships
  targetUniversities String   @default("[]") // JSON array of university slugs
  contactStrategy    String   @db.LongText // How to communicate, leverage research data, expand business
  researchLeverage   String   @db.LongText // How to leverage research data
  businessExpansion  String   @db.LongText // How to expand business through partnerships
  status             String   @default("ACTIVE") // ACTIVE, DRAFT, ARCHIVED
  createdById        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([countrySlug])
  @@index([region])
  @@index([strategyType])
  @@index([status])
}

model InternationalOfficerDashboardMetric {
  id           String   @id @default(cuid())
  officerId    String?
  metricType   String // TOTAL_UNIVERSITIES_RESEARCHED, ACTIVE_PARTNERSHIPS, PENDING_AGREEMENTS, EMAILS_SENT, MEETINGS_SCHEDULED, PARTNERSHIPS_ESTABLISHED, RESEARCH_EVIDENCE_COLLECTED
  value        Int      @default(0)
  period       String   @default("ALL_TIME") // ALL_TIME, THIS_MONTH, THIS_WEEK, TODAY
  calculatedAt DateTime @default(now())

  @@index([officerId])
  @@index([metricType])
  @@index([period])
}

// ─── Centralized verified marketing metrics (single source of truth) ─────────
// Any public marketing metric (university count, course count, scholarship
// count, visa success, student count, success stories, application count)
// must be read through src/lib/verified-metrics.ts instead of being hardcoded
// on pages. Governed rows carry source + verification metadata; anything
// without a verified source is surfaced with status UNVERIFIED and must not
// be presented as verified.
model VerifiedMetric {
  id           String    @id @default(cuid())
  metric       String    @unique // universities.total, courses.total, scholarships.total, countries.total, ...
  value        Int       @default(0)
  displayValue String    @default("") // governed display string, e.g. "360+"
  source       String    @default("internal-database-aggregate")
  verifiedAt   DateTime?
  verifiedBy   String? // user id or email of the verifier
  expiresAt    DateTime?
  status       String    @default("UNVERIFIED") // UNVERIFIED | UNDER_REVIEW | VERIFIED | EXPIRED
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([metric, status])
}

// ═══════════════════════════════════════════════════════════════════════════
// ACCOUNTING — real double-entry ledger (2026-10-01)
//
// Replaces the legacy journal adapter that persisted journals as JSON inside
// CrmAuditLog rows. Money is stored as INTEGER CENTS (never Float) and every
// entry is created inside a Prisma transaction with service-level balance
// enforcement; see src/lib/accounting/ledger.ts.
// ═══════════════════════════════════════════════════════════════════════════

model ChartOfAccount {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  type        String // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  subType     String? // e.g. CURRENT_ASSET, FIXED_ASSET, OPERATING_REVENUE
  parentCode  String?
  isPostable  Boolean  @default(true) // only leaf accounts accept journal lines
  isActive    Boolean  @default(true)
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines JournalLine[] @relation("ChartOfAccountLines")

  @@index([type])
  @@index([isActive])
}

model FiscalPeriod {
  id         String    @id @default(cuid())
  name       String    @unique // e.g. "2026-10"
  startDate  DateTime
  endDate    DateTime
  status     String    @default("OPEN") // OPEN | CLOSED
  closedById String?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([startDate, endDate])
}

model JournalEntry {
  id           String   @id // deterministic (je_<uuid> or je_inv_<invoiceId>) for idempotency
  entryDate    DateTime
  memo         String
  source       String   @default("manual") // finance.invoice | procurement.bill | payroll.run | asset.depreciation | reversal | manual
  sourceRefId  String? // business identifier for source-level idempotency
  status       String   @default("POSTED") // POSTED | REVERSED
  reversalOfId String?
  reversedById String?
  currency     String   @default("BDT")
  totalDebit   Int // cents; service-enforced equal to totalCredit
  totalCredit  Int // cents
  actorId      String
  postedAt     DateTime @default(now())
  createdAt    DateTime @default(now())

  lines JournalLine[]

  @@unique([source, sourceRefId])
  @@index([entryDate])
  @@index([status])
  @@index([source])
  @@index([reversalOfId])
}

model JournalLine {
  id          String         @id @default(cuid())
  entryId     String
  accountCode String
  accountName String // denormalized at posting time for immutable history
  debit       Int            @default(0) // cents, non-negative
  credit      Int            @default(0) // cents, non-negative
  entityId    String?
  entityType  String?
  entry       JournalEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account     ChartOfAccount @relation("ChartOfAccountLines", fields: [accountCode], references: [code])

  @@index([accountCode])
  @@index([entityType, entityId])
}

// ═══════════════════════════════════════════════════════════════════════════
// PROCUREMENT — vendor master, purchase requests, purchase orders, vendor
// invoices (2026-10-01). Approval-gated workflow that posts to the real
// accounting ledger. Money is INTEGER CENTS.
// ═══════════════════════════════════════════════════════════════════════════

model Vendor {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  legalName    String   @default("")
  taxId        String   @default("")
  category     String   @default("general") // general | it | marketing | travel | facilities | professional
  email        String   @default("")
  phone        String   @default("")
  address      String   @default("")
  country      String   @default("Bangladesh")
  paymentTerms String   @default("NET-30") // NET-7 | NET-15 | NET-30 | NET-60 | PREPAID
  bankDetails  String   @default("") // encrypted at rest by the storage layer; never rendered raw
  rating       Float    @default(0) // 0..5 vendor performance
  status       String   @default("ACTIVE") // ACTIVE | SUSPENDED | BLACKLISTED
  notes        String   @default("")
  createdById  String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  vendorInvoices VendorInvoice[]

  @@index([status])
  @@index([category])
  @@index([name])
}

model PurchaseRequest {
  id              String    @id @default(cuid())
  prNumber        String    @unique
  title           String
  description     String    @default("")
  requestedById   String
  departmentId    String    @default("")
  currency        String    @default("BDT")
  amount          Int // cents; sum of lines, service-verified
  status          String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED | CONVERTED | CANCELLED
  neededBy        DateTime?
  decidedById     String?
  decidedAt       DateTime?
  rejectionReason String    @default("")
  convertedPoId   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lines         PurchaseRequestLine[]
  purchaseOrder PurchaseOrder?

  @@index([status])
  @@index([requestedById])
  @@index([createdAt])
}

model PurchaseRequestLine {
  id          String          @id @default(cuid())
  requestId   String
  description String
  quantity    Int             @default(1)
  unitPrice   Int             @default(0) // cents
  amount      Int             @default(0) // cents; quantity * unitPrice, service-verified
  request     PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model PurchaseOrder {
  id               String    @id @default(cuid())
  poNumber         String    @unique
  requestId        String?   @unique
  vendorId         String
  orderDate        DateTime  @default(now())
  expectedDelivery DateTime?
  currency         String    @default("BDT")
  subtotal         Int       @default(0) // cents
  taxTotal         Int       @default(0) // cents
  total            Int       @default(0) // cents; subtotal + taxTotal, service-verified
  status           String    @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | SENT | PARTIALLY_RECEIVED | RECEIVED | CANCELLED
  approvedById     String?
  approvedAt       DateTime?
  rejectionReason  String    @default("")
  notes            String    @default("")
  journalEntryId   String? // AP posting once approved
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  vendor   Vendor              @relation(fields: [vendorId], references: [id])
  request  PurchaseRequest?    @relation(fields: [requestId], references: [id])
  lines    PurchaseOrderLine[]
  invoices VendorInvoice[]

  @@index([vendorId])
  @@index([status])
  @@index([orderDate])
}

model PurchaseOrderLine {
  id               String        @id @default(cuid())
  orderId          String
  description      String
  quantity         Int           @default(1)
  unitPrice        Int           @default(0) // cents
  amount           Int           @default(0) // cents
  receivedQuantity Int           @default(0)
  order            PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model VendorInvoice {
  id             String    @id @default(cuid())
  invoiceNumber  String
  vendorId       String
  poId           String?
  invoiceDate    DateTime
  dueDate        DateTime?
  currency       String    @default("BDT")
  subtotal       Int       @default(0) // cents
  taxTotal       Int       @default(0) // cents
  total          Int       @default(0) // cents
  amountPaid     Int       @default(0) // cents
  status         String    @default("RECEIVED") // RECEIVED | MATCHED | APPROVED | PARTIALLY_PAID | PAID | DISPUTED
  matchedById    String?
  matchedAt      DateTime?
  disputeReason  String    @default("")
  journalEntryId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vendor Vendor         @relation(fields: [vendorId], references: [id])
  po     PurchaseOrder? @relation(fields: [poId], references: [id])

  @@unique([vendorId, invoiceNumber])
  @@index([status])
  @@index([poId])
  @@index([invoiceDate])
}

// ═══════════════════════════════════════════════════════════════════════════
// ASSET MANAGEMENT — fixed assets, assignment history, maintenance,
// straight-line depreciation posted to the accounting ledger (2026-10-01).
// Money is INTEGER CENTS.
// ═══════════════════════════════════════════════════════════════════════════

model FixedAsset {
  id                      String    @id @default(cuid())
  assetTag                String    @unique
  name                    String
  category                String    @default("IT") // IT | FURNITURE | VEHICLE | EQUIPMENT | BUILDING
  description             String    @default("")
  serialNumber            String    @default("")
  purchaseDate            DateTime
  purchaseCost            Int // cents
  currency                String    @default("BDT")
  salvageValue            Int       @default(0) // cents
  usefulLifeMonths        Int       @default(36)
  vendorId                String?
  location                String    @default("")
  departmentId            String    @default("")
  assignedToId            String? // employee id when IN_USE
  status                  String    @default("IN_STORAGE") // IN_USE | IN_STORAGE | MAINTENANCE | RETIRED | DISPOSED
  disposalDate            DateTime?
  disposalAmount          Int? // cents
  accumulatedDepreciation Int       @default(0) // cents; denormalized from DepreciationEntry
  notes                   String    @default("")
  createdById             String    @default("")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  assignments  AssetAssignment[]
  maintenance  AssetMaintenance[]
  depreciation DepreciationEntry[]

  @@index([status])
  @@index([category])
  @@index([assignedToId])
}

model AssetAssignment {
  id           String     @id @default(cuid())
  assetId      String
  assignedToId String // employee id
  assignedAt   DateTime   @default(now())
  returnedAt   DateTime?
  conditionOut String     @default("GOOD") // GOOD | FAIR | POOR
  conditionIn  String?
  notes        String     @default("")
  asset        FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([assignedToId])
}

model AssetMaintenance {
  id              String     @id @default(cuid())
  assetId         String
  maintenanceDate DateTime
  type            String     @default("PREVENTIVE") // PREVENTIVE | REPAIR | INSPECTION | UPGRADE
  cost            Int        @default(0) // cents
  description     String     @default("")
  performedBy     String     @default("")
  nextDueAt       DateTime?
  asset           FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([nextDueAt])
}

model DepreciationEntry {
  id                 String   @id @default(cuid())
  assetId            String
  period             String // YYYY-MM
  depreciationAmount Int // cents
  accumulatedAfter   Int // cents; running total after this entry
  journalEntryId     String? // DR 5200 / CR 1510 posting
  createdAt          DateTime @default(now())

  asset FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, period])
  @@index([period])
}

// ═══════════════════════════════════════════════════════════════════════════
// AI MODEL REGISTRY — versioned models with evaluation gates, department
// assignment, deployment promotion and rollback (2026-10-01). Implements the
// department-specialized AI system objective with persisted evidence.
// ═══════════════════════════════════════════════════════════════════════════

model AiModel {
  id               String   @id @default(cuid())
  modelCode        String   @unique // e.g. alo-admissions-v1
  name             String
  taskType         String   @default("general") // counseling | matching | verification | content | analysis | general
  description      String   @default("")
  status           String   @default("REGISTERED") // REGISTERED | EVALUATING | STAGING | PRODUCTION | RETIRED
  currentVersionId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  versions    AiModelVersion[]
  deployments AiModelDeployment[]           @relation("AiModelDeployments")
  departments AiModelDepartmentAssignment[]

  @@index([status])
  @@index([taskType])
}

model AiModelVersion {
  id             String   @id @default(cuid())
  modelId        String
  version        Int      @default(1)
  adapterType    String   @default("PROMPT") // PROMPT | RAG | FINE_TUNE | LORA | ROUTER | ENSEMBLE
  baseModel      String   @default("")
  datasetVersion String   @default("")
  trainingNotes  String   @default("")
  artifactRef    String   @default("") // storage reference; never a public URL
  status         String   @default("DRAFT") // DRAFT | EVALUATED | PRODUCTION | RETIRED
  createdById    String   @default("")
  createdAt      DateTime @default(now())

  model       AiModel             @relation(fields: [modelId], references: [id], onDelete: Cascade)
  evaluations AiModelEvaluation[]
  deployments AiModelDeployment[]

  @@unique([modelId, version])
  @@index([status])
}

model AiModelEvaluation {
  id             String   @id @default(cuid())
  versionId      String
  benchmark      String // e.g. admissions-qa-v3
  score          Float // 0..100
  datasetVersion String   @default("")
  passed         Boolean  @default(false)
  details        String   @default("{}") // JSON metrics snapshot
  evaluatedAt    DateTime @default(now())

  version AiModelVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@index([benchmark])
}

model AiModelDeployment {
  id             String    @id @default(cuid())
  versionId      String
  modelId        String
  environment    String    @default("STAGING") // STAGING | PRODUCTION
  status         String    @default("ACTIVE") // ACTIVE | ROLLED_BACK
  activatedAt    DateTime  @default(now())
  activatedById  String
  rolledBackAt   DateTime?
  rollbackReason String    @default("")
  notes          String    @default("")

  version AiModelVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  model   AiModel        @relation("AiModelDeployments", fields: [modelId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@index([environment, status])
}

model AiModelDepartmentAssignment {
  id           String   @id @default(cuid())
  modelId      String
  departmentId String
  assignedAt   DateTime @default(now())

  model AiModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, departmentId])
  @@index([departmentId])
}

// ═══════════════════════════════════════════════════════════════════════════
// ALO AI WORKFORCE (AWF) — 2026-10-02
//
// ALO-owned agent orchestration layer. Every row here is business logic ALO
// controls: agent registry, immutable versions, skills, tool registry and
// grants, workflows, runs/telemetry, approvals, scoped memory, knowledge,
// audit and automation measurement.
//
// Open-source / self-hosted models are inference engines only; they are
// reached through AwfModelRuntime via the ALO AI Gateway and never own
// orchestration, permissions, memory policy or business rules.
//
// Naming is prefixed `Awf` so it never collides with the pre-existing
// AgentDefinition / AiEmployee / AgentOS* tables, which stay untouched.
// ═══════════════════════════════════════════════════════════════════════════

model AwfDepartment {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default(dbgenerated("(_utf8mb4'')")) @db.Text
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agents    AwfAgent[]
  workflows AwfWorkflow[]

  @@index([isActive])
}

model AwfAgent {
  id               String    @id @default(cuid())
  slug             String    @unique
  name             String
  description      String    @default(dbgenerated("(_utf8mb4'')")) @db.Text
  departmentId     String
  role             String    @default("SPECIALIST")
  purpose          String    @default(dbgenerated("(_utf8mb4'')")) @db.Text
  // Lifecycle: DRAFT VALIDATED TESTED APPROVED DEPLOYING ACTIVE PAUSED DISABLED ARCHIVED
  status           String    @default("DRAFT")
  currentVersionId String?
  activeVersionId  String?
  latestVersionNo  Int       @default(0)
  ownerUserId      String    @default("")
  // Roles permitted to invoke this agent (JSON array of role strings)
  allowedRoles     String    @default(dbgenerated("(_utf8mb4'[\"SUPER_ADMIN\",\"ADMIN\"]')")) @db.Text
  isProtected      Boolean   @default(false)
  lastRunAt        DateTime?
  createdById      String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  department  AwfDepartment            @relation(fields: [departmentId], references: [id])
  versions    AwfAgentVersion[]
  toolGrants  AwfToolGrant[]
  skillGrants AwfSkillGrant[]
  runs        AwfRun[]
  testCases   AwfTestCase[]
  proposals   AwfImprovementProposal[]

  @@index([status])
  @@index([departmentId])
}

model AwfAgentVersion {
  id                 String    @id @default(cuid())
  agentId            String
  versionNo          Int
  // Full immutable configuration snapshot (JSON)
  config             String    @default(dbgenerated("(_utf8mb4'{}')")) @db.LongText
  systemInstructions String    @default(dbgenerated("(_utf8mb4'')")) @db.LongText
  capabilities       String    @default(dbgenerated("(_utf8mb4'[]')")) @db.Text
  tools              String    @default(dbgenerated("(_utf8mb4'[]')")) @db.Text
  skills             String    @default(dbgenerated("(_utf8mb4'[]')")) @db.Text
  modelPolicy        String    @default(dbgenerated("(_utf8mb4'{}')")) @db.Text
  memoryPolicy       String    @default(dbgenerated("(_utf8mb4'{}')")) @db.Text
  fallbackPolicy     String    @default(dbgenerated("(_utf8mb4'{}')")) @db.Text
  approvalPolicy     String    @default(dbgenerated("(_utf8mb4'{}')")) @db.Text
  securityPolicy     String    @default(dbgenerated("(_utf8mb4'{}')")) @db.Text
  permissions        String    @default(dbgenerated("(_utf8mb4'{}')")) @db.Text
  outputSchema       String    @default(dbgenerated("(_utf8mb4'{}')")) @db.Text
  changeReason       String    @default(dbgenerated("(_utf8mb4'')")) @db.Text
  configHash         String    @default("")
  // DRAFT | VALIDATED | VALIDATION_FAILED | TESTED | TEST_FAILED | APPROVED | DEPLOYED | ROLLED_BACK | ARCHIVED
  state              String    @default("DRAFT")
  validationReport   String    @default(dbgenerated("(_utf8mb4'{}')")) @db.LongText
  testReport         String    @default(dbgenerated("(_utf8mb4'{}')")) @db.LongText
  approvedById       String    @default("")
  approvedAt         DateTime?
  deployedById       String    @default("")
  deployedAt         DateTime?
  createdById        String    @default("")
  createdAt          DateTime  @default(now())

  agent   AwfAgent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  runs    AwfRun[]
  prompts AwfPromptVersion[]

  @@unique([agentId, versionNo])
  @@index([state])
}

model AwfPromptVersion {
  id           String    @id @default(cuid())
  versionId    String
  agentSlug    String
  previousText String    @default(dbgenerated("(_utf8mb4'')")) @db.LongText
  newText      String    @default(dbgenerated("(_utf8mb4'')")) @db.LongText
  reason       String    @default(dbgenerated("(_utf8mb4'')")) @db.Text
  authorId     String    @default("")
  approvedById String    @default("")
  approvedAt   DateTime?
  testPassed   Boolean   @default(false)
  createdAt    DateTime  @default(now())

  version AwfAgentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([agentSlug])
}

model AwfSkill {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  description  String    @default(dbgenerated("(_utf8mb4'')")) @db.Text
  handlerKey   String    @default("")
  inputSchema  String    @default(dbgenerated("(_utf8mb4'{}')")) @db.Text
  outputSchema String    @default(dbgenerated("(_utf8mb4'{}')")) @db.Text
  permission   String    @default("SKILL_READ")
  version      Int       @default(1)
  status       String    @default("ACTIVE")
  testsPassed  Int       @default(0)
  testsTotal   Int       @default(0)
  lastTestedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  grants AwfSkillGrant[]

  @@index([status])
}

model AwfSkillGrant {
  id          String   @id @default(cuid())
  agentId     String
  skillId     String
  status      String   @default("ACTIVE")
  grantedById String   @default("")
  createdAt   DateTime @default(now())

  agent AwfAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill AwfSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([agentId, skillId])
}

model AwfTool {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String   @default(dbgenerated("(_utf8mb4'')")) @db.Text
  handlerKey       String   @default("")
  category         String   @default("GENERAL")
  inputSchema      String   @default(dbgenerated("(_utf8mb4'{}')")) @db.Text
  outputSchema     String   @default(dbgenerated("(_utf8mb4'{}')")) @db.Text
  // TOOL_READ | TOOL_WRITE | TOOL_EXTERNAL_SEND | TOOL_FINANCE | TOOL_ADMIN
  permission       String   @default("TOOL_READ")
  riskLevel        String   @default("LOW")
  requiresApproval Boolean  @default(false)
  timeoutMs        Int      @default(15000)
  rateLimitPerMin  Int      @default(60)
  auditPolicy      String   @default("ALWAYS")
  securityClass    String   @default("INTERNAL")
  mutates          Boolean  @default(false)
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  grants AwfToolGrant[]
  calls  AwfToolCall[]

  @@index([status])
  @@index([riskLevel])
}

model AwfToolGrant {
  id               String   @id @default(cuid())
  agentId          String
  toolId           String
  permission       String   @default("TOOL_READ")
  approvalRequired Boolean  @default(false)
  maxCallsPerRun   Int      @default(10)
  status           String   @default("ACTIVE")
  grantedById      String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  agent AwfAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool  AwfTool  @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([agentId, toolId])
  @@index([status])
}

model AwfWorkflow {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String   @default(dbgenerated("(_utf8mb4'')")) @db.Text
  departmentId String?
  triggerType  String   @default("MANUAL")
  triggerEvent String   @default("")
  // Full definition: steps, conditions, agent/tool assignments, approvals,
  // retries, fallback, timeout, success/failure conditions (JSON)
  definition   String   @default(dbgenerated("(_utf8mb4'{}')")) @db.LongText
  version      Int      @default(1)
  status       String   @default("DRAFT")
  eligible     Boolean  @default(true)
  timeoutMs    Int      @default(120000)
  maxRetries   Int      @default(2)
  createdById  String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department AwfDepartment? @relation(fields: [departmentId], references: [id])
  runs       AwfRun[]

  @@index([status])
  @@index([triggerEvent])
}

model AwfRun {
  id                 String    @id @default(cuid())
  runCode            String    @unique
  agentId            String?
  versionId          String?
  workflowId         String?
  workflowSlug       String    @default("")
  parentRunId        String?
  trigger            String    @default("MANUAL")
  triggerEventId     String?
  // PRODUCTION | SIMULATION | TEST
  mode               String    @default("PRODUCTION")
  actorUserId        String    @default("")
  actorRole          String    @default("")
  runtimeKey         String    @default("")
  provider           String    @default("")
  model              String    @default("")
  startedAt          DateTime  @default(now())
  endedAt            DateTime?
  durationMs         Int       @default(0)
  // QUEUED RUNNING COMPLETED FAILED AWAITING_APPROVAL ESCALATED CANCELLED TIMED_OUT
  status             String    @default("QUEUED")
  toolCallCount      Int       @default(0)
  fallbackUsed       Boolean   @default(false)
  fallbackChain      String    @default(dbgenerated("(_utf8mb4'[]')")) @db.Text
  retryCount         Int       @default(0)
  approvalRequired   Boolean   @default(false)
  errorCategory      String    @default("")
  errorMessage       String    @default(dbgenerated("(_utf8mb4'')")) @db.Text
  entityType         String    @default("")
  entityId           String    @default("")
  // AUTOMATED | AI_ASSISTED | PENDING_APPROVAL | HUMAN | ESCALATED | NOT_ELIGIBLE
  automationMode     String    @default("AUTOMATED")
  // ELIGIBLE_ROUTINE | HUMAN_REQUIRED | SAFETY_APPROVAL
  automationCategory String    @default("ELIGIBLE_ROUTINE")
  humanIntervened    Boolean   @default(false)
  input              String    @default(dbgenerated("(_utf8mb4'{}')")) @db.LongText
  output             String    @default(dbgenerated("(_utf8mb4'{}')")) @db.LongText
  correlationId      String    @default("")
  idempotencyKey     String?   @unique
  createdAt          DateTime  @default(now())

  agent     AwfAgent?        @relation(fields: [agentId], references: [id])
  version   AwfAgentVersion? @relation(fields: [versionId], references: [id])
  workflow  AwfWorkflow?     @relation(fields: [workflowId], references: [id])
  steps     AwfRunStep[]
  toolCalls AwfToolCall[]
  approvals AwfApproval[]

  @@index([status])
  @@index([agentId])
  @@index([workflowSlug])
  @@index([mode])
  @@index([createdAt])
  @@index([automationMode])
}

model AwfRunStep {
  id           String    @id @default(cuid())
  runId        String
  stepIndex    Int       @default(0)
  stepKey      String    @default("")
  stepType     String    @default("SKILL")
  refSlug      String    @default("")
  status       String    @default("PENDING")
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  durationMs   Int       @default(0)
  input        String    @default(dbgenerated("(_utf8mb4'{}')")) @db.LongText
  output       String    @default(dbgenerated("(_utf8mb4'{}')")) @db.LongText
  note         String    @default(dbgenerated("(_utf8mb4'')")) @db.Text
  errorMessage String    @default(dbgenerated("(_utf8mb4'')")) @db.Text

  run AwfRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([status])
}

model AwfToolCall {
  id            String   @id @default(cuid())
  runId         String
  toolId        String?
  toolSlug      String
  stepId        String?
  mode          String   @default("PRODUCTION")
  status        String   @default("REQUESTED")
  decision      String   @default("")
  args          String   @default(dbgenerated("(_utf8mb4'{}')")) @db.LongText
  result        String   @default(dbgenerated("(_utf8mb4'{}')")) @db.LongText
  errorMessage  String   @default(dbgenerated("(_utf8mb4'')")) @db.Text
  durationMs    Int      @default(0)
  approvalId    String?
  mutationCount Int      @default(0)
  createdAt     DateTime @default(now())

  run  AwfRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  tool AwfTool? @relation(fields: [toolId], references: [id])

  @@index([runId])
  @@index([toolSlug])
  @@index([status])
}

model AwfApproval {
  id               String    @id @default(cuid())
  runId            String?
  agentSlug        String    @default("")
  toolSlug         String    @default("")
  action           String
  riskLevel        String    @default("HIGH")
  reason           String    @default(dbgenerated("(_utf8mb4'')")) @db.Text
  payload          String    @default(dbgenerated("(_utf8mb4'{}')")) @db.LongText
  entityType       String    @default("")
  entityId         String    @default("")
  requestedById    String    @default("")
  requestedByAgent String    @default("")
  // PENDING | APPROVED | REJECTED | EXPIRED | CONSUMED
  status           String    @default("PENDING")
  decidedById      String    @default("")
  decidedAt        DateTime?
  decisionNote     String    @default(dbgenerated("(_utf8mb4'')")) @db.Text
  consumedAt       DateTime?
  consumedRunId    String    @default("")
  resultSummary    String    @default(dbgenerated("(_utf8mb4'')")) @db.Text
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())

  run AwfRun? @relation(fields: [runId], references: [id])

  @@index([status])
  @@index([agentSlug])
  @@index([createdAt])
}

model AwfMemory {
  id              String    @id @default(cuid())
  // SHORT_TERM | LONG_TERM | COMPANY | DEPARTMENT | USER
  scope           String
  // run id, agent slug, department slug, user id, or 'ALO' for company scope
  ownerKey        String
  agentSlug       String    @default("")
  key             String
  value           String    @default(dbgenerated("(_utf8mb4'')")) @db.LongText
  // PUBLIC | INTERNAL | CONFIDENTIAL | RESTRICTED
  confidentiality String    @default("INTERNAL")
  approved        Boolean   @default(false)
  approvedById    String    @default("")
  sourceRunId     String    @default("")
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([scope, ownerKey, key])
  @@index([scope])
  @@index([agentSlug])
  @@index([expiresAt])
}

model AwfKnowledgeSource {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  sourceType      String   @default("DOCUMENT")
  sourceUrl       String   @default("")
  department      String   @default("")
  confidentiality String   @default("INTERNAL")
  allowedRoles    String   @default(dbgenerated("(_utf8mb4'[\"SUPER_ADMIN\",\"ADMIN\"]')")) @db.Text
  version         Int      @default(1)
  freshnessAt     DateTime @default(now())
  status          String   @default("ACTIVE")
  createdById     String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  chunks AwfKnowledgeChunk[]

  @@index([status])
}

model AwfKnowledgeChunk {
  id         String   @id @default(cuid())
  sourceId   String
  chunkIndex Int      @default(0)
  content    String   @default(dbgenerated("(_utf8mb4'')")) @db.LongText
  tokens     Int      @default(0)
  // Deterministic lexical index (JSON term -> frequency) used by ALO retrieval
  termIndex  String   @default(dbgenerated("(_utf8mb4'{}')")) @db.LongText
  citation   String   @default(dbgenerated("(_utf8mb4'')")) @db.Text
  createdAt  DateTime @default(now())

  source AwfKnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
}

model AwfAuditLog {
  id            String   @id @default(cuid())
  actorId       String   @default("")
  actorRole     String   @default("")
  action        String
  objectType    String   @default("")
  objectId      String   @default("")
  before        String   @default(dbgenerated("(_utf8mb4'{}')")) @db.LongText
  after         String   @default(dbgenerated("(_utf8mb4'{}')")) @db.LongText
  result        String   @default("SUCCESS")
  reason        String   @default(dbgenerated("(_utf8mb4'')")) @db.Text
  correlationId String   @default("")
  ipAddress     String   @default("")
  createdAt     DateTime @default(now())

  @@index([action])
  @@index([objectType, objectId])
  @@index([createdAt])
}

model AwfEvent {
  id          String    @id @default(cuid())
  eventKey    String    @unique
  eventType   String
  source      String    @default("")
  payload     String    @default(dbgenerated("(_utf8mb4'{}')")) @db.LongText
  entityType  String    @default("")
  entityId    String    @default("")
  // RECEIVED | PROCESSING | PROCESSED | DUPLICATE | FAILED | SKIPPED
  status      String    @default("RECEIVED")
  runId       String    @default("")
  attempts    Int       @default(0)
  lastError   String    @default(dbgenerated("(_utf8mb4'')")) @db.Text
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([eventType])
  @@index([status])
}

model AwfTestCase {
  id          String   @id @default(cuid())
  agentId     String
  name        String
  description String   @default(dbgenerated("(_utf8mb4'')")) @db.Text
  input       String   @default(dbgenerated("(_utf8mb4'{}')")) @db.LongText
  expectation String   @default(dbgenerated("(_utf8mb4'{}')")) @db.LongText
  critical    Boolean  @default(true)
  status      String   @default("ACTIVE")
  createdById String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agent   AwfAgent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  results AwfTestResult[]

  @@index([agentId])
}

model AwfTestResult {
  id         String   @id @default(cuid())
  testCaseId String
  versionId  String   @default("")
  runId      String   @default("")
  passed     Boolean  @default(false)
  details    String   @default(dbgenerated("(_utf8mb4'{}')")) @db.LongText
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  testCase AwfTestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@index([versionId])
}

model AwfModelRuntime {
  id                  String    @id @default(cuid())
  runtimeKey          String    @unique
  name                String
  provider            String    @default("deterministic")
  model               String    @default("")
  endpoint            String    @default("")
  tier                Int       @default(1)
  kind                String    @default("DETERMINISTIC")
  contextTokens       Int       @default(8192)
  maxConcurrency      Int       @default(2)
  requiresApiKey      Boolean   @default(false)
  isPaidService       Boolean   @default(false)
  enabled             Boolean   @default(true)
  // HEALTHY | DEGRADED | OFFLINE | BLOCKED | DISABLED | UNKNOWN
  status              String    @default("UNKNOWN")
  lastCheckedAt       DateTime?
  lastLatencyMs       Int       @default(0)
  avgLatencyMs        Int       @default(0)
  successCount        Int       @default(0)
  failureCount        Int       @default(0)
  consecutiveFailures Int       @default(0)
  queueDepth          Int       @default(0)
  lastError           String    @default(dbgenerated("(_utf8mb4'')")) @db.Text
  notes               String    @default(dbgenerated("(_utf8mb4'')")) @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([tier])
  @@index([status])
}

model AwfImprovementProposal {
  id           String    @id @default(cuid())
  agentId      String
  proposedBy   String    @default("")
  runId        String    @default("")
  title        String
  rationale    String    @default(dbgenerated("(_utf8mb4'')")) @db.Text
  diff         String    @default(dbgenerated("(_utf8mb4'{}')")) @db.LongText
  status       String    @default("PENDING")
  reviewedById String    @default("")
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  agent AwfAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([status])
}

model AwfTaskLedger {
  id           String   @id @default(cuid())
  ledgerKey    String   @unique
  workflowSlug String
  department   String   @default("")
  entityType   String   @default("")
  entityId     String   @default("")
  eligible     Boolean  @default(true)
  // AGENT_COMPLETED | AGENT_ASSISTED | HUMAN_APPROVED | HUMAN_ONLY | FAILED | ESCALATED | PENDING
  outcome      String   @default("PENDING")
  runId        String   @default("")
  humanTouches Int      @default(0)
  durationMs   Int      @default(0)
  substantive  Boolean  @default(true)
  evidenceId   String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workflowSlug])
  @@index([outcome])
  @@index([eligible])
}
