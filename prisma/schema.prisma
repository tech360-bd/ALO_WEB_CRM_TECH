model ContentRelationship {
  id                   String   @id @default(cuid())
  // NOTE: sourceType/targetType/relationshipType are short discriminator
  // strings (SERVICE, SCHOLARSHIP, UNIVERSITY, "related", ...). They are
  // VarChar(64) — NOT the default VARCHAR(191) — because they participate in
  // the 5-column @@unique below: 5 × VARCHAR(191) utf8mb4 = 3820 bytes which
  // exceeds MySQL's 3072-byte InnoDB key limit and made `migrate deploy`
  // fail on a fresh MySQL 8 (ERROR 1071). (64+191+64+191+64)×4 = 2292 bytes.
  sourceType           String   @db.VarChar(64) // SERVICE, SCHOLARSHIP, RESOURCE, UNIVERSITY, COURSE, COUNTRY, LANGUAGE_TEST
  sourceId             String
  serviceId            String?
  serviceReverseId     String?
  scholarshipId        String?
  scholarshipReverseId String?
  resourceId           String?
  resourceReverseId    String?
  targetType           String   @db.VarChar(64)
  targetId             String
  relationshipType     String   @default("related") @db.VarChar(64)
  status               String   @default("ACTIVE")
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  service            Service?     @relation("ServiceRelationships", fields: [serviceId], references: [id])
  serviceReverse     Service?     @relation("ServiceReverseRelationships", fields: [serviceReverseId], references: [id])
  scholarship        Scholarship? @relation("ScholarshipRelationships", fields: [scholarshipId], references: [id])
  scholarshipReverse Scholarship? @relation("ScholarshipReverseRelationships", fields: [scholarshipReverseId], references: [id])
  resource           Resource?    @relation("ResourceRelationships", fields: [resourceId], references: [id])
  resourceReverse    Resource?    @relation("ResourceReverseRelationships", fields: [resourceReverseId], references: [id])

  @@unique([sourceType, sourceId, targetType, targetId, relationshipType])
  @@index([sourceType, sourceId])
  @@index([serviceId])
  @@index([serviceReverseId])
  @@index([scholarshipId])
  @@index([scholarshipReverseId])
  @@index([resourceId])
  @@index([resourceReverseId])
  @@index([targetType, targetId])
  @@index([relationshipType])
  @@index([status])
  @@map("content_relationships")
}

