  email           String    @default("")
  phone           String    @default("")
  password        String    @default("")
  userType        String    @default("ALO_FULL_STUDENT")
  status          String    @default("active")
  profileComplete Int       @default(0)
  journeyStage    String    @default("lead_created")
  currentCountry  String    @default("")
  currentCity     String    @default("")
  counselorId     String?
  counselorName   String    @default("")
  otpCode         String    @default("")
  otpExpiresAt    DateTime?
  lastLoginAt     DateTime?
  suspended       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model StudentProfileSection {
  id          String    @id @default(cuid())
  studentId   String
  section     String
  status      String    @default("incomplete")
  data        String    @default("{}")
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

model StudentEducation {
  id             String   @id @default(cuid())
  studentId      String
