  primaryColor    String   @default("#F37021") // ALO Orange
  secondaryColor  String   @default("#0066CC") // Education Blue
  accentColor     String   @default("#FFB347") // Sunshine Accent
  // Identity
  logoFileId      String? // link to FileMetadata
  logoUrl         String?
  tagline         String?
  // Contact information (auto-applied to every creative)
  website         String   @default("https://aloeducation.com")
  phone           String   @default("01805020101")
  email           String   @default("info@aloeducation.com")
  address         String?
  // Social handles
  facebookHandle  String?
  instagramHandle String?
  linkedinHandle  String?
  youtubeHandle   String?
  tiktokHandle    String?
  // Legal
