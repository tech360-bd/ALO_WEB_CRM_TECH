  courseSlug          String?
  studyLevel          String?
  subject             String?
  fundingType         String   // FULLY_FUNDED, PARTIAL, TUITION_REDUCTION, MERIT_BASED, NEED_BASED
  amount              String?
  currency            String?
  coverage            String?  // JSON: { tuition, living, accommodation, travel, insurance, other }
  eligibility         String?
  minimumRequirements String?  // JSON
  documentsRequired   String?  // JSON array
  applicationMethod   String?  // SEPARATE_APPLICATION, AUTOMATIC_WITH_ADMISSION
