model VerificationRun {
  id                  String        @id @default(cuid())
  jobId               String // MonitoringJob id
  job                 MonitoringJob @relation(fields: [jobId], references: [id])
  runId               String        @unique // human-readable run identifier e.g. "VR-2026-08-08-001"
  status              String        @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED | PARTIAL
  startedAt           DateTime      @default(now())
  completedAt         DateTime?
  // Scope
  universitiesChecked Int           @default(0)
  coursesChecked      Int           @default(0)
  sourcesChecked      Int           @default(0)
  // Results
  changesDetected     Int           @default(0)
  newUniversities     Int           @default(0)
  newCourses          Int           @default(0)
  updatedCourses      Int           @default(0)
  closedCourses       Int           @default(0)
  feeChanges          Int           @default(0)
  intakeChanges       Int           @default(0)
  deadlineChanges     Int           @default(0)
  requirementChanges  Int           @default(0)
  scholarshipChanges  Int           @default(0)
  governmentChanges   Int           @default(0)
  criticalChanges     Int           @default(0)
  failedSources       Int           @default(0)
  conflicts           Int           @default(0)
  manualReviewItems   Int           @default(0)
  // Error tracking
  errorMessage        String?
  retryCount          Int           @default(0)
  // AI-generated 7-day report summary
  aiReportSummary     String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([jobId])
  @@index([status])
  @@index([startedAt])
}

