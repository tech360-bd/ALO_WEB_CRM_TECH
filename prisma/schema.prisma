  updatedAt        DateTime @updatedAt
}

model StudentAdmissionPreference {
  id               String   @id @default(cuid())
  studentId        String
  preferredCountry String   @default("")
  preferredCourse  String   @default("")
  preferredLevel   String   @default("")
  preferredIntake  String   @default("")
  budgetRange      String   @default("")
  scholarshipNeed  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Application {
  id                  String   @id @default(cuid())
  applicationCode     String   @default("")
  studentId           String
  universityName      String   @default("")
  courseName          String   @default("")
  country             String   @default("")
  campus              String   @default("")
  intake              String   @default("")
  level               String   @default("")
  applicationId       String   @default("")
  applicationSource   String   @default("DIRECT_ALO_APPLICATION")
  sourceVisibility    String   @default("internal")
  isB2b               Boolean  @default(false)
  b2bType             String   @default("")
  b2bProviderId       String   @default("")
  partnerId           String   @default("")
  stage               String   @default("counseling")
  status              String   @default("active")
  safeStatus          String   @default("under_review")
  reviewStatus        String   @default("pending")
  documentStatus      String   @default("pending")
  paymentStatus       String   @default("pending")
  offerStatus         String   @default("none")
  casI20CoeStatus     String   @default("none")
  visaHandoverStatus  String   @default("not_started")
  counselorId         String   @default("")
  counselorName       String   @default("")
  applicationOfficer  String   @default("")
  applicationOfficerId String  @default("")
  visaOfficerId       String   @default("")
  deadline            String   @default("")
  notes               String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([studentId])
  @@index([counselorId])
  @@index([applicationOfficerId])
  @@index([b2bProviderId])
  @@index([stage])
  @@index([status])
}

model ApplicationStageHistory {
  id            String   @id @default(cuid())
  applicationId String
  stage         String
  status        String   @default("completed")
  note          String   @default("")
  actor         String   @default("")
  createdAt     DateTime @default(now())
}

model StudentDocument {
