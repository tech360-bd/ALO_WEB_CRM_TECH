+async function findLimitedPublicationCourse(slug: string) {
+  const record = await db.crmCourse.findFirst({
+    where: {
+      OR: [{ slug }, { courseId: slug }],
+      verificationStatus: 'PARTIALLY_VERIFIED',
+      publicationStatus: { notIn: ['published', 'PUBLISHED'] },
+      limitedPublication: { state: LIMITED_PUBLICATION_STATE.APPROVED, revokedAt: null },
+    },
+    select: {
+      id: true,
+      courseId: true,
+      slug: true,
+      courseTitle: true,
+      studyLevel: true,
+      studyMode: true,
+      campus: true,
+      academicYear: true,
+      country: true,
+      durationMonths: true,
+      tuitionFee: true,
+      deadline: true,
+      verificationStatus: true,
+      publicationStatus: true,
+      universityId: true,
+      university: { select: { name: true, slug: true, universityId: true } },
+      limitedPublication: true,
+    },
+  });
+  if (!record) return null;
+
+  const evidence = await db.crmOfficialEvidence.findMany({
+    where: {
+      entityType: 'COURSE',
+      courseSlug: record.slug,
+      universitySlug: record.university?.slug || record.university?.universityId || '',
+      verificationStatus: 'VERIFIED',
+    },
+    select: {
+      evidenceKey: true,
+      sourceUrl: true,
+      entityType: true,
+      courseSlug: true,
+      universitySlug: true,
+      verificationStatus: true,
+      contentHash: true,
+      fieldScope: true,
+    },
+  });
+
+  const decision = evaluateLimitedPublication({
+    course: {
+      id: record.id,
+      courseId: record.courseId,
+      slug: record.slug,
+      universityId: record.universityId,
+      universitySlug: record.university?.slug || record.university?.universityId || '',
+      universityName: record.university?.name || '',
+      courseTitle: record.courseTitle,
+      studyLevel: record.studyLevel,
+      studyMode: record.studyMode,
+      campus: record.campus,
+      academicYear: record.academicYear,
+      country: record.country,
+      verificationStatus: record.verificationStatus,
+      publicationStatus: record.publicationStatus,
+      durationMonths: record.durationMonths,
+      tuitionFee: record.tuitionFee,
+      deadline: record.deadline,
+    },
+    evidence: evidence as LimitedPublicationEvidence[],
+    approval: record.limitedPublication
+      ? {
+          id: record.limitedPublication.id,
+          courseId: record.limitedPublication.courseId,
+          state: record.limitedPublication.state,
+          approvedByUserId: record.limitedPublication.approvedByUserId,
+          approvedByRoles: JSON.parse(record.limitedPublication.approvedByRoles || '[]'),
+          approvedAt: record.limitedPublication.approvedAt?.toISOString?.() || '',
+          revokedAt: record.limitedPublication.revokedAt?.toISOString?.() || null,
+          evidenceSnapshotKeys: JSON.parse(record.limitedPublication.evidenceSnapshotKeys || '[]'),
+        }
+      : null,
+  });
+
+  if (!decision.publishable) return null;
+  return { record, decision };
