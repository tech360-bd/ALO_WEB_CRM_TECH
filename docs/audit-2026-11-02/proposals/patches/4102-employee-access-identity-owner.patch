+  it("inbound webhook upserts identity on every message and never auto-creates duplicates", () => {
+    const w = src(INBOUND_WEBHOOK);
+    // Upsert keyed on the normalised phone is what prevents duplicate contacts.
+    expect(w).toMatch(/db\.whatsAppContact\.upsert\(\{\s*where:\s*\{\s*normalizedPhone/);
+    expect(w).toContain("externalContactId");
+    // The duplicate-decision surface lives in the identity matcher, not the webhook.
+    const matcher = src(IDENTITY_MATCHER);
+    for (const decision of ["OPEN_EXISTING", "MERGE_REQUEST", "CREATE_NEW"]) {
+      expect(matcher, `matcher.${decision}`).toContain(decision);
+    }
