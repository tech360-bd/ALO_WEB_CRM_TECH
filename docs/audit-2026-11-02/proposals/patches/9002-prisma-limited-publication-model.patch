+/// Limited-information publication approval.
+///
+/// A separate row, not a status on CrmCourse, so that:
+///  - `verificationStatus` keeps exactly one meaning (VERIFIED = fully evidenced);
+///  - an approval is attributable to one Super Admin at one time;
+///  - revoking publication never touches the verification record;
+///  - rollback is a single DROP TABLE with no change to CrmCourse data.
+/// `state` is APPROVED only when approvedByUserId is a real, non-acting Super Admin.
+model CrmCourseLimitedPublication {
+  id                    String    @id @default(cuid())
+  courseId              String    @unique
+  /// NOT_REQUESTED | PENDING_APPROVAL | APPROVED | REJECTED | REVOKED
+  state                 String    @default("NOT_REQUESTED")
+  approvedByUserId      String    @default("")
+  /// JSON array of the approver's roles at approval time.
+  approvedByRoles       String    @default("[]")
+  approvedAt            DateTime?
+  revokedByUserId       String    @default("")
+  revokedAt             DateTime?
+  /// Operator's stated reason; shown in the audit trail, never public.
+  reason                String    @db.Text
+  /// JSON array of CrmOfficialEvidence.evidenceKey values at approval time.
+  /// A later re-link invalidates the approval rather than silently widening it.
+  evidenceSnapshotKeys  String    @db.Text
+  createdAt             DateTime  @default(now())
+  updatedAt             DateTime  @updatedAt
+
+  course                CrmCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
+
+  @@index([state])
+  @@index([approvedByUserId])
+  @@index([approvedAt])
+}
