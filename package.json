{
  "name": "alo-education-erp",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/assert-node22.cjs && RAYON_NUM_THREADS=1 UV_THREADPOOL_SIZE=1 NEXT_PRIVATE_BUILD_WORKER=0 NODE_OPTIONS='--max-old-space-size=4096' prisma generate && npm run db:verify-client && SKIP_CMS_DB=1 RAYON_NUM_THREADS=1 UV_THREADPOOL_SIZE=1 NEXT_PRIVATE_BUILD_WORKER=0 NODE_OPTIONS='--max-old-space-size=4096' next build --webpack && node scripts/prepare-standalone.mjs",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint .",
    "awf:mirror": "node scripts/ai-workforce/mirror-schema.mjs",
    "awf:ddl": "node scripts/ai-workforce/emit-ddl.mjs --dialect sqlite --schema prisma/verification-mirror/schema.sqlite.prisma --client @prisma/client --out .awf-tmp/verify-schema.sql",
    "awf:verify": "ALO_DB_DRIVER=sqlite DATABASE_URL=\"file:$PWD/.awf-tmp/verify.db\" tsx scripts/ai-workforce/run-verification.ts",
    "awf:audit": "ALO_DB_DRIVER=sqlite DATABASE_URL=\"file:$PWD/.awf-tmp/verify.db\" tsx scripts/ai-workforce/audit-independent.ts",
    "typecheck": "npm run db:verify-client && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:e2e": "playwright test",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "video:clone": "bash external/video-repos/clone-all.sh",
    "video:health": "tsx scripts/video-health-check.ts",
    "video:templates": "tsx scripts/list-video-templates.ts",
    "remotion:studio": "npx remotion studio src/lib/video-engine/remotion/entry.tsx",
    "remotion:render": "npx remotion render src/lib/video-engine/remotion/entry.tsx",
    "db:verify-client": "node scripts/verify-prisma-client.mjs",
    "db:diagnose": "node scripts/db-diagnose.mjs",
    "audit:env": "node scripts/audit-env-vars.mjs",
    "typecheck:references": "npm run db:verify-client && tsc --project tsconfig.supplied-references.json --noEmit"
  },
